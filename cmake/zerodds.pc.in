# pkg-config descriptor for ZeroDDS, generated by CMake into the single SDK
# install staging tree (configure_file, @ONLY). Relocatable: the prefix is
# derived from the .pc file's own location (${pcfiledir} = <prefix>/<libdir>/
# pkgconfig), so `cmake --install --prefix <X>` and any later relocation of the
# package (DEB/RPM, SDK tarball) resolve correctly without a baked absolute path.
prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: zerodds
Description: ZeroDDS — pure-Rust DDS implementation
URL: https://zerodds.org
Version: @ZERODDS_VERSION_FULL@
Cflags: -I${includedir}
Libs: -L${libdir} -lzerodds
