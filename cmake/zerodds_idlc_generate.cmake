cmake_minimum_required(VERSION 3.21 FATAL_ERROR)

# cmake-format: off
#
# Function that returns all the extensions of the files that will be generated by the given backend
#
# cmake-format: on
function(zerodds_idlc_extensions_from_backend BACKEND)
    # List of available extensions used in following regex, final semicolon is added only to
    # allow correct resolution of `ts` case
    set(GENERABLE_EXTENSIONS "rust=.rs;cpp=.hpp;c=.h;csharp=.cs;java=.java;python=.py;ts=.ts;")

    # If is requested generation for all supported types
    # return directly all the extensions
    if(BACKEND STREQUAL "all")
        set(EXPECTED_GENERATED_EXTENSIONS ".rs;.hpp;.h;.cs;.java;.py;.ts" PARENT_SCOPE)
        return()
    endif()

    if(GENERABLE_EXTENSIONS MATCHES "${BACKEND}=(\.[a-z]*);")
        set(EXPECTED_GENERATED_EXTENSIONS ${CMAKE_MATCH_1} PARENT_SCOPE)
        return()
    endif()
endfunction()

# cmake-format: off
# Function wrapping the zerodds-idlc executable and allowing to generate source files from IDL
#
#   zerodds_idlc_generate( LIBRARY_NAME <generated_idl_library_name>
#                          IDL_FILES <list_of_idl_files>
#                          [LIBRARY_TYPE <STATIC|SHARED|MODULE|INTERFACE>]
#                          [LIBRARY_NAMESPACE <namespace added to LIBRARY_NAME>]
#                          [OUTPUT_DIR <destination_folder>]
#                          [INCLUDE_DIR <subfolder_of_OUTPUT_DIR>]
#                          [GENERATOR_BACKEND <cpp|c|rust|csharp|java|python|ts>]
#                          [GENERATOR_FLAGS <list_of_flags_for_generator>]
#   )
#
# cmake-format: on
function(zerodds_idlc_generate LIBRARY_NAME)
    include(CMakeParseArguments)

    set(_options "")
    set(_singleargs OUTPUT_DIR INCLUDE_DIR LIBRARY_NAMESPACE GENERATOR_BACKEND)
    set(_multiargs IDL_FILES GENERATOR_FLAGS IDL_INCLUDE_DIR)
    cmake_parse_arguments(PARSE_ARGV 1 "" "${_options}" "${_singleargs}" "${_multiargs}")

    # If no include dir is given, expose the output one
    if(NOT ${_INCLUDE_DIR})
        set(_INCLUDE_DIR ${_OUTPUT_DIR})
    endif()

    # If output dir is not given, use the project binary one followed by include/zerodds/idl
    # thus allowing #include<zerodds/idl/*.idl>
    if(NOT _OUTPUT_DIR)
        set(_OUTPUT_DIR "${CMAKE_CURRENT_BINARY_DIR}/include/zerodds/idl")
        set(_INCLUDE_DIR "${CMAKE_CURRENT_BINARY_DIR}/include/")
    endif()

    # Library type: due to generator only providing C and CPP headers, the library can be only
    # an INTERFACE one
    set(LIBRARY_TYPE INTERFACE)

    # Check GENERATOR_BACKEND validity: only `cpp` and `c` can be used for generating linkable
    # CMake libraries, in all other cases an OBJECT library should be created
    if(NOT _GENERATOR_BACKEND)
        message(FATAL_ERROR "GENERATOR_BACKEND is a compulsory flag")
    endif()
    if(_GENERATOR_BACKEND AND (NOT _GENERATOR_BACKEND STREQUAL "cpp" AND NOT _GENERATOR_BACKEND STREQUAL "c"))
        message(WARNING "Selected generator backend `${_GENERATOR_BACKEND}` will result in OBJECT library")
        set(LIBRARY_TYPE OBJECT)
    endif()

    # If zerodds-idlc target is not define, call cargo to build it
    if(NOT TARGET zerodds::zerodds-idlc)
        # CARGO_EXECUTABLE should have been defined in the root CMakeLists.txt
        # anyway search it again and write error if not found
        if(NOT CARGO_EXECUTABLE)
            find_program(CARGO_EXECUTABLE NAMES cargo)
            if("${CARGO_EXECUTABLE}" STREQUAL "CARGO_EXECUTABLE-NOTFOUND")
            message(FATAL_ERROR "Cargo not found. Look at: https://rust-lang.org/learn/get-started")
            endif()
        endif()

        # Set OS-Specific executable extension
        if(WIN32)
            set(ZERODDS_IDLC_EXE_EXTENSION ".exe")
        endif()

        # Run rustc for building zerodds-idlc in Release
        # The build executable will be put in the caller project binary directory
        add_custom_target(zerodds_idlc_build ALL
            ${CARGO_EXECUTABLE} "rustc" "--manifest-path" "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../Cargo.toml"
                                "--package" "zerodds-idlc" "--release"
                                "--target-dir" "${CMAKE_CURRENT_BINARY_DIR}"
        )

        # Define zerodds-idlc as imported executable generated by `zerodds_idlc_build`
        add_executable(zerodds::zerodds-idlc IMPORTED GLOBAL)
        add_dependencies(zerodds::zerodds-idlc zerodds_idlc_build)
        set_target_properties(zerodds::zerodds-idlc PROPERTIES
            IMPORTED_LOCATION "${CMAKE_CURRENT_BINARY_DIR}/release/zerodds-idlc${ZERODDS_IDLC_EXE_EXTENSION}"
        )
    endif()


    # Find out with which extension the IDL files will be compiled
    # Will provide `EXPECTED_GENERATED_EXTENSIONS`
    zerodds_idlc_extensions_from_backend(${_GENERATOR_BACKEND})

    if(_IDL_INCLUDE_DIR)
        set(IDLC_INCLUDE_DIRS_FLAG "-I ${_IDL_INCLUDE_DIR}")
    endif()

    # Define and populate expected output of generation
    set(EXPECTED_GENERATED_SOURCES)
    foreach(extension IN LISTS EXPECTED_GENERATED_EXTENSIONS)
        foreach(idl_source IN LISTS _IDL_FILES)
            get_filename_component(idl_file ${idl_source} NAME)
            get_filename_component(idl_file_path ${idl_source} DIRECTORY)
            string(REPLACE ".idl" ${extension} EXPECTED_SOURCE ${idl_file})
            list(APPEND EXPECTED_GENERATED_SOURCES ${_OUTPUT_DIR}/${EXPECTED_SOURCE})

            add_custom_command(
                OUTPUT ${_OUTPUT_DIR}/${EXPECTED_SOURCE}
                COMMAND zerodds::zerodds-idlc "generate" ${idl_source} "--${_GENERATOR_BACKEND}" "--output" "${_OUTPUT_DIR}" "${IDLC_INCLUDE_DIRS_FLAG}"
                DEPENDS ${idl_source}
            )

        endforeach()
    endforeach()

    # Generate the library and link it to the correct CMake target and directories
    add_library(${LIBRARY_NAME} ${LIBRARY_TYPE} ${EXPECTED_GENERATED_SOURCES})

    if(${_GENERATOR_BACKEND} STREQUAL "c" OR ${_GENERATOR_BACKEND} STREQUAL "cpp")
        set_target_properties(${LIBRARY_NAME} PROPERTIES
            LINKER_LANGUAGE $<IF:$<STREQUAL: "${_GENERATOR_BACKEND}" , "c" >, "C" , "CXX" >
        )
        target_link_libraries(${LIBRARY_NAME} INTERFACE
            $<$<STREQUAL:"${_GENERATOR_BACKEND}","c">: zerodds::zerodds-c>
            $<$<STREQUAL:"${_GENERATOR_BACKEND}","cpp">: zerodds::zerodds-cpp>
        )
        target_include_directories(${LIBRARY_NAME} INTERFACE ${_INCLUDE_DIR})
    endif()

    # Expose the libray with the given namespace if specified
    # otherwise use the default namespace zerodds-idlc
    if(LIBRARY_NAMESPACE)
        add_library(${LIBRARY_NAMESPACE}::${LIBRARY_NAME} ALIAS ${LIBRARY_NAME})
    else()
        add_library(zerodds-idlc::${LIBRARY_NAME} ALIAS ${LIBRARY_NAME})
    endif()

endfunction()
