<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <LangVersion>11</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>ZeroDDS.Cdr</RootNamespace>
    <AssemblyName>ZeroDDS.Cdr</AssemblyName>
    <PackageId>ZeroDDS.Cdr</PackageId>
    <!-- Single source of truth = Cargo workspace.package.version. NuGet accepts 1.0.0-rc.7. -->
    <Version>1.0.0-rc.7</Version>
    <Authors>ZeroDDS Contributors</Authors>
    <Description>XCDR2 TypeSupport helper library for ZeroDDS C# bindings (zerodds-xcdr2-csharp-1.0).</Description>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageProjectUrl>https://zerodds.org</PackageProjectUrl>
    <RepositoryUrl>https://github.com/zero-objects/zero-dds</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0 OR MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>dds;xcdr2;cdr;serialization;zerodds</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <!--
       Packaging fix: the IDL-CSharp runtime (namespace Omg.Types — sequence
       contracts ISequence/IBoundedSequence/BoundedList, the ITopicType marker
       and the [Key]/[Id]/[Optional]/[MustUnderstand]/[External]/[Nested]/
       [Extensibility] annotation bridge) lives in the sibling crate
       crates/idl-csharp/runtime, OUTSIDE this project directory. The SDK's
       default Compile glob only picks up .cs files under the project folder,
       so Omg.Types.cs is absent from the ZeroDDS.Cdr assembly and the NuGet
       package — generated code referencing Omg.Types.* then fails to compile
       against the published package. We reference the existing file in place
       (no duplication) with an explicit Compile Include so `dotnet build`
       compiles it into the assembly and `dotnet pack` ships it. LinkBase keeps
       it in a tidy virtual folder for IDE display only. -->
  <ItemGroup>
    <Compile Include="../../../idl-csharp/runtime/Omg.Types.cs" LinkBase="IdlRuntime" />
  </ItemGroup>
</Project>
