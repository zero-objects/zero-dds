<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>11</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>ZeroDDS.Cdr.SourceGenerators</RootNamespace>
    <AssemblyName>ZeroDDS.Cdr.SourceGenerators</AssemblyName>
    <PackageId>ZeroDDS.Cdr.SourceGenerators</PackageId>
    <Version>0.0.0</Version>
    <Description>Roslyn source generator for the #[DdsType] attribute. Implements zerodds-xcdr2-csharp-1.0 §11.4.</Description>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- Source generator packages have no lib/<tfm>/ directory (the
         generator DLL lives under analyzers/dotnet/cs/). NU5128 + NU5017
         fire during the NuGet analyzer pass even though the nupkg is built
         cleanly. SDK 9.0.106 local: warning. SDK 9.0.314 + 10.x CI: error.
         Deliberately suppressed — the nupkg is correct for Roslyn consumption. -->
    <NoWarn>$(NoWarn);NU5128;NU5017</NoWarn>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- Generator source files live under src/. tests/ and bin/ and obj/
         are excluded so the generator does not try to compile
         test dependencies (xunit, ZeroDDS.Cdr). -->
    <Compile Remove="tests/**" />
    <Compile Remove="bin/**" />
    <Compile Remove="obj/**" />
    <None Remove="tests/**" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>
</Project>
