<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>ZeroDDS</RootNamespace>
    <AssemblyName>ZeroDDS</AssemblyName>
    <PackageId>ZeroDDS</PackageId>
    <Version>0.0.0</Version>
    <Authors>ZeroDDS Contributors</Authors>
    <Description>C# binding for ZeroDDS via P/Invoke over zerodds.h C-API. Pure-Rust DDS 1.4 / RTPS 2.5 / XTypes 1.3 implementation.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageProjectUrl>https://zerodds.org</PackageProjectUrl>
    <RepositoryUrl>https://github.com/zero-objects/zero-dds</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0 OR MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>dds;rtps;middleware;pubsub;robotics;zerodds</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ZeroDDS.Cdr\ZeroDDS.Cdr.csproj" />
  </ItemGroup>
</Project>
