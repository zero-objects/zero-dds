// dds-rpc-1.0 — exception.hpp
// RemoteException hierarchy. Spec §10.6 (exception mapping).
//
// `RemoteException` is the base class for all server exceptions derived
// from an IDL `raises` clause. It extends the DDS core
// exception hierarchy from `dds::core` (see exceptions.hpp.tmpl).
namespace dds { namespace rpc {

/// Base class of all remote exceptions (Spec §10.6).
class RemoteException : public ::dds::core::Exception {
public:
    RemoteException() = default;
    explicit RemoteException(std::string msg)
        : ::dds::core::Exception(std::move(msg)) {}
};

/// Error when the service does not know a requested operation.
class UnknownOperationError : public RemoteException {
public:
    using RemoteException::RemoteException;
};

/// Error when the service reports an exception the client does not
/// know.
class UnknownExceptionError : public RemoteException {
public:
    using RemoteException::RemoteException;
};

/// Error when the arguments are not valid.
class InvalidArgumentRemoteError : public RemoteException {
public:
    using RemoteException::RemoteException;
};

/// Error when the service reports resource exhaustion.
class OutOfResourcesRemoteError : public RemoteException {
public:
    using RemoteException::RemoteException;
};

/// Error when the service does not support the operation.
class UnsupportedRemoteError : public RemoteException {
public:
    using RemoteException::RemoteException;
};

} } // namespace dds::rpc
