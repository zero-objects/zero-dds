// dds-rpc-1.0 — service_traits.hpp
// ServiceTraits-Spezialisierung (Spec §10.3).
//
// `ServiceTraits<T>` returns the topic name and the operative mapping
// variant (Basic vs Enhanced) for a service type. The generated
// headers specialize the template per service class.
namespace dds { namespace rpc {

/// Mapping variant (Spec §7.5.1.1 / §7.5.1.2).
enum class ServiceMapping : int32_t {
    Basic = 0,
    Enhanced = 1,
};

/// Primary template — specialized per service.
template <typename Service>
struct ServiceTraits {
    /// `false` for the primary template; `true` in specializations.
    static constexpr bool is_specialized = false;
};

} } // namespace dds::rpc
