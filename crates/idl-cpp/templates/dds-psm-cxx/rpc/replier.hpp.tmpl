// dds-rpc-1.0 — replier.hpp
// Generic Replier-Template (Spec §10.5).
//
// Replier side: takes requests, dispatches to a handler and
// sends the reply back. In the skeleton `dispatch_to_handler` is
// purely synchronous — the per-service replier class overrides it.
namespace dds { namespace rpc {

/// Generic Replier-Template (Spec §10.5).
///
/// Per-service wrappers inherit from this and implement
/// `dispatch_to_handler` so that a concrete handler is invoked.
template <typename TIn, typename TOut>
class Replier {
public:
    Replier() = default;
    virtual ~Replier() = default;

    /// Dispatch of an incoming request to the handler.
    /// The return value is the reply (typed); exceptions are
    /// Caller in `RemoteException`-Mappings ueberfuehrt (Spec §10.6).
    virtual TOut dispatch_to_handler(const TIn& request) = 0;
};

} } // namespace dds::rpc
