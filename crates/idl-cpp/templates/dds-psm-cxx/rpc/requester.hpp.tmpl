// dds-rpc-1.0 — requester.hpp
// Generic Requester-Template (Spec §10.7 — Async-API).
//
// Promise/future pattern: `send_request_async` returns a
// `dds::rpc::Future<TOut>`, which is awaited blockingly via `.get()`.
// The sync API `send_request` is syntactic sugar.
//
// NOTE: skeleton — no real transport. The bindings (crate `dds-cpp`)
// will delegate `send_request_async` to the Rust RPC runtime.
namespace dds { namespace rpc {

/// Future wrapper over `std::future<T>` (Spec §10.7).
template <typename T>
class Future {
public:
    Future() = default;
    explicit Future(std::future<T>&& f) : inner_(std::move(f)) {}
    /// Block waiting for the reply and extract the value.
    T get() { return inner_.get(); }
    bool valid() const noexcept { return inner_.valid(); }
private:
    std::future<T> inner_{};
};

/// Promise-Gegenstueck (Spec §10.7).
template <typename T>
class Promise {
public:
    Promise() = default;
    /// Returns the associated future. May be called only once.
    Future<T> get_future() { return Future<T>(inner_.get_future()); }
    /// Sets the reply value; wakes `Future<T>::get()`.
    void set_value(const T& v) { inner_.set_value(v); }
    void set_value(T&& v) { inner_.set_value(std::move(v)); }
    /// Sets an exception; `Future<T>::get()` rethrows.
    void set_exception(std::exception_ptr e) { inner_.set_exception(e); }
private:
    std::promise<T> inner_{};
};

/// Generic Requester-Template (Spec §10.4).
///
/// `TIn` and `TOut` are the XCDR2-serializable request resp. reply
/// payload types. The typed per-service wrappers (see
/// `<service>_Requester` in the generated header) inherit from this.
template <typename TIn, typename TOut>
class Requester {
public:
    Requester() = default;
    virtual ~Requester() = default;

    /// Async variant (Spec §10.7).
    virtual Future<TOut> send_request_async(const TIn& request) = 0;

    /// Sync variant — `send_request_async` + `.get()`.
    TOut send_request(const TIn& request) {
        return send_request_async(request).get();
    }
};

} } // namespace dds::rpc
