// dds-psm-cxx-1.0 — listener.hpp
// Listener with all 13 status callbacks. Spec §8.3.5.
namespace dds { namespace core {

template <typename T> class DataReader; // fwd
template <typename T> class DataWriter; // fwd
template <typename T> class Topic;      // fwd

/// AnyTopicListener (Spec §8.3.5.1).
class AnyTopicListener {
public:
    virtual ~AnyTopicListener() = default;
    virtual void on_inconsistent_topic(/*Topic*&*/ /*status*/) {}
};

/// AnyDataReaderListener (Spec §8.3.5.4) + DataReaderListener<T>.
class AnyDataReaderListener {
public:
    virtual ~AnyDataReaderListener() = default;
    virtual void on_sample_lost(/*reader*/ /*status*/) {}
    virtual void on_sample_rejected(/*reader*/ /*status*/) {}
    virtual void on_liveliness_changed(/*reader*/ /*status*/) {}
    virtual void on_requested_deadline_missed(/*reader*/ /*status*/) {}
    virtual void on_requested_incompatible_qos(/*reader*/ /*status*/) {}
    virtual void on_subscription_matched(/*reader*/ /*status*/) {}
    virtual void on_data_available(/*reader*/) {}
};

template <typename T>
class DataReaderListener : public AnyDataReaderListener {
public:
    ~DataReaderListener() override = default;
};

/// AnyDataWriterListener (Spec §8.3.5.5) + DataWriterListener<T>.
class AnyDataWriterListener {
public:
    virtual ~AnyDataWriterListener() = default;
    virtual void on_offered_deadline_missed(/*writer*/ /*status*/) {}
    virtual void on_offered_incompatible_qos(/*writer*/ /*status*/) {}
    virtual void on_liveliness_lost(/*writer*/ /*status*/) {}
    virtual void on_publication_matched(/*writer*/ /*status*/) {}
};

template <typename T>
class DataWriterListener : public AnyDataWriterListener {
public:
    ~DataWriterListener() override = default;
};

/// SubscriberListener (Spec §8.3.5.3) — all DataReader callbacks plus
/// on_data_on_readers.
class SubscriberListener : public AnyDataReaderListener {
public:
    ~SubscriberListener() override = default;
    virtual void on_data_on_readers(/*subscriber*/) {}
};

/// PublisherListener (Spec §8.3.5.2).
class PublisherListener : public AnyDataWriterListener {
public:
    ~PublisherListener() override = default;
};

/// DomainParticipantListener (Spec §8.3.5.7) — unifies all listeners.
class DomainParticipantListener
    : public AnyTopicListener,
      public PublisherListener,
      public SubscriberListener {
public:
    ~DomainParticipantListener() override = default;
};

} } // namespace dds::core
