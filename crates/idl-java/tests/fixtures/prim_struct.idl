// Fixture: all primitives in one struct (incl. unsigned workaround).
struct Primitives {
    boolean a_bool;
    octet a_octet;
    char a_char;
    wchar a_wchar;
    short a_short;
    unsigned short a_ushort;
    long a_long;
    unsigned long a_ulong;
    long long a_llong;
    unsigned long long a_ullong;
    float a_float;
    double a_double;
};
