// RTI Connext DDS vendor profile.
//
// RTI uses:
// - keylist top level (RTI delta, production rti_keylist)
// - @RTI_* annotations (passed through as custom annotations)
// - comment-style legacy: //@key, //@ID(n) — the suffix annotation form
//   of DDS-XTypes 1.3 §7.3.1.2.5, Table 24, read by the parser and
//   equivalent to the @ form. Exercised in
//   crates/idl-parse/tests/parse.rs and
//   crates/idl-lower/tests/annotations.rs, not here: this fixture is
//   RTI's own directives, and the suffix form is not one of them.
// - @allowed_data_representation, @verbatim heavy use

@verbatim(language="cpp", placement=BEFORE_DECLARATION,
          text="// Generated by ZeroDDS for RTI-Compat profile")
struct ShapeType {
    @key string color;
    long x;
    long y;
    long shapesize;
};

// RTI-specific vendor annotations (passed through).
@RTI_resource_limits(initial_count=10, max_count=100)
@RTI_data_representation(XCDR2)
struct LargeBag {
    @key long id;
    sequence<long, 1024> data;
};

@RTI_topic_kind(NO_KEY)
struct EphemeralEvent {
    long ts;
    string msg;
};
