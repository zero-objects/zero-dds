// FastDDS / eProsima vendor profile.
//
// FastDDS uses:
// - OMG standard annotations (@key, @optional, @hashid)
// - @RTPS_* annotations (vendor extensions; passed through as
//   custom annotations per Lowered::custom)
// - @allowed_data_representation, @data_representation

@topic
@appendable
struct Vehicle {
    @key string vin;
    @hashid("position") double location_x;
    @hashid("position") double location_y;
    @optional string driver;
};

// FastDDS-specific annotations (passed through as unknown annotations).
@RTPS_data_representation(XCDR2)
@allowed_data_representation(XCDR2)
struct Telemetry {
    @key long device_id;
    sequence<double> samples;
};

// Service definition with FastDDS-style annotation
@service
interface VehicleService {
    @oneway
    void notify(in long event);
    long current_speed();
};
