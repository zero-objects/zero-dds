// throughput.idl — Cyclone-DDS-style topic, hand-curated.
// Content-equivalent to typical Cyclone-DDS throughput examples.
// Cyclone DDS uses OMG standard annotations + standard IDL 4.2;
// no vendor extensions like RTI needed.

module ThroughputModule {

    @final
    struct ThroughputType {
        @key octet count;
        sequence<octet> payload;
    };

    @final
    struct ThroughputControl {
        long max_payload_size;
        long send_rate_hz;
        boolean enable;
    };
};
