// The type of ../generated_type_roundtrip.cpp: CMakeLists.txt beside this file
// generates typed_probe.hpp from it with `zerodds-idlc generate --lang c++
// --cpp-mapping native` on every build, so nothing generated is committed.
module probe {
  @appendable
  struct Reading {
    @key long id;
    double value;
    string<16> label;
  };
};
