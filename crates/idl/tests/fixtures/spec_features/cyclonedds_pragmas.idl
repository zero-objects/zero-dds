// Cyclone DDS vendor profile.
//
// Cyclone uses:
// - #pragma keylist <Type> <field>... (preprocessor level; see
//   preprocessor::tests for tests, the coverage report bypasses the
//   preprocessor and tests only the recognizer)
// - OMG standard annotations (@key, @optional, @id, @nested)
// - idlc-specific hints (e.g. the @nested variant)

@nested
struct Header {
    long ts;
    long seq;
};

@topic
struct Sensor {
    @key long sensor_id;
    Header hdr;
    @optional double calibration;
    sequence<double> samples;
};
