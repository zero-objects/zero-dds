// IDL 4.2 §7.4.5 Value Types Full + §7.4.6 Repository-IDs / Import.
//
// Synthetisch konstruierte Fixture fuer Grammar-Coverage:
// - value_def + value_header + value_inheritance_spec + value_element +
//   state_member + init_dcl + init_param_dcls/dcl + value_inheritance_name_list
// - type_id_dcl + type_prefix_dcl + import_dcl + imported_scope

typeprefix Bar "company.com";

typeid Bar "IDL:Bar:1.0";

import ::Foo::Bar;

import "IDL:Other:1.0";

interface IFace {
    void op();
};

valuetype Base {
    public long base_field;
};

custom valuetype V : truncatable Base supports IFace {
    public long counter;
    private string secret;
    exception Bad {};
    factory create(in long initial, in string name) raises (Bad);
    factory create_simple();
    long get_counter();
};
