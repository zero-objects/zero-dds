// IDL 4.2 §7.4.12 Template Modules.

module Pair<typename T> {
    struct P {
        T first;
        T second;
    };
};

module Buffer<typename T, const long Capacity> {
    typedef sequence<T> Items;
    struct Bag {
        Items items;
    };
};

module Holder<struct S> {
    typedef S Inner;
    typedef sequence<S> Coll;
};

module IfaceHolder<interface I> {
    typedef I HeldIface;
};
