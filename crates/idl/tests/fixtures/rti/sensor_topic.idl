// sensor_topic.idl — RTI Connext-style topic with a keylist directive.
// Hand-curated; see LICENSES.md.

module sensors {

    enum SensorKind {
        TEMPERATURE,
        PRESSURE,
        HUMIDITY
    };

    struct SensorReading {
        long sensor_id;
        SensorKind kind;
        double value;
        long long timestamp_ns;
    };

    // RTI-specific topic key directive (delta).
    keylist SensorReading (sensor_id);

    struct SensorEvent {
        string<128> source;
        long event_code;
        string<256> message;
    };

    keylist SensorEvent (source, event_code);
};
