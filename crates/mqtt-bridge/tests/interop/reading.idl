// The type of the cross-vendor tests (crates/mqtt-bridge/tests/cross_vendor.rs).
// @final: Cyclone DDS 0.10 writes it under XCDR1 (CDR_LE) and under XCDR2
// (CDR2_LE), as its endpoints' data representation names.
module Sensor {
  @final struct Reading {
    @key long id;
    double value;
    string unit;
  };
};
