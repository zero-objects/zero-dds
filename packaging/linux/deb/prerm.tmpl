#!/bin/sh
# prerm for any zerodds-*-bridge package.
# Spec: zerodds-deployment-1.0.md §2.3.
# Substituted: @DAEMON@, @SERVICE@.
set -e

DAEMON="@DAEMON@"
SERVICE="zerodds-${DAEMON}.service"

case "$1" in
    remove|upgrade|deconfigure)
        if [ -d /run/systemd/system ]; then
            deb-systemd-invoke stop "${SERVICE}" >/dev/null 2>&1 || true
            if [ "$1" = "remove" ]; then
                deb-systemd-helper disable "${SERVICE}" >/dev/null 2>&1 || true
            fi
        fi
        ;;

    failed-upgrade)
        ;;

    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#
exit 0
