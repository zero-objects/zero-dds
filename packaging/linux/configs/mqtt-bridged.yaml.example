# /etc/zerodds/mqtt-bridged.yaml.example
# Configuration of zerodds-mqtt-bridged.
# Spec: zerodds-mqtt-bridge-1.0 §3 (config schema), §11 (deployment).
#
# Read by crates/mqtt-bridge/src/daemon/config.rs (DaemonConfig::from_config)
# over the shared layers: this file, mqtt-bridged.d/, include:, the
# environment beneath, --set above. An unknown key in a known section or a
# value of the wrong type stops the start with file and line; an unknown
# top-level key is a WARN line on stderr, and an error under --check-config.
#
# The file holds only keys the daemon reads; crates/mqtt-bridge/tests/example_yaml_loadback.rs
# loads it back.

domain: 0
log_level: info

mqtt:
  broker_url: "mqtt://localhost:1883"   # mqtt://, mqtts://, ws://, wss:// (Spec §2)
  client_id:  "zerodds-mqtt-bridge"     # default: zerodds-bridge-<host>
  protocol_version: 5                   # 5 | 3.1.1 (Spec §1 L1)
  keep_alive_secs: 120                  # PINGREQ after this long without a packet
  drain_timeout_secs: 30                # shutdown waits this long for QoS 1/2 acks (Spec §9.2)
  clean_start: false                    # keep the session across reconnects ...
  session_expiry_interval_secs: 3600    # ... for this long (0: it ends with the connection)
  session_dir: "/var/lib/zerodds/mqtt-bridge"   # the client's session state, one file per client id (Spec §4.1)
  max_packet_size: 16777216             # the largest packet the broker may send (Spec §4.1)
  receive_maximum: 65535                # unreleased QoS 2 messages of the broker at once
  topic_alias_maximum: 100              # Topic Aliases the broker may set (0: none)
  connect_timeout_secs: 30              # the start gives up after this (exit 2); 0: never
  reconnect:                            # the waits between connect attempts (Spec §9.1, §9.3)
    initial_delay_ms: 500
    max_delay_ms: 30000
    factor: 2.0
  own_topic_prefix: "$zerodds"          # catalog, reports, will: <prefix>/<client_id>/... (Spec §5.2, §6);
                                        # HiveMQ refuses topics beginning with $: set e.g. "zerodds"
  # username: "${MQTT_USER}"            # ${VAR} is substituted before parsing
  # password: "${MQTT_PASSWORD}"
  tls:
    enabled: false
    ca_file:   "/etc/zerodds/certs/mqtt-ca.pem"
    cert_file: "/etc/zerodds/certs/mqtt-bridged.crt"
    key_file:  "/etc/zerodds/certs/mqtt-bridged.key"
    # server_name: "mosquitto.example.com"   # SNI and host name override
    verify_hostname: true               # false is refused: the name is always checked
    # alpn: ["mqtt"]                    # default: mqtt (mqtts://), http/1.1 (wss://)

# How the bridge authenticates towards the broker (Spec §7.2). Without
# `mode` it follows from what is set: enhanced with auth.enhanced.method,
# password with a user name, password or token, mtls with a client
# certificate, else none (anonymous, a broker on the loopback interface only).
auth:
  mode: "none"                        # none | password | mtls | enhanced
  # username: "${MQTT_USER}"          # password, SCRAM-SHA-256; win over
  # password: "${MQTT_PASSWORD}"      #   mqtt.username/mqtt.password
  # bearer_token: "${MQTT_TOKEN}"     # password: the CONNECT password; enhanced: the token
  # bearer_subject: "service-account" # the bridge's ACL subject instead of the one it has
  # enhanced:
  #   method: "SCRAM-SHA-256"         # SCRAM-SHA-256 | OAUTHBEARER | another method

# The daemon's ACL in front of MQTT (Spec §3/§7.3): MQTT topic filters per
# subject. The subject is the bridge's own identity: the TLS certificate DN,
# the user name it authenticates with or the JWT `sub`, in this order.
acl:
  default_deny: false
  rules:
    - subject: "service-account"
      allow_publish:   ["factory/+/telemetry"]
      allow_subscribe: ["factory/+/telemetry"]

metrics:
  enabled: false
  listen: "127.0.0.1:9092"   # the metrics + /catalog + /healthz
  path: "/metrics"           # the path of the Prometheus metrics

topics:
  # DDS topic <-> MQTT topic. zerodds-mqtt-bridge-1.0 §5.
  - dds_name:   "Telemetry"
    dds_type:   "demo::Sensor::Reading"
    mqtt_topic: "factory/press-1/telemetry"   # default: slug of dds_name; out and bidir
                                        # publish on it: a topic name, no wildcard
    direction:  "out"                   # in | out | bidir
    mqtt_qos:   1                       # 0 | 1 | 2; absent: derived from reliability
    retain:     false                   # absent: derived from durability
    # schema_url: "https://schema.example/sensor-reading.idl"   # in the catalog (Spec §5.2)
    qos:
      reliability: "reliable"
      durability: "volatile"
      history:
        kind: "keep_last"               # keep_last | keep_all
        depth: 10
      # lifespan_ms: 60000              # LIFESPAN, Message Expiry Interval (Spec §6)
      # deadline_ms: 5000               # a missed one: <own_topic_prefix>/<client_id>/deadline_missed/<slug>
      # liveliness:
      #   kind: "automatic"             # automatic | manual_by_participant | manual_by_topic
      #   lease_ms: 10000
      # partition: ["plant-a"]          # the DDS partitions of the topic
  - dds_name:   "Command"
    dds_type:   "demo::Press::Command"
    mqtt_topic: "factory/+/command"     # in subscribes: a topic filter may carry + and #
    direction:  "in"
    data_representation: "xcdr2"        # xcdr1 | xcdr2: the one representation of the DDS endpoints
                                        # (Spec §3). The writer offers it from its creation, so a DDS
                                        # reader of XCDR2 alone matches before the first PUBLISH; a
                                        # PUBLISH under XCDR1 is refused. On out and bidir the reader
                                        # accepts it alone, and a DDS writer of XCDR1 matches none.
                                        # Without the key the writer takes each PUBLISH's header and
                                        # the reader accepts both

# Participants and broker connections beside those of `domain`
# (Spec §1 L6); each binds to the broker under its own client_id.
# tenants:
#   - name: "plant-a"
#     domain: 7                         # default: the top-level domain
#     mqtt:
#       client_id: "zerodds-bridge-plant-a"
#       username: "${PLANT_A_USER}"     # default: the top level's credentials
#       password: "${PLANT_A_PASSWORD}"
#     topics:
#       - dds_name: "Plant::Status"
#         mqtt_topic: "plant-a/status"
#         direction: "out"
#     acl:
#       default_deny: false
