# /etc/zerodds/opcua-bridged.yaml.example
# Configuration of zerodds-opcua-bridged.
# Spec: zerodds-opcua-bridge-1.0 §3 (config schema), §11 (deployment).
#
# Read by crates/opcua-bridge/src/daemon/config.rs (DaemonConfig::from_config)
# over the shared layers: this file, opcua-bridged.d/, include:, the
# environment beneath, --set above. An unknown key inside a known section
# stops the start with file and line; an unknown top-level key is a WARN
# line on stderr.
#
# The file holds only keys the daemon reads.

domain: 0
log_level: info

opcua:
  # IDL files compiled at startup; every dds_type named below must be
  # declared in one of them.
  idl:
    - "/etc/zerodds/opcua/robotics.idl"

  # OMG DDS-OPCUA Gateway 1.0 §10 XML: which DDS topics appear in this
  # daemon's own opc.tcp AddressSpace, and in which direction.
  gateway_config: "/etc/zerodds/opcua/gateway.xml"

  server:
    enabled: true
    bind: "0.0.0.0:4840"
    security_policies: ["none"]   # add basic256sha256/aes128_sha256_rsaoaep/aes256_sha256_rsapss (feature `crypto`)
    # certificate_der:                    "/etc/zerodds/certs/opcua-bridged.der"
    # private_key_pem:                    "/etc/zerodds/certs/opcua-bridged.key.pem"
    # trusted_client_certificate_der:      "/etc/zerodds/certs/client.der"
    # trusted_client_public_key_pem:       "/etc/zerodds/certs/client.pub.pem"
    # Security Key Service (Part 14 §8; features crypto, pubsub-security).
    # security_groups:
    #   - security_group_id: "group-1"
    #     policy: "aes256-ctr"
    #     key_lifetime_ms: 3600000
    #     max_future_key_count: 3
    #     max_past_key_count: 1
    #     key_subjects: ["opc-client-1"]
    #     admin_subjects: ["sks-admin"]
    # The users of the SKS roles (Part 14 §8.8).
    # roles:
    #   security_key_server_admin: ["sks-admin"]
    #   security_key_server_access: ["opc-client-1"]
    #   security_key_server_push: []
    # Historical Access (§5.4) for the leaves of a dds_to_ua_connection topic.
    # historical:
    #   topics:
    #     - dds_topic: "Telemetry"
    #       depth: 100

  # Gateway 1.0 §8: this daemon as an OPC-UA client of other servers.
  client:
    enabled: false
    servers:
      - endpoint_url: "opc.tcp://plc.local:4840"
        nodes:
          - node_id:    "ns=2;s=Cmd"
            dds_topic:  "Commands"
            dds_type:   "robotics::Command"
            field_path: "value"
            keyed:      false

  # Part 14 (UADP) PubSub, both directions, over UDP multicast.
  pubsub:
    enabled: false
    connections:
      - name: "primary"
        local_addr:     "0.0.0.0:0"
        multicast_addr: "224.0.0.22:4840"
        publisher_id: 1
        publishers:
          - dds_topic:          "Telemetry"
            dds_type:           "robotics::Telemetry"
            writer_group_id:    1
            dataset_writer_id:  1
            dataset_name:       "TelemetryDataSet"
            publish_interval_ms: 1000
        subscribers:
          - dds_topic:    "Commands"
            dds_type:     "robotics::Command"
            dataset_name: "CommandDataSet"
            fields: ["value"]   # the remote Publisher's own field order
        # Part 14 §8 message security (feature `pubsub-security`).
        # key_source: static (the key below), local (this daemon's group),
        # sks (pulled with GetSecurityKeys), push (SetSecurityKeys).
        # security:
        #   policy: "aes256-ctr"
        #   security_group_id: "group-1"
        #   key_source: "static"
        #   push_subject: "sks-admin"
        #   sks:
        #     endpoint_url: "opc.tcp://sks.local:4840"
        #     channel_policy: "basic256sha256"
        #     certificate_der: "/etc/zerodds/certs/opcua-bridged.der"
        #     private_key_pem: "/etc/zerodds/certs/opcua-bridged.key.pem"
        #     server_certificate_der: "/etc/zerodds/certs/sks.der"
        #     server_public_key_pem: "/etc/zerodds/certs/sks.pub.pem"
        #     username: "opc-client-1"
        #     password: "${OPCUA_SKS_PASSWORD}"
        #     user_token_policy_id: "user"
        #     requested_key_count: 3
        #   token_id: 1
        #   signing_key:    "${OPCUA_PUBSUB_SIGNING_KEY}"
        #   encrypting_key: "${OPCUA_PUBSUB_ENCRYPTING_KEY}"
        #   key_nonce:      "${OPCUA_PUBSUB_KEY_NONCE}"

# Which DDS topics this daemon exposes/accepts at all (§7.2). A Write to
# this daemon's own server is checked against the subject of its session
# as well (§6.2); the subject of a session is the name of its user.
acl:
  default_deny: false
  allow_anonymous: true
  # users:
  #   - username: "opc-client-1"
  #     password: "${OPCUA_CLIENT_1_PASSWORD}"
  #     policy_id: "user"
  rules:
    - subject: "opc-client-1"
      allow_read:  ["Telemetry"]
      allow_write: ["Commands"]

metrics:
  enabled: false
  listen: "127.0.0.1:9095"   # GET /metrics
  # otlp_endpoint: "http://127.0.0.1:4318"
