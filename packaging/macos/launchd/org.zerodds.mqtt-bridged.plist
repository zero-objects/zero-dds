<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>org.zerodds.mqtt-bridged</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/zerodds-mqtt-bridged</string>
        <string>--config</string>
        <string>/usr/local/etc/zerodds/mqtt-bridged.yaml</string>
    </array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>StandardOutPath</key><string>/usr/local/var/log/zerodds/mqtt-bridged.log</string>
    <key>StandardErrorPath</key><string>/usr/local/var/log/zerodds/mqtt-bridged.err</string>
    <key>UserName</key><string>_zerodds</string>
    <key>WorkingDirectory</key><string>/usr/local/var/lib/zerodds</string>
    <key>SoftResourceLimits</key><dict><key>NumberOfFiles</key><integer>65536</integer></dict>
</dict>
</plist>
