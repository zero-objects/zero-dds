--
--  Unit tests for Xrce_Client:
--
--   1. State-machine tests mirroring crates/xrce-client/src/lib.rs's own
--      unit tests one for one (new_client_starts_disconnected,
--      connect_transitions_to_connecting, ..., disconnect_clears_state).
--   2. Byte-golden tests: each Frame_* output compared against
--      endpoints/testdata/xrce-client/ (*.bin), produced by
--      endpoints/golden-gen actually running
--      zerodds_xrce_client::XrceClient (crates/xrce-client) over
--      zerodds_xrce (crates/xrce) -- the same fixtures every other
--      language port of this client in this repository is checked
--      against. The bytes are embedded here rather than read from the
--      fixture files, so this test needs no golden-file path convention
--      of its own; they were verified byte-for-byte against a fresh
--      `cargo run -p zerodds-endpoint-golden` before being pasted in.

with Ada.Text_IO; use Ada.Text_IO;
with Interfaces;  use Interfaces;
with Deep_Reading; use Deep_Reading;
with Xrce_Client;  use Xrce_Client;
with Reliable;

procedure Test_Xrce_Client is

   Failures : Natural := 0;

   procedure Check (Cond : Boolean; Name : String) is
   begin
      if not Cond then
         Put_Line ("FAIL: " & Name);
         Failures := Failures + 1;
      end if;
   end Check;

   --  endpoints/testdata/xrce-client/ (*.bin) all use this ClientKey.
   Fixture_Key : constant Client_Key_Type := (16#01#, 16#02#, 16#03#, 16#04#);
   --  State-machine tests don't touch the wire, so any key will do.
   State_Key   : constant Client_Key_Type := (16#AA#, 16#BB#, 16#CC#, 16#DD#);
   Session_Id  : constant Byte := 16#01#;

   function Frame_Equals (F : Frame_Store; Golden : Bytes) return Boolean is
   begin
      if F.Len /= Golden'Length then
         return False;
      end if;
      for I in Golden'Range loop
         if F.Data (I - Golden'First) /= Golden (I) then
            return False;
         end if;
      end loop;
      return True;
   end Frame_Equals;

   --  Session_Id = 0x01 throughout (<=127, so every header carries the
   --  ClientKey). CREATE_CLIENT travels on STREAMID_NONE, seq 0, with header
   --  session id 0x00 (SESSION_ID_NONE_WITH_CLIENT_KEY, DDS-XRCE 1.0
   --  section 8.3.2.1; the payload carries session_id 0x01). The four
   --  post-handshake operations are all reliable, so they share
   --  STREAMID_BUILTIN_RELIABLE (0x80) and a real, strictly increasing
   --  sequence number (0..3) -- not the best-effort stream with
   --  hand-picked numbers a previous fixture set used.
   Golden_Create_Client : constant Bytes (0 .. 27) :=
     (16#00#, 16#00#, 16#00#, 16#00#, 16#01#, 16#02#, 16#03#, 16#04#,
      16#00#, 16#01#, 16#10#, 16#00#,
      16#58#, 16#52#, 16#43#, 16#45#, 16#01#, 16#00#, 16#00#, 16#00#,
      16#01#, 16#02#, 16#03#, 16#04#, 16#01#, 16#00#, 16#fc#, 16#01#);

   Golden_Create : constant Bytes (0 .. 38) :=
     (16#01#, 16#80#, 16#00#, 16#00#, 16#01#, 16#02#, 16#03#, 16#04#,
      16#01#, 16#01#, 16#1b#, 16#00#,
      16#00#, 16#01#, 16#00#, 16#15#,
      16#05#, 16#01#, 16#00#, 16#00#, 16#0d#, 16#00#, 16#00#, 16#00#,
      Byte (Character'Pos ('S')), Byte (Character'Pos ('e')),
      Byte (Character'Pos ('n')), Byte (Character'Pos ('s')),
      Byte (Character'Pos ('o')), Byte (Character'Pos ('r')),
      Byte (Character'Pos ('W')), Byte (Character'Pos ('r')),
      Byte (Character'Pos ('i')), Byte (Character'Pos ('t')),
      Byte (Character'Pos ('e')), Byte (Character'Pos ('r')),
      16#00#, 16#00#, 16#13#);

   Golden_Delete : constant Bytes (0 .. 15) :=
     (16#01#, 16#80#, 16#01#, 16#00#, 16#01#, 16#02#, 16#03#, 16#04#,
      16#03#, 16#01#, 16#04#, 16#00#,
      16#00#, 16#02#, 16#00#, 16#15#);

   Golden_Read_Data : constant Bytes (0 .. 19) :=
     (16#01#, 16#80#, 16#02#, 16#00#, 16#01#, 16#02#, 16#03#, 16#04#,
      16#08#, 16#01#, 16#08#, 16#00#,
      16#00#, 16#03#, 16#00#, 16#26#, 16#01#, 16#00#, 16#00#, 16#00#);

   Golden_Write_Data : constant Bytes (0 .. 17) :=
     (16#01#, 16#80#, 16#03#, 16#00#, 16#01#, 16#02#, 16#03#, 16#04#,
      16#07#, 16#01#, 16#06#, 16#00#,
      16#00#, 16#04#, 16#00#, 16#15#, 16#19#, 16#00#);

   --  A second CREATE, appended to the same session: object_id=pack(raw=
   --  0x010,kind=TOPIC), the real two-level ObjectVariant::ByReference
   --  ("HelloWorldTopic") under parent=pack(raw=0x001,kind=PARTICIPANT),
   --  request_id=5, sequence_nr=4. OBJK_TOPIC's own representation
   --  carries its participant's ObjectId (commit 31c62df2a63, "xrce:
   --  OBJK_TOPIC_Representation carries its participant's ObjectId"),
   --  the same trailing field OBJK_PUBLISHER's representation carries
   --  above -- matches
   --  endpoints/testdata/xrce-client/xrce_client_create_topic.bin,
   --  generated by endpoints/golden-gen, not a hand-picked byte string.
   Golden_Create_Topic : constant Bytes (0 .. 41) :=
     (16#01#, 16#80#, 16#04#, 16#00#, 16#01#, 16#02#, 16#03#, 16#04#,
      16#01#, 16#01#, 16#1e#, 16#00#,
      16#00#, 16#05#, 16#01#, 16#02#,
      16#02#, 16#01#, 16#00#, 16#00#, 16#10#, 16#00#, 16#00#, 16#00#,
      Byte (Character'Pos ('H')), Byte (Character'Pos ('e')),
      Byte (Character'Pos ('l')), Byte (Character'Pos ('l')),
      Byte (Character'Pos ('o')), Byte (Character'Pos ('W')),
      Byte (Character'Pos ('o')), Byte (Character'Pos ('r')),
      Byte (Character'Pos ('l')), Byte (Character'Pos ('d')),
      Byte (Character'Pos ('T')), Byte (Character'Pos ('o')),
      Byte (Character'Pos ('p')), Byte (Character'Pos ('i')),
      Byte (Character'Pos ('c')),
      16#00#, 16#00#, 16#11#);

   Writer_Id      : constant Unsigned_16 := Pack_Object_Id (16#001#, Objk_Datawriter);
   Publisher_Id   : constant Unsigned_16 := Pack_Object_Id (16#001#, Objk_Publisher);
   Reader_Id      : constant Unsigned_16 := Pack_Object_Id (16#002#, Objk_Datareader);
   Topic_Id       : constant Unsigned_16 := Pack_Object_Id (16#010#, Objk_Topic);
   Participant_Id : constant Unsigned_16 := Pack_Object_Id (16#001#, Objk_Participant);

begin

   --  ---- state machine ----

   declare
      C : Client;
   begin
      Init (C, State_Key);
      Check (C.Status = Disconnected, "new client is disconnected");
      Check (C.Client_Key = State_Key, "client_key stored");
   end;

   declare
      C : Client;
      R : Op_Result;
   begin
      Init (C, State_Key);
      Connect (C, Session_Id, R);
      Check (R = Ok, "connect ok");
      Check (C.Status = Connecting, "state = connecting");
   end;

   declare
      C : Client;
      R : Op_Result;
   begin
      Init (C, State_Key);
      Connect (C, Session_Id, R);
      Mark_Connected (C, R);
      Check (R = Ok, "mark_connected ok");
      Check (C.Status = Connected, "state = connected");
   end;

   declare
      C : Client;
      R : Op_Result;
   begin
      Init (C, State_Key);
      Connect (C, Session_Id, R);
      Connect (C, Session_Id, R);
      Check (R = Invalid_State, "second connect() rejected");
   end;

   declare
      C   : Client;
      Req : Unsigned_16;
      R   : Op_Result;
   begin
      Init (C, State_Key);
      Create_Object (C, Req, R);
      Check (R = Invalid_State, "create_object before connect rejected");
   end;

   declare
      C   : Client;
      Req : Unsigned_16;
      R   : Op_Result;
   begin
      Init (C, State_Key);
      Request_Write (C, Req, R);
      Check (R = Invalid_State, "request_write before connect rejected");
   end;

   declare
      C   : Client;
      Req : Unsigned_16;
      R   : Op_Result;
   begin
      Init (C, State_Key);
      Request_Read (C, Req, R);
      Check (R = Invalid_State, "request_read before connect rejected");
   end;

   declare
      C          : Client;
      R          : Op_Result;
      R1, R2, R3, R4 : Unsigned_16;
   begin
      Init (C, State_Key);
      Connect (C, Session_Id, R);
      Mark_Connected (C, R);
      Create_Object (C, R1, R);  Check (R = Ok, "create ok");
      Delete_Object (C, R2, R);  Check (R = Ok, "delete ok");
      Request_Write (C, R3, R);  Check (R = Ok, "write ok");
      Request_Read (C, R4, R);   Check (R = Ok, "read ok");
      Check (R1 = 1 and R2 = 2 and R3 = 3 and R4 = 4,
             "request ids strictly monotonic");
   end;

   declare
      C : Client;
      R : Op_Result;
   begin
      Init (C, State_Key);
      Connect (C, Session_Id, R);
      Mark_Connected (C, R);
      Disconnect (C);
      Check (C.Status = Disconnected, "disconnect -> disconnected");
   end;

   --  request_id wraps 65535 -> 1, never 0.
   declare
      C   : Client;
      R   : Op_Result;
      Req : Unsigned_16;
   begin
      Init (C, State_Key);
      C.Next_Request_Id := 16#FFFF#;
      Connect (C, Session_Id, R);
      Mark_Connected (C, R);
      Create_Object (C, Req, R);
      Check (R = Ok and Req = 16#FFFF#, "last id before wrap is 65535");
      Create_Object (C, Req, R);
      Check (R = Ok and Req = 1, "wraps to 1, not 0");
   end;

   --  ---- framing, against endpoints/testdata/xrce-client/ (*.bin) ----

   declare
      Repr : constant Frame_Store :=
        Encode_Client_Representation
          (Version => (16#01#, 16#00#), Vendor_Id => (16#00#, 16#00#),
           Key => Fixture_Key, Session_Id => Session_Id);
      FS : constant Frame_Store :=
        Frame_Create_Client (Session_Id, Fixture_Key, Repr);
   begin
      Check (FS.Len = 28, "CREATE_CLIENT frame length 28");
      Check (Frame_Equals (FS, Golden_Create_Client),
             "CREATE_CLIENT byte-identical to xrce_client_create_client.bin");
   end;

   --  ---- representation timestamps (DDS-XRCE 1.0 7.8.2.1 prose vs
   --  Annex A / B.1) ----
   declare
      Absent_Bytes : constant Bytes (0 .. 15) :=
        (16#58#, 16#52#, 16#43#, 16#45#, 16#01#, 16#00#, 16#00#, 16#00#,
         16#01#, 16#02#, 16#03#, 16#04#, 16#01#, 16#00#, 16#FC#, 16#01#);
      Appendable_Bytes : constant Bytes (0 .. 27) :=
        (16#58#, 16#52#, 16#43#, 16#45#, 16#01#, 16#00#, 16#00#, 16#00#,
         16#08#, 16#00#, 16#00#, 16#00#,
         16#8C#, 16#AA#, 16#88#, 16#5A#, 16#00#, 16#65#, 16#CD#, 16#1D#,
         16#01#, 16#02#, 16#03#, 16#04#, 16#01#, 16#00#, 16#FC#, 16#01#);
      Final_Bytes : constant Bytes (0 .. 23) :=
        (16#58#, 16#52#, 16#43#, 16#45#, 16#01#, 16#00#, 16#00#, 16#00#,
         16#8C#, 16#AA#, 16#88#, 16#5A#, 16#00#, 16#65#, 16#CD#, 16#1D#,
         16#01#, 16#02#, 16#03#, 16#04#, 16#01#, 16#00#, 16#FC#, 16#01#);

      function Same (FS : Frame_Store; Expected : Bytes) return Boolean is
      begin
         if FS.Len /= Expected'Length then
            return False;
         end if;
         for I in Expected'Range loop
            if FS.Data (I) /= Expected (I) then
               return False;
            end if;
         end loop;
         return True;
      end Same;

      Dflt : constant Frame_Store :=
        Encode_Client_Representation
          (Version => (16#01#, 16#00#), Vendor_Id => (16#00#, 16#00#),
           Key => Fixture_Key, Session_Id => 16#01#);
      Abs_Explicit : constant Frame_Store :=
        Encode_Client_Representation
          (Version => (16#01#, 16#00#), Vendor_Id => (16#00#, 16#00#),
           Key => Fixture_Key, Session_Id => 16#01#,
           Timestamps => Absent, Seconds => 1, Nanoseconds => 2);
      Present_App : constant Frame_Store :=
        Encode_Client_Representation
          (Version => (16#01#, 16#00#), Vendor_Id => (16#00#, 16#00#),
           Key => Fixture_Key, Session_Id => 16#01#,
           Timestamps => Present, Seconds => 1518905996,
           Nanoseconds => 500000000);
      Present_Fin : constant Frame_Store :=
        Encode_Client_Representation
          (Version => (16#01#, 16#00#), Vendor_Id => (16#00#, 16#00#),
           Key => Fixture_Key, Session_Id => 16#01#,
           Timestamps => Present, Seconds => 1518905996,
           Nanoseconds => 500000000, Mode => Reliable.Final);
      Framed : constant Frame_Store :=
        Frame_Create_Client (16#01#, Fixture_Key, Present_App);
   begin
      Check (Same (Dflt, Absent_Bytes), "representation timestamps default is absent (16 octets)");
      Check (Same (Abs_Explicit, Absent_Bytes), "representation timestamps absent (16 octets)");
      Check (Same (Present_App, Appendable_Bytes), "representation timestamps present, appendable (28 octets)");
      Check (Same (Present_Fin, Final_Bytes), "representation timestamps present, final (24 octets)");
      --  header 8 + submessage header 4 + 28; length field 28.
      Check (Framed.Len = 40 and then Framed.Data (10) = 28
             and then Framed.Data (11) = 0,
             "CREATE_CLIENT submessage length grows to 28");
   end;

   declare
      Repr : constant Frame_Store :=
        Encode_Client_Representation
          (Version => (16#01#, 16#00#), Vendor_Id => (16#00#, 16#00#),
           Key => Fixture_Key, Session_Id => 16#81#);
      FS : constant Frame_Store :=
        Frame_Create_Client (16#81#, Fixture_Key, Repr);
   begin
      Check (FS.Len = 24 and then FS.Data (0) = 16#80#
             and then FS.Data (1) = 16#00#,
             "CREATE_CLIENT session >= 128: header session 0x80, no client key");
   end;

   declare
      FS : constant Frame_Store :=
        Frame_Create
          (Session_Id => Session_Id, Key => Fixture_Key, Seq => 0,
           Request_Id => 1, Object_Id => Writer_Id, Object_Kind => Objk_Datawriter,
           Reference => "SensorWriter", Has_Parent => True,
           Parent_Object_Id => Publisher_Id, Reuse => False, Replace => False);
   begin
      Check (FS.Len = 39, "CREATE frame length 39");
      Check (Frame_Equals (FS, Golden_Create),
             "CREATE byte-identical to xrce_client_create.bin");
   end;

   declare
      FS : constant Frame_Store :=
        Frame_Delete (Session_Id, Fixture_Key, 1, 2, Writer_Id);
   begin
      Check (FS.Len = 16, "DELETE frame length 16");
      Check (Frame_Equals (FS, Golden_Delete),
             "DELETE byte-identical to xrce_client_delete.bin");
   end;

   declare
      FS : constant Frame_Store :=
        Frame_Read_Data (Session_Id, Fixture_Key, 2, 3, Reader_Id, 16#01#);
   begin
      Check (FS.Len = 20, "READ_DATA frame length 20");
      Check (Frame_Equals (FS, Golden_Read_Data),
             "READ_DATA byte-identical to xrce_client_read_data.bin");
   end;

   declare
      Sample : constant Bytes (0 .. 1) := (16#19#, 16#00#);
      FS : constant Frame_Store :=
        Frame_Write_Data (Session_Id, Fixture_Key, 3, 4, Writer_Id, Sample);
   begin
      Check (FS.Len = 18, "WRITE_DATA frame length 18");
      Check (Frame_Equals (FS, Golden_Write_Data),
             "WRITE_DATA byte-identical to xrce_client_write_data.bin");
   end;

   declare
      FS : constant Frame_Store :=
        Frame_Create
          (Session_Id => Session_Id, Key => Fixture_Key, Seq => 4,
           Request_Id => 5, Object_Id => Topic_Id, Object_Kind => Objk_Topic,
           Reference => "HelloWorldTopic", Has_Parent => True,
           Parent_Object_Id => Participant_Id, Reuse => False, Replace => False);
   begin
      Check (FS.Len = 42, "CREATE(topic) frame length 42");
      Check (Frame_Equals (FS, Golden_Create_Topic),
             "CREATE(topic) byte-identical to xrce_client_create_topic.bin");
   end;

   --  ---- an end-to-end session, state machine driving the framing ----
   --
   --  Fixtures 2-5 are read independently, each as one wire example of
   --  its own submessage kind -- not as one application-consistent
   --  object lifecycle: WRITE_DATA below targets the DataWriter DELETE
   --  already removed, and nothing about either frame's bytes depends
   --  on the other one having run first.

   declare
      C   : Client;
      R   : Op_Result;
      Req : Unsigned_16;
      FS  : Frame_Store;
   begin
      Init (C, Fixture_Key);
      Connect (C, Session_Id, R);
      Check (R = Ok, "e2e connect");
      FS := Frame_Create_Client
        (C.Session_Id, C.Client_Key,
         Encode_Client_Representation
           (Version => (16#01#, 16#00#), Vendor_Id => (16#00#, 16#00#),
            Key => C.Client_Key, Session_Id => C.Session_Id));
      Check (Frame_Equals (FS, Golden_Create_Client), "e2e CREATE_CLIENT frame");

      Mark_Connected (C, R);
      Check (R = Ok, "e2e mark_connected");

      Create_Object (C, Req, R);
      Check (R = Ok and Req = 1, "e2e create_object, request id 1");
      FS := Frame_Create
        (Session_Id => C.Session_Id, Key => C.Client_Key, Seq => 0,
         Request_Id => Req, Object_Id => Writer_Id, Object_Kind => Objk_Datawriter,
         Reference => "SensorWriter", Has_Parent => True,
         Parent_Object_Id => Publisher_Id, Reuse => False, Replace => False);
      Check (Frame_Equals (FS, Golden_Create), "e2e CREATE frame");

      Delete_Object (C, Req, R);
      Check (R = Ok and Req = 2, "e2e delete request id 2");

      Request_Read (C, Req, R);
      Check (R = Ok and Req = 3, "e2e read request id 3");

      Request_Write (C, Req, R);
      Check (R = Ok and Req = 4, "e2e write request id 4");
   end;

   if Failures = 0 then
      Put_Line ("XRCE client: all checks OK");
   else
      Put_Line (Natural'Image (Failures) & " check(s) FAILED");
   end if;

end Test_Xrce_Client;
