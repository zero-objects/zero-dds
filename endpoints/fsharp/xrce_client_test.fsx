//
// Byte-golden + state-machine test for xrce_client.fs, checked against
// endpoints/testdata/xrce-client/ (*.bin), the same fixtures every other
// language port of this client in this repository is checked against.
// Golden bytes embedded here rather than read from the fixture files, so
// this test needs no working-directory convention of its own (same
// reasoning as test.fsx's own byte-identity check and
// endpoints/c/test/test_xrce_client.c).
//
// Run with `dotnet fsi xrce_client_test.fsx`.

#load "xrce_client.fs"

open ZeroDDSXrce

let fixtureKey = [| 0x01uy; 0x02uy; 0x03uy; 0x04uy |]
let stateKey = [| 0xAAuy; 0xBBuy; 0xCCuy; 0xDDuy |]
let sessionId = 0x01uy

// session_id = 0x01 throughout (<=127, so every header carries the
// ClientKey; the CREATE_CLIENT header itself carries
// SESSION_ID_NONE_WITH_CLIENT_KEY 0x00, DDS-XRCE 1.0 8.3.2.1). CREATE_CLIENT travels on StreamIdNone, seq 0. The four
// post-handshake operations are all reliable, so they share
// StreamIdBuiltinReliable (0x80) and a real, strictly increasing sequence
// number (0..3) -- not the best-effort stream with hand-picked numbers a
// previous fixture set used.
let goldenCreateClient =
    [| 0x00uy; 0x00uy; 0x00uy; 0x00uy; 0x01uy; 0x02uy; 0x03uy; 0x04uy
       0x00uy; 0x01uy; 0x10uy; 0x00uy
       0x58uy; 0x52uy; 0x43uy; 0x45uy; 0x01uy; 0x00uy; 0x00uy; 0x00uy; 0x01uy; 0x02uy; 0x03uy; 0x04uy
       0x01uy; 0x00uy; 0xfcuy; 0x01uy |]

let goldenCreate =
    [| 0x01uy; 0x80uy; 0x00uy; 0x00uy; 0x01uy; 0x02uy; 0x03uy; 0x04uy
       0x01uy; 0x01uy; 0x1buy; 0x00uy
       0x00uy; 0x01uy; 0x00uy; 0x15uy
       0x05uy; 0x01uy; 0x00uy; 0x00uy; 0x0duy; 0x00uy; 0x00uy; 0x00uy
       0x53uy; 0x65uy; 0x6euy; 0x73uy; 0x6fuy; 0x72uy; 0x57uy; 0x72uy; 0x69uy; 0x74uy; 0x65uy; 0x72uy; 0x00uy
       0x00uy; 0x13uy |]

let goldenDelete =
    [| 0x01uy; 0x80uy; 0x01uy; 0x00uy; 0x01uy; 0x02uy; 0x03uy; 0x04uy
       0x03uy; 0x01uy; 0x04uy; 0x00uy
       0x00uy; 0x02uy; 0x00uy; 0x15uy |]

let goldenWriteData =
    [| 0x01uy; 0x80uy; 0x03uy; 0x00uy; 0x01uy; 0x02uy; 0x03uy; 0x04uy
       0x07uy; 0x01uy; 0x06uy; 0x00uy
       0x00uy; 0x04uy; 0x00uy; 0x15uy; 0x19uy; 0x00uy |]

let goldenReadData =
    [| 0x01uy; 0x80uy; 0x02uy; 0x00uy; 0x01uy; 0x02uy; 0x03uy; 0x04uy
       0x08uy; 0x01uy; 0x08uy; 0x00uy
       0x00uy; 0x03uy; 0x00uy; 0x26uy; 0x01uy; 0x00uy; 0x00uy; 0x00uy |]

// A second CREATE, appended to the same session: object_id=pack(raw=0x010,
// kind=Topic), the real two-level ObjectVariant::ByReference
// ("HelloWorldTopic") under parent=pack(raw=0x001,kind=Participant),
// request_id=5, sequence_nr=4. OBJK_TOPIC's own representation carries
// its participant's ObjectId (commit 31c62df2a63, "xrce:
// OBJK_TOPIC_Representation carries its participant's ObjectId"), the
// same trailing field OBJK_PUBLISHER's representation carries above --
// matches endpoints/testdata/xrce-client/xrce_client_create_topic.bin,
// generated by endpoints/golden-gen, not a hand-picked byte string.
let goldenCreateTopic =
    [| 0x01uy; 0x80uy; 0x04uy; 0x00uy; 0x01uy; 0x02uy; 0x03uy; 0x04uy
       0x01uy; 0x01uy; 0x1euy; 0x00uy
       0x00uy; 0x05uy; 0x01uy; 0x02uy
       0x02uy; 0x01uy; 0x00uy; 0x00uy; 0x10uy; 0x00uy; 0x00uy; 0x00uy
       0x48uy; 0x65uy; 0x6cuy; 0x6cuy; 0x6fuy; 0x57uy; 0x6fuy; 0x72uy; 0x6cuy; 0x64uy; 0x54uy; 0x6fuy; 0x70uy; 0x69uy; 0x63uy; 0x00uy
       0x00uy; 0x11uy |]

// --- state machine -----------------------------------------------------

let c = XrceClient(stateKey)
if c.State <> Disconnected then failwith "new client is disconnected"
if c.ClientKey <> stateKey then failwith "client_key stored"

c.Connect(sessionId)
if c.State <> Connecting then failwith "state == connecting"
(try
    c.Connect(sessionId)
    failwith "second Connect() rejected"
 with :? XrceClientError -> ())

c.MarkConnected()
if c.State <> Connected then failwith "state == connected"

let r1 = c.CreateObject()
let r2 = c.DeleteObject()
let r3 = c.RequestWrite()
let r4 = c.RequestRead()
if not (r1 = 1us && r2 = 2us && r3 = 3us && r4 = 4us) then failwith "request ids strictly monotonic"

c.Disconnect()
if c.State <> Disconnected then failwith "disconnect -> disconnected"

// --- rejected before connect --------------------------------------------

let c2 = XrceClient(stateKey)
(try c2.CreateObject() |> ignore; failwith "createObject before connect rejected" with :? XrceClientError -> ())
(try c2.RequestWrite() |> ignore; failwith "requestWrite before connect rejected" with :? XrceClientError -> ())
(try c2.RequestRead() |> ignore; failwith "requestRead before connect rejected" with :? XrceClientError -> ())

// --- framing -------------------------------------------------------------

let writer = xrceObjectId 0x001 XrceObjectKind.DataWriter
let publisher = xrceObjectId 0x001 XrceObjectKind.Publisher
let reader = xrceObjectId 0x002 XrceObjectKind.DataReader

let gotCreateClient = XrceFrame.createClient sessionId fixtureKey
if gotCreateClient <> goldenCreateClient then
    failwith "CREATE_CLIENT byte-identical to xrce_client_create_client.bin"

// Requested session >= 128: header 0x80, no client key (§8.3.2.1); payload keeps 0x81.
let gotHigh = XrceFrame.createClient 0x81uy fixtureKey
if gotHigh.Length <> gotCreateClient.Length - 4 || gotHigh.[0] <> 0x80uy || gotHigh.[20] <> 0x81uy then
    failwith "CREATE_CLIENT session 0x81: header 0x80 without client key, payload 0x81"

let gotCreate =
    XrceFrame.create sessionId fixtureKey 0us 1us writer XrceObjectKind.DataWriter
        "SensorWriter" (Some publisher) false false
if gotCreate <> goldenCreate then failwith "CREATE byte-identical to xrce_client_create.bin"

let gotDelete = XrceFrame.delete sessionId fixtureKey 1us 2us writer
if gotDelete <> goldenDelete then failwith "DELETE byte-identical to xrce_client_delete.bin"

let gotReadData = XrceFrame.readData sessionId fixtureKey 2us 3us reader 0x01uy
if gotReadData <> goldenReadData then failwith "READ_DATA byte-identical to xrce_client_read_data.bin"

let gotWriteData = XrceFrame.writeData sessionId fixtureKey 3us 4us writer [| 0x19uy; 0x00uy |]
if gotWriteData <> goldenWriteData then failwith "WRITE_DATA byte-identical to xrce_client_write_data.bin"

let topic = xrceObjectId 0x010 XrceObjectKind.Topic
let participant = xrceObjectId 0x001 XrceObjectKind.Participant
let gotCreateTopic =
    XrceFrame.create sessionId fixtureKey 4us 5us topic XrceObjectKind.Topic
        "HelloWorldTopic" (Some participant) false false
if gotCreateTopic <> goldenCreateTopic then failwith "CREATE(topic) byte-identical to xrce_client_create_topic.bin"

// --- end to end ------------------------------------------------------------

let c3 = XrceClient(fixtureKey)
c3.Connect(sessionId)
if XrceFrame.createClient c3.SessionId c3.ClientKey <> goldenCreateClient then failwith "e2e CREATE_CLIENT frame"
c3.MarkConnected()

let req = c3.CreateObject()
let gotE2eCreate =
    XrceFrame.create c3.SessionId c3.ClientKey 0us req writer XrceObjectKind.DataWriter
        "SensorWriter" (Some publisher) false false
if gotE2eCreate <> goldenCreate then failwith "e2e CREATE frame"

let deleteReq = c3.DeleteObject()
if deleteReq <> 2us then failwith "e2e delete request id 2 (create_object above took 1)"

let readReq = c3.RequestRead()
if readReq <> 3us then failwith "e2e read request id 3"

let writeReq = c3.RequestWrite()
if writeReq <> 4us then failwith "e2e write request id 4"

// --- representation timestamps (DDS-XRCE 1.0 7.8.2.1 prose vs Annex A / B.1) -------

let repAbsent =
    [| 0x58uy; 0x52uy; 0x43uy; 0x45uy; 0x01uy; 0x00uy; 0x00uy; 0x00uy
       0x01uy; 0x02uy; 0x03uy; 0x04uy; 0x01uy; 0x00uy; 0xfcuy; 0x01uy |]
let repPresentAppendable =
    [| 0x58uy; 0x52uy; 0x43uy; 0x45uy; 0x01uy; 0x00uy; 0x00uy; 0x00uy
       0x08uy; 0x00uy; 0x00uy; 0x00uy
       0x8cuy; 0xaauy; 0x88uy; 0x5auy; 0x00uy; 0x65uy; 0xcduy; 0x1duy
       0x01uy; 0x02uy; 0x03uy; 0x04uy; 0x01uy; 0x00uy; 0xfcuy; 0x01uy |]
let repPresentFinal =
    [| 0x58uy; 0x52uy; 0x43uy; 0x45uy; 0x01uy; 0x00uy; 0x00uy; 0x00uy
       0x8cuy; 0xaauy; 0x88uy; 0x5auy; 0x00uy; 0x65uy; 0xcduy; 0x1duy
       0x01uy; 0x02uy; 0x03uy; 0x04uy; 0x01uy; 0x00uy; 0xfcuy; 0x01uy |]
let repSec = 0x5A88AA8C
let repNsec = 0x1DCD6500u

if XrceFrame.encodeClientRepresentation 0x0100us 0us fixtureKey sessionId 508us <> repAbsent then
    failwith "representation: default is absent, 16 octets"
if XrceFrame.encodeClientRepresentationWith 0x0100us 0us fixtureKey sessionId 508us
       RepresentationTimestamps.Absent XrceUnannotatedTypes.Appendable repSec repNsec <> repAbsent then
    failwith "representation: absent ignores the timestamp"
if XrceFrame.encodeClientRepresentationWith 0x0100us 0us fixtureKey sessionId 508us
       RepresentationTimestamps.Present XrceUnannotatedTypes.Appendable repSec repNsec <> repPresentAppendable then
    failwith "representation: present, appendable, 28 octets"
if XrceFrame.encodeClientRepresentationWith 0x0100us 0us fixtureKey sessionId 508us
       RepresentationTimestamps.Present XrceUnannotatedTypes.Final repSec repNsec <> repPresentFinal then
    failwith "representation: present, final, 24 octets"

let repFrame =
    XrceFrame.createClientWith sessionId fixtureKey
        RepresentationTimestamps.Present XrceUnannotatedTypes.Appendable repSec repNsec
if repFrame.Length <> 8 + 4 + 28 || repFrame.[10] <> 28uy || repFrame.[11] <> 0uy then
    failwith "CREATE_CLIENT present: submessage length 28"

let c4 = XrceClient(fixtureKey)
if c4.RepresentationTimestamps <> RepresentationTimestamps.Absent then failwith "client default is absent"
c4.RepresentationTimestamps <- RepresentationTimestamps.Present
c4.Connect(sessionId)
if (XrceFrame.createClientFor c4).Length <> 8 + 4 + 28 then
    failwith "client option present: CREATE_CLIENT grows to 28 octets"

printfn "XRCE client (F#): all checks OK"
