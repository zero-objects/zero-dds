// documentation/04-idl/examples/Robot.idl
//
// A canonical typed schema used throughout the docs as a running
// example. Compile with any of:
//   dds-idlc Robot.idl --rust   -o gen/rust
//   dds-idlc Robot.idl --cpp    -o gen/cpp
//   dds-idlc Robot.idl --java   -o gen/java
//   dds-idlc Robot.idl --csharp -o gen/cs
//   dds-idlc Robot.idl --ts     -o gen/ts
//   dds-idlc Robot.idl --python -o gen/py

module Robot {

    // A position-only sample. @final = no extensibility, tightest wire packing.
    @final
    struct Position {
        @key string<32> robot_id;
        double x;
        double y;
        double z;
    };

    // Full pose. Inherits "robot_id" via the key field; we do NOT
    // use IDL inheritance here because @final blocks it.
    @final
    struct Pose {
        @key string<32> robot_id;
        double x;
        double y;
        double z;
        double yaw_rad;
        double pitch_rad;
        double roll_rad;
    };

    // Joint angles for a 6-axis arm. Bounded sequence keeps the
    // wire size predictable.
    @appendable
    struct JointAngles {
        @key string<32> robot_id;
        sequence<double, 6> angles_rad;
        unsigned long long t_nanos;
    };

    // Telemetry: composes the above + a status enum + a free-form string.
    enum HealthStatus {
        HEALTH_OK,
        HEALTH_WARN,
        HEALTH_FAULT
    };

    @appendable
    struct Telemetry {
        @key string<32> robot_id;
        Pose pose;
        JointAngles joints;
        HealthStatus health;
        @optional string<128> note;
        unsigned long long t_nanos;
    };

    // Bitmask for cause-tracking on faults.
    @bit_bound(16)
    bitmask FaultCause {
        BATTERY_LOW,
        OVERHEAT,
        ESTOP_PRESSED,
        COMMUNICATION_LOSS,
        ENCODER_DRIFT,
        @position(15) UNKNOWN
    };

    // Command: discriminated union — one cmd per sample.
    enum CommandKind {
        CMD_MOVE_TO,
        CMD_HOME,
        CMD_ESTOP
    };

    union Command switch (CommandKind) {
        case CMD_MOVE_TO:
            Position target;
        case CMD_HOME:
            // empty branch — just the discriminator carries it.
        case CMD_ESTOP:
            string<128> reason;
    };

};
