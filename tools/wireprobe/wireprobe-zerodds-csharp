#!/bin/bash
# wireprobe-zerodds-csharp — one IDL type and one JSON value, through the
# ZeroDDS C# binding.
#
# The same command line as `wireprobe-zerodds`, minus the flags this
# column does not answer yet, so a case runs through both by
# substituting the program name. See
# `docs/specs/zerodds-interop-suite-1.0.md` §3a.
#
#   wireprobe-zerodds-csharp --idl robot.idl --type common::Robot \
#                            --values robot.json --encoding xcdr2 --endian le \
#                            --out robot.zerodds-csharp.xcdr2.le.bin
#
#   wireprobe-zerodds-csharp --idl robot.idl --type common::Robot \
#                            --in robot.cyclone.xcdr2.le.bin --encoding xcdr2 \
#                            --endian le --values-out robot.read.json
#
# `wireprobe-zerodds-csharp-gen` writes the C# — the types, the codec and
# either the statements that fill one sample or the ones that print one —
# and this compiles it against `runtime/csharp` and runs it. The bytes and
# the values come out of the C# runtime; nothing in this script decides a
# wire question, and nothing in the compiled program calls the Rust one.
#
# ## Why Roslyn directly and not `dotnet build`
#
# A corpus sweep is one probe per case per configuration — thousands of
# compilations. `dotnet build` spends two to four seconds in MSBuild
# before Roslyn sees a file, which is hours across a sweep; `csc.dll` out
# of the SDK compiles the two generated files in well under a second. The
# runtime is compiled once into a cached assembly, keyed on the contents
# of its sources, exactly as the Java column caches its class files.
# ## The exit codes
#
# `docs/specs/zerodds-verdicts-1.0.md`, and structural rather than read
# out of a message:
#
#   0  it carried the case
#   1  the command line — this script's own options, or the generator's,
#      or a sample the compiled probe refused as outside its type
#   3  no-form — C# has no form for the construct, which is the
#      materialiser's or the filler's answer, or the probe discarded the
#      sample under 7.2.2.7
#   6  harness-gap — a tool of ours has not written it: the walk
#      stopped, a runtime of ours would not build, or the program did
#      not run
#   7  generator-defect — the generator accepted the case and the
#      C# it produced does not compile
#
# 8 (`mapping-divergence`) is not produced here. It is a verdict about a
# *foreign* mapping rule making the octets differ — CORBA's `long
# double` is the recorded case — and this column has no such rule: where
# its reading of 7.4 differs from the Rust column's the answer is a byte
# difference the ledger shows, not an exit code.
#
# The generator's own code passes straight through. Folding it into one
# number here is what four of these wrappers used to do, with
# `|| exit 3`, and it put "this language has no form for it" and "our
# walk stopped" in one bucket — the distinction the whole ledger turns
# on. Two of them also answered **5** for source that would not compile,
# which is in no row of the table at all and lands as `refused` where
# `generator-defect` belongs.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/../.." && pwd)"
source "$here/runtime-cache.sh"
runtime="${ZERODDS_CSHARP_RUNTIME:-$root/runtime/csharp}"
DOTNET="${DOTNET:-dotnet}"

if ! command -v "$DOTNET" >/dev/null 2>&1; then
    echo "wireprobe-zerodds-csharp: no \`$DOTNET\` on PATH; set DOTNET" >&2
    exit 9
fi

# The SDK's own Roslyn and its reference assemblies.
#
# Asked of `dotnet --list-sdks` rather than derived from the path of the
# `dotnet` on PATH. That derivation was wrong on a Homebrew install and
# right on a tarball one: `/opt/dotnet/dotnet` has its `sdk` beside it,
# and `/opt/homebrew/bin/dotnet` resolves to `…/Cellar/dotnet/9.0.5/bin`
# whose SDK is one level up under `libexec`. `--list-sdks` prints
# `<version> [<directory>]` and is the installation's own answer.
csc="${ZERODDS_CSC:-}"
refdir="${ZERODDS_NETREF:-}"
if [ -z "$csc" ] || [ -z "$refdir" ]; then
    sdk_line=$("$DOTNET" --list-sdks 2>/dev/null | sort -V | tail -1 || true)
    if [ -z "$sdk_line" ]; then
        echo "wireprobe-zerodds-csharp: \`$DOTNET --list-sdks\` names none; a runtime-only \
install has no compiler" >&2
        exit 6
    fi
    sdk_version="${sdk_line%% *}"
    sdk_dir="${sdk_line#*\[}"
    sdk_dir="${sdk_dir%\]}"
    dotnet_root="$(dirname "$sdk_dir")"
    [ -n "$csc" ] || csc="$sdk_dir/$sdk_version/Roslyn/bincore/csc.dll"
    # The newest reference pack the installation carries. The runtime
    # targets `net8.0` and compiles against a later pack unchanged: it
    # names nothing that moved.
    if [ -z "$refdir" ]; then
        refdir=$(ls -1d "$dotnet_root"/packs/Microsoft.NETCore.App.Ref/*/ref/net*.0 2>/dev/null \
            | sort -V | tail -1 || true)
    fi
fi
if [ ! -f "$csc" ]; then
    echo "wireprobe-zerodds-csharp: no csc.dll at $csc; set ZERODDS_CSC" >&2
    exit 6
fi
if [ -z "$refdir" ] || [ ! -d "$refdir" ]; then
    echo "wireprobe-zerodds-csharp: no Microsoft.NETCore.App.Ref pack beside $csc; \
set ZERODDS_NETREF" >&2
    exit 6
fi

gen="${WIREPROBE_CSHARP_GEN:-}"
if [ -z "$gen" ]; then
    gen="${CARGO_TARGET_DIR:-$root/target}/debug/wireprobe-zerodds-csharp-gen"
    # Built when it is missing *or stale*: a generator older than the
    # sources it came from measures the previous build, and says nothing
    # about it.
    . "$here/generator.sh"
    probe_generator zerodds-wireprobe-csharp-gen "$gen" "$root" || exit 6
fi

out=""
input=""
values_out=""
argv=()
idl=""
while [ $# -gt 0 ]; do
    case "$1" in
        --out) out="$2"; shift 2 ;;
        --in) input="$2"; shift 2 ;;
        --values-out) values_out="$2"; shift 2 ;;
        # Every LayoutKey axis the stem parses, not the seven this
        # wrapper used to name. The C and Python wrappers forwarded all
        # sixteen and these four forwarded none, so a sweep over any axis
        # answered `--length-codes is not an option` with exit 1 for four
        # of the six columns and measured only the other two.
        --idl|--type|--values|--encoding|--endian|--emit|--dialect|\
        --length-codes|--collection-delimiters|--wstring-length|--map-length|\
        --wchar-framing|--wchar-width|--map-delimiter|--wstring-units|--pid-flags|\
        --enum-holder|--union-labels|\
        --map-entries|--fixed-digits|--enumerator-value|--union-framing|--short-pid-range)
            if [ "$1" = --idl ]; then idl="$2"; fi
            argv+=("$1" "$2"); shift 2 ;;
        --help|-h) sed -n '2,61p' "${BASH_SOURCE[0]}"; exit 0 ;;
        *) echo "wireprobe-zerodds-csharp: \`$1\` is not an option" >&2; exit 1 ;;
    esac
done

. "$here/diagnostics.sh"

# One direction or the other, never both: a run that both wrote bytes and
# read some in would report one of the two and the caller could not tell
# which.
if [ -n "$input" ]; then
    for flag in "${argv[@]}"; do
        if [ "$flag" = "--values" ]; then
            echo "wireprobe-zerodds-csharp: --in reads bytes and --values writes them; pick one" >&2
            exit 1
        fi
    done
    argv+=(--read)
fi

stage=""
work="$(mktemp -d)"
trap '[ -z "$stage" ] || rm -rf "${stage:?}"; probe_keep_generated "$work" "zerodds-csharp" "$idl" ZdTypes.cs Probe.cs; rm -rf "${work:?}"' EXIT
trap 'exit 6' HUP INT TERM

code=0
"$gen" "${argv[@]}" --out-dir "$work" || code=$?
[ "$code" = 0 ] || exit "$code"

# The framework references, as one `-r:` per assembly. Held in a file
# rather than on the command line: `net8.0` is about 160 assemblies and
# the line is longer than some `execve` limits.
refs="$work/refs.rsp"
: > "$refs"
for dll in "$refdir"/*.dll; do
    printf -- '-r:%s\n' "$dll" >> "$refs"
done

# The runtime is compiled once and kept, keyed on the contents of its
# sources. The key is a hash and not a timestamp, so a runtime that moves
# invalidates the cache and one that only got touched does not.
runtime_sources=$(find "$runtime/src" -name '*.cs' | sort)
# shellcheck disable=SC2086
key=$(cat $runtime_sources | shasum | cut -c1-16)
cache="${ZERODDS_CSHARP_CACHE:-${TMPDIR:-/tmp}/zd-csharp-runtime}/$key"
if ! runtime_cache_ready "$cache" -s ZeroDds.Wire.dll; then
    mkdir -p "$(dirname "$cache")"
    stage=$(mktemp -d "$cache.tmp.XXXXXX")
    # `-warnaserror` for the reason the C column compiles with `-Werror`
    # and the Java one with `-Xlint:all -Werror`: a warning in a wire
    # runtime is a question nobody answered.
    # shellcheck disable=SC2086
    if ! "$DOTNET" "$csc" -nologo -nostdlib -noconfig -langversion:12.0 \
            -warnaserror+ -warn:4 -optimize+ -deterministic \
            -target:library "-out:$stage/ZeroDds.Wire.dll" \
            "@$refs" $runtime_sources > "$work/runtime.log" 2>&1; then
        echo "wireprobe-zerodds-csharp: runtime/csharp did not compile" >&2
        grep -m10 -E "error|warning" "$work/runtime.log" >&2 || true
        rm -rf "${stage:?}"
        exit 6
    fi
    if ! runtime_cache_publish "$stage" "$cache" -s ZeroDds.Wire.dll; then
        rm -rf "${stage:?}"
        exit 6
    fi
    rm -rf "${stage:?}"
fi

sources=("$work/ZdTypes.cs" "$work/Probe.cs")
if [ -n "$input" ]; then
    # The canonical-JSON helpers, the same contract `Zdj.java` and
    # `dumpjson.h` carry: the JSON dialect is shared and not a wire rule,
    # and two backends holding two copies of it is how they come to
    # disagree about what a sample is.
    cp "$here/Zdj.cs" "$work/"
    sources+=("$work/Zdj.cs")
fi

# `-warnaserror` on the probe too: a generated file that warns is one
# whose warnings stop being read.
if ! "$DOTNET" "$csc" -nologo -nostdlib -noconfig -langversion:12.0 \
        -warnaserror+ -warn:4 -optimize+ -deterministic \
        -target:exe -main:Probe "-out:$work/Probe.dll" \
        "@$refs" "-r:$cache/ZeroDds.Wire.dll" \
        "${sources[@]}" > "$work/csc.log" 2>&1; then
    echo "wireprobe-zerodds-csharp: the probe did not compile" >&2
    grep -m10 -E "error|warning" "$work/csc.log" >&2 || true
    exit 7
fi

# What `dotnet Probe.dll` needs to find a shared framework. Written here
# rather than by MSBuild, because MSBuild is the thing this script skips.
#
# `rollForward: LatestMajor` because the installed runtime is the
# measurement host's and not this tree's: the Linux test host carries 8.0 and a
# developer machine may carry only 9. A probe that insisted on the
# major it was written against would be unmeasurable on half of them,
# and nothing here depends on a version.
cat > "$work/Probe.runtimeconfig.json" <<'JSON'
{
  "runtimeOptions": {
    "tfm": "net8.0",
    "rollForward": "LatestMajor",
    "framework": { "name": "Microsoft.NETCore.App", "version": "8.0.0" }
  }
}
JSON
cp "$cache/ZeroDds.Wire.dll" "$work/"

if [ -n "$input" ]; then
    # 3 is the probe's "the sample is discarded" and is passed through
    # rather than folded into 6. DDS-XTypes 1.3 7.2.2.7: the receiver
    # drops the object and carries on, which is a different thing from a
    # reader that could not read, and a harness has to be able to tell
    # them apart. The Rust, C and Java probes use the same code.
    code=0
    "$DOTNET" "$work/Probe.dll" < "$input" > "$work/values.json" \
        2> "$work/run.log" || code=$?
    if [ "$code" != 0 ]; then
        head -5 "$work/run.log" >&2 || true
        [ "$code" = 3 ] && exit 3
        exit 6
    fi
    if [ -n "$values_out" ]; then
        cp "$work/values.json" "$values_out"
    else
        cat "$work/values.json"
    fi
    exit 0
fi

# 1 is the probe's "this sample is outside the type" and is passed
# through rather than folded into 6. `primitive-char-above-latin1` is a
# `char` holding U+0161 and 7.2.2.2.1.2.2 says a CHAR_8_TYPE "shall be
# representable using 8 bits"; the Rust probe answers 1 for the same
# sample, and a column that answered `harness-gap` for it would be
# claiming a tool of ours is missing. Anything else the program does is
# 6, because then it really is this harness that could not carry the
# case.
#
# The probe's own words go first. A recorder takes the first line of
# stderr as the reason, and a wrapper's "did not run" above it puts the
# harness's summary in the ledger where the refusal belongs —
# `docs/specs/zerodds-verdicts-1.0.md`: a verdict names its evidence.
code=0
"$DOTNET" "$work/Probe.dll" > "$work/bytes.bin" 2> "$work/run.log" || code=$?
if [ "$code" != 0 ]; then
    if [ -s "$work/run.log" ]; then
        head -5 "$work/run.log" >&2
    else
        echo "wireprobe-zerodds-csharp: the probe did not run and said nothing" >&2
    fi
    [ "$code" = 1 ] && exit 1
    [ "$code" = 6 ] && exit 6
    exit 6
fi

if [ -n "$out" ]; then
    cp "$work/bytes.bin" "$out"
else
    od -An -tx1 -v "$work/bytes.bin" | tr -d ' \n'; echo
fi
