#!/bin/bash
# wireprobe-csharp-corpus — the C# column over the whole corpus, against
# the octets the Rust column recorded.
#
#   tools/wireprobe/wireprobe-csharp-corpus
#   MATCH=... DIFFER=0 REFUSED=... NOREF=...
#
# Generates, compiles and runs one probe per case and compares the bytes
# with `tests/interop-results/<case>/zerodds-rust/plain-cdr2.le.bin`.
# `DIFFER` is the number that matters: a case the C# runtime writes
# differently from the Rust one is a case where one of the two has
# misread DDS-XTypes 1.3, and neither calls the other.
#
# `REFUSED` is a case that did not generate, compile or run, and each is
# named with its reason and the probe's exit code —
# `docs/specs/zerodds-verdicts-1.0.md` gives the four kinds. `NOREF` is a
# case the Rust column has no recorded octets for either.
#
# The root type comes from the corpus's own `type` file. Reading it off
# the IDL instead picked the last declaration, which is the wrong root
# for `recursive-mutual` and `resolve-forward-declared`.
#
# `--read` runs the other direction instead: every case's recorded Rust
# octets are handed to the C# reader and the sample it returns is
# compared with the corpus's own `values.json` through
# `wireprobe-compare`.
set -uo pipefail
cd "$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

direction=write
[ "${1:-}" = "--read" ] && direction=read

compare="${WIREPROBE_COMPARE:-${CARGO_TARGET_DIR:-./target}/debug/wireprobe-compare}"
if [ "$direction" = read ] && [ ! -x "$compare" ]; then
    cargo build -q -p zerodds-wire-probe --bin wireprobe-compare || exit 1
fi

ok=0; bad=0; refused=0; noref=0
L="${CSHARP_CORPUS_LOG:-${TMPDIR:-/tmp}/zd-csharp-corpus-$direction.txt}"
# One sweep at a time per log. Two of them interleaving produced numbers
# that meant nothing, which is worse than a refusal to start.
lock="$L.lock"
# Created by the shell with O_EXCL: uutils mkdir before 0.11.0 reports
# success to a concurrent loser.
if ! (set -o noclobber; : > "$lock") 2>/dev/null; then
    echo "$(basename "$0"): a sweep is already running; its log is $L" >&2
    exit 2
fi
trap 'rm -f "$lock"' EXIT
: > "$L"

for d in tests/interop-corpus/*/; do
  c=$(basename "$d")
  r="tests/interop-results/$c/zerodds-rust/plain-cdr2.le.bin"
  [ -f "$d/type.idl" ] && [ -f "$d/values.json" ] || continue
  [ -f "$r" ] || { noref=$((noref+1)); continue; }
  t=$(cat "$d/type")
  [ -n "$t" ] || { noref=$((noref+1)); continue; }

  if [ "$direction" = write ]; then
    got=$(./tools/wireprobe/wireprobe-zerodds-csharp --idl "$d/type.idl" --type "$t" \
        --values "$d/values.json" --encoding plain-cdr2 --endian le 2>&1 | tail -1)
    want=$(od -An -tx1 -v "$r" | tr -d ' \n')
    if [ "$got" = "$want" ]; then ok=$((ok+1)); echo "MATCH $c" >> "$L"
    elif ! echo "$got" | grep -qE '^[0-9a-f]+$'; then
      refused=$((refused+1)); echo "REFUSED $c :: $got" >> "$L"
    else
      bad=$((bad+1)); echo "DIFFER $c" >> "$L"
      echo "  c#   $got" >> "$L"; echo "  rust $want" >> "$L"
    fi
    continue
  fi

  # The read direction. The octets are the Rust column's own, so a
  # disagreement is between two readings of one stream and not between
  # two samples.
  out=$(mktemp)
  code=0
  ./tools/wireprobe/wireprobe-zerodds-csharp --idl "$d/type.idl" --type "$t" \
      --in "$r" --encoding plain-cdr2 --endian le --values-out "$out" \
      > /dev/null 2> "$out.err" || code=$?
  if [ "$code" != 0 ]; then
    refused=$((refused+1))
    echo "REFUSED($code) $c :: $(head -1 "$out.err")" >> "$L"
    rm -f "$out" "$out.err"
    continue
  fi
  if "$compare" --idl "$d/type.idl" --type "$t" \
      --expected "$d/values.json" --found "$out" > "$out.cmp" 2>&1; then
    ok=$((ok+1)); echo "SAME $c" >> "$L"
  else
    bad=$((bad+1)); echo "DIFFERENT $c" >> "$L"
    head -5 "$out.cmp" | sed 's/^/  /' >> "$L"
  fi
  rm -f "$out" "$out.err" "$out.cmp"
done

if [ "$direction" = write ]; then
  echo "MATCH=$ok DIFFER=$bad REFUSED=$refused NOREF=$noref"
else
  echo "SAME=$ok DIFFERENT=$bad REFUSED=$refused NOREF=$noref"
fi
echo "per case: $L" >&2
[ "$bad" -eq 0 ]
