#!/bin/bash
# wireprobe-zerodds-node — one IDL type and one JSON value, through the
# ZeroDDS Node (plain JavaScript) binding built by the shared codec walk.
#
# The same command line as `wireprobe-zerodds`, so a case runs through
# both by substituting the program name. See
# `docs/specs/zerodds-interop-suite-1.0.md` §3a.
#
#   wireprobe-zerodds-node --idl robot.idl --type common::Robot \
#                          --values robot.json --encoding xcdr2 \
#                          --endian le --out robot.zerodds-node.xcdr2.le.bin
#
#   wireprobe-zerodds-node --idl robot.idl --type common::Robot \
#                          --in robot.cyclone.xcdr2.le.bin \
#                          --encoding xcdr2 --endian le \
#                          --values-out robot.read.json
#
# ## What is shared with the Rust probe and what is not
#
# Shared: the frontend, the common AST and the layout plan. Which
# members are written, in what order, with which header and which length
# code is `zerodds-ast-layout`'s answer, and a second answer would be a
# second place for the wire format to live.
#
# Not shared: the serialiser. The generated program runs beside
# `runtime/node/zdwire.js`, which implements DDS-XTypes 1.3 §7.4 a
# further time in plain JavaScript. Nothing here reaches the Rust
# runtime through FFI: a probe that did would be byte-identical by
# construction and would prove nothing about whether the two read the
# specification the same way.
#
# ## No compile step
#
# Plain JavaScript is not compiled, so this driver has no `zig
# build-exe` step to fail loudly instead. What stands in for it is
# `node --check probe.js`, run before the probe ever executes: a syntax
# error in the generated file is this generator's own defect
# (`generator-defect`, exit 7) and not "the probe did not run"
# (`harness-gap`, exit 6, a claim about a tool of ours that has not been
# written, which a syntax error is not). The same shape
# `tools/wireprobe/wireprobe-zerodds-julia` takes, which parses before
# it evaluates.
#
# ## The exit codes
#
# `docs/specs/zerodds-verdicts-1.0.md`, and structural rather than read
# out of a message:
#
#   0  it carried the case
#   1  refused — it was asked and said no. `writeChar` and `writeWchar`
#      in `runtime/node/zdwire.js` throw on a code point their width
#      cannot hold, which the harness turns into this; or the model is
#      outside what the specification admits and `zerodds-ast-layout`
#      says so before any JavaScript is written. The Rust probe answers
#      1 for both.
#   2  the command line
#   3  no-form — JavaScript has no form for the construct, which is
#      `crates/lang-rules/src/adapter/node.rs`'s answer and nobody
#      else's
#   6  harness-gap — a tool of ours has not written it: the generator
#      did not build, the shared walk has no writer or reader for a
#      construct, or the toolchain is missing
#   7  generator-defect — the generator accepted the case and the
#      JavaScript it produced does not pass `node --check`
#   9  toolchain-absent — this host has no `node`; not a measurement,
#      and the caller stops rather than filling the matrix with rows
#      about the host
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/../.." && pwd)"
runtime="${ZERODDS_NODE_RUNTIME:-$root/runtime/node}"
NODE="${NODE:-node}"

if ! "$NODE" --version >/dev/null 2>&1; then
    echo "wireprobe-zerodds-node: \`$NODE\` is not on the path; the Node column is unmeasured here" >&2
    exit 9
fi

gen="${WIREPROBE_NODE_GEN:-}"
if [ -z "$gen" ]; then
    gen="${CARGO_TARGET_DIR:-$root/target}/debug/wireprobe-zerodds-node-gen"
    # Built when it is missing *or stale*: a generator older than the
    # sources it came from measures the previous build, and says nothing
    # about it.
    . "$here/generator.sh"
    probe_generator zerodds-wireprobe-node-gen "$gen" "$root" || exit 6
fi

out=""
values_out=""
argv=()
idl=""
reading=0
while [ $# -gt 0 ]; do
    case "$1" in
        --out) out="$2"; shift 2 ;;
        --values-out) values_out="$2"; argv+=("$1" "$2"); shift 2 ;;
        --in) reading=1; argv+=("$1" "$2"); shift 2 ;;
        --idl|--type|--values|--encoding|--endian|--emit|--dialect)
            if [ "$1" = --idl ]; then idl="$2"; fi
            argv+=("$1" "$2"); shift 2 ;;
        --help|-h) sed -n '2,64p' "${BASH_SOURCE[0]}"; exit 0 ;;
        *) echo "wireprobe-zerodds-node: \`$1\` is not an option" >&2; exit 2 ;;
    esac
done

. "$here/diagnostics.sh"

work="$(mktemp -d)"
trap 'probe_keep_generated "$work" "zerodds-node" "$idl" probe.js; rm -rf "$work"' EXIT

# The generator's own code passes straight through: 3 is "JavaScript has
# no form for it" and 6 is "a tool of ours stopped", and folding the two
# into one here would lose the distinction the ledger turns on.
code=0
"$gen" "${argv[@]}" --out-dir "$work" || code=$?
[ "$code" = 0 ] || exit "$code"

# The runtime is required beside the probe rather than resolved from
# anywhere else; `require("./zdwire.js")` finds it next to `probe.js`.
cp "$runtime/zdwire.js" "$work/zdwire.js"

# `node --check` is the syntax and identifier-binding gate this column
# has instead of a compiler. It does not resolve the `require` line, so
# it needs no runtime present to run against — the copy above is only
# for the execution that follows.
if ! "$NODE" --check "$work/probe.js" > "$work/check.log" 2>&1; then
    echo "wireprobe-zerodds-node: the generated JavaScript did not pass \`node --check\`" >&2
    head -20 "$work/check.log" >&2 || true
    probe_diagnostics_after "zerodds-node" "$work" "$idl" 7
    exit 7
fi
probe_diagnostics_after "zerodds-node" "$work" "$idl" 0

# The read direction's `--in` and `--values-out` paths are baked into
# the generated program as literals, so the probe reads and writes them
# itself; nothing is piped here.
code=0
"$NODE" "$work/probe.js" > "$work/bytes.bin" 2> "$work/run.log" || code=$?
if [ "$code" != 0 ]; then
    head -5 "$work/run.log" >&2 || true
    [ "$code" = 1 ] && exit 1
    [ "$code" = 3 ] && exit 3
    echo "wireprobe-zerodds-node: the probe did not run" >&2
    exit 6
fi

# The read direction writes its JSON where `--values-out` said and puts
# nothing on stdout, so there are no octets to hand back.
if [ "$reading" = 1 ]; then
    [ -n "$values_out" ] || {
        echo "wireprobe-zerodds-node: --in without --values-out" >&2
        exit 2
    }
    exit 0
fi

if [ -n "$out" ]; then
    cp "$work/bytes.bin" "$out"
else
    od -An -tx1 -v "$work/bytes.bin" | tr -d ' \n'; echo
fi
