#!/bin/bash
# wireprobe-zig-corpus — the shared-walk Zig column over the whole
# corpus, in both directions, against the octets the Rust column
# recorded.
#
#   tools/wireprobe/wireprobe-zig-corpus
#   tools/wireprobe/wireprobe-zig-corpus --encoding plain-cdr2 --endian le
#   tools/wireprobe/wireprobe-zig-corpus --cases primitive-mixed,map-key-boolean
#
# The counterpart of `wireprobe-{go,d}-corpus`, with the same cells and
# the same one line per cell:
#
#   plain-cdr2.le  write MATCH=414 DIFFER=0 REFUSED=0 NOREF=4
#   plain-cdr2.le  read  MATCH=414 DIFFER=0 REFUSED=0 NOREF=4
#
# The four `NOREF` are the cases the **Rust column** records no octets
# for, so no column has a reference here:
# `primitive-char-above-latin1` and `primitive-wchar-above-bmp`, whose
# samples the Rust writer refuses, and `recursive-array` and
# `recursive-optional-external`, whose layout the planner refuses. The
# Zig probe answers 1 for the same four; the sweep never asks it,
# because a comparison without a reference is not a measurement.
#
# `DIFFER` is the number that matters: a case the Zig runtime writes
# differently from the Rust one is a case where one of the two has
# misread DDS-XTypes 1.3, and neither calls the other — the generated
# program is compiled against `runtime/zig/zdwire.zig` and reaches no
# Rust through FFI.
#
# ## The two directions are measured in different currencies
#
# **Writing** compares octets: the probe's bytes against
# `tests/interop-results/<case>/zerodds-rust/<encoding>.<endian>.bin`.
#
# **Reading** compares *values*: the probe is handed the Rust column's
# own bytes and its JSON is compared against the case's `values.json`
# after both are canonicalised in Rust — re-encoding what the decoder
# built and comparing bytes would pass any value the decoder invents
# that the encoder writes the same way.
#
# The root type comes from the corpus's own `type` file: reading it off
# the IDL picks the last declaration, which is the wrong root wherever a
# case declares two.
#
# ## Why this one runs cells in parallel and the D sweep does not
#
# Every case here is a Zig `build-exe`, and one direction of one case
# measured 8 s of a core on an aarch64 Darwin host with Zig 0.14.1 —
# `dmd` and `go build` are an order of magnitude under that. Serially
# the ten default cells would be about ten hours. `--jobs` (the core
# count by default) runs that many cells at once, and `WIREPROBE_CACHE`
# — the same compile cache every driver here honours — makes a second
# sweep over unchanged sources compare octets and nothing else. Set it
# to a directory before a long run:
#
#   WIREPROBE_CACHE=~/.cache/zd-probe tools/wireprobe/wireprobe-zig-corpus
set -uo pipefail
cd "$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)" || exit 6

probe=./tools/wireprobe/wireprobe-zerodds-zig
encodings=(plain-cdr1 pl-cdr1 plain-cdr2 delimited-cdr pl-cdr2)
endians=(le be)
directions=(write read)
cases=""
jobs=""

# -- one case, as its own process ----------------------------------------
#
# `--one` is this script calling itself through `xargs`; it is not part
# of the interface and takes its arguments positionally. It writes one
# word to standard output — MATCH, DIFFER, REFUSED or NOREF — and the
# detail line for the log to standard error, so the tally and the
# per-case record never have to be separated again downstream.
if [ "${1:-}" = --one ]; then
    encoding="$2"; endian="$3"; direction="$4"; c="$5"
    d="tests/interop-corpus/$c"
    r="tests/interop-results/$c/zerodds-rust/$encoding.$endian.bin"
    [ -f "$d/type.idl" ] && [ -f "$d/values.json" ] || { echo NOREF; exit 0; }
    [ -f "$r" ] || { echo NOREF; exit 0; }
    t=$(cat "$d/type")
    [ -n "$t" ] || { echo NOREF; exit 0; }
    work="$(mktemp -d)"
    trap 'rm -rf "$work"' EXIT
    code=0
    if [ "$direction" = write ]; then
        # No pipe around the probe: `$?` after one is the last stage's,
        # and the exit code *is* the verdict here.
        said=$("$probe" --idl "$d/type.idl" --type "$t" --values "$d/values.json" \
              --encoding "$encoding" --endian "$endian" 2>&1) || code=$?
        got=$(printf '%s\n' "$said" | tail -1)
        want=$(od -An -tx1 -v "$r" | tr -d ' \n')
        if [ "$code" = 0 ] && [ "$got" = "$want" ]; then
            echo MATCH
        elif [ "$code" != 0 ]; then
            echo REFUSED
            echo "REFUSED($code) $encoding.$endian write $c :: $(printf '%s\n' "$said" | head -2 | tr '\n' ' ')" >&2
        else
            echo DIFFER
            {
                echo "DIFFER $encoding.$endian write $c"
                echo "  zig  $got"
                echo "  rust $want"
            } >&2
        fi
    else
        said=$("$probe" --idl "$d/type.idl" --type "$t" --in "$r" \
              --encoding "$encoding" --endian "$endian" \
              --values-out "$work/read.json" 2>&1) || code=$?
        if [ "$code" != 0 ]; then
            echo REFUSED
            echo "REFUSED($code) $encoding.$endian read $c :: $(printf '%s\n' "$said" | head -2 | tr '\n' ' ')" >&2
        elif "$WIREPROBE_COMPARE" --idl "$d/type.idl" --type "$t" \
              --expected "$d/values.json" --found "$work/read.json" \
              > "$work/why.txt" 2>&1; then
            echo MATCH
        else
            echo DIFFER
            echo "DIFFER $encoding.$endian read $c :: $(head -3 "$work/why.txt" | tr '\n' ' ')" >&2
        fi
    fi
    exit 0
fi

while [ $# -gt 0 ]; do
    case "$1" in
        --encoding) encodings=("$2"); shift 2 ;;
        --endian) endians=("$2"); shift 2 ;;
        --direction) directions=("$2"); shift 2 ;;
        --cases) cases="$2"; shift 2 ;;
        --jobs) jobs="$2"; shift 2 ;;
        --help|-h) sed -n '2,49p' "${BASH_SOURCE[0]}"; exit 0 ;;
        *) echo "$(basename "$0"): \`$1\` is not an option" >&2; exit 2 ;;
    esac
done

if [ -z "$jobs" ]; then
    jobs="$( (nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 4) )"
fi

L="${ZIG_CORPUS_LOG:-${TMPDIR:-/tmp}/zd-zig-corpus.txt}"
# One sweep at a time per log: two of them interleaving produce numbers
# that mean nothing, which is worse than a refusal to start.
lock="$L.lock"
if ! mkdir "$lock" 2>/dev/null; then
    echo "$(basename "$0"): a sweep is already running; its log is $L" >&2
    exit 2
fi
work="$(mktemp -d)"
trap 'rmdir "$lock" 2>/dev/null; rm -rf "$work"' EXIT
: > "$L"

# The generator is built once here rather than by each probe run:
# checking staleness shells out to cargo, and doing that per case is
# most of the sweep's wall time on the columns whose compiler is fast.
cargo build -q -p zerodds-wireprobe-zig-gen 2>&1 | head -20
gen="${CARGO_TARGET_DIR:-$PWD/target}/debug/wireprobe-zerodds-zig-gen"
[ -x "$gen" ] || { echo "$(basename "$0"): the generator did not build" >&2; exit 6; }
export WIREPROBE_ZIG_GEN="$gen"

# The read direction is compared in Rust, against
# `crates/wire-probe/src/canonical.rs` — the whole reason this column
# hands its JSON out instead of reaching a verdict itself.
compare="${WIREPROBE_COMPARE:-${CARGO_TARGET_DIR:-$PWD/target}/debug/wireprobe-compare}"
if printf '%s\n' "${directions[@]}" | grep -qx read; then
    cargo build -q -p zerodds-wire-probe --bin wireprobe-compare 2>&1 | head -20
    [ -x "$compare" ] || {
        echo "$(basename "$0"): $compare is not there; nothing would be measured" >&2
        exit 6
    }
fi
export WIREPROBE_COMPARE="$compare"

# The case list once, so the cells below all measure the same
# denominator. `--cases` is the comma-separated subset a re-measurement
# takes, in the shape `matrix/gen-*.sh` and `collect-generated` use.
selected="$work/cases.txt"
if [ -n "$cases" ]; then
    printf '%s\n' "$cases" | tr ',' '\n' | sed '/^$/d' > "$selected"
else
    find tests/interop-corpus -mindepth 1 -maxdepth 1 -type d -exec basename {} \; \
        | sort > "$selected"
fi

status=0
for encoding in "${encodings[@]}"; do
for endian in "${endians[@]}"; do
for direction in "${directions[@]}"; do
  # One line per case out of `--one`, tallied here; the detail goes
  # straight into the log through the shared standard error.
  tally="$(sed "s|^|--one $encoding $endian $direction |" "$selected" \
      | xargs -P "$jobs" -n 5 "$(pwd)/${BASH_SOURCE[0]#./}" 2>>"$L" \
      | sort | uniq -c)"
  count() { printf '%s\n' "$tally" | awk -v w="$1" '$2 == w { print $1 }'; }
  ok=$(count MATCH); bad=$(count DIFFER)
  refused=$(count REFUSED); noref=$(count NOREF)
  printf '%s.%s  %-5s MATCH=%d DIFFER=%d REFUSED=%d NOREF=%d\n' \
      "$encoding" "$endian" "$direction" \
      "${ok:-0}" "${bad:-0}" "${refused:-0}" "${noref:-0}"
  [ "${bad:-0}" -eq 0 ] || status=1
done
done
done
echo "per case: $L" >&2
exit "$status"
