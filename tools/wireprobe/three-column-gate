#
# three-column-gate — the C and Python columns of the interop corpus, whole,
# for tools/interop-results.
#
#   tools/wireprobe/three-column-gate --full
#
# Runs the two matrix drivers over every case in every configuration and
# writes their answers where tools/interop-results reads them:
#
#   target/three-column-c-full.json    wireprobe-c-matrix
#   target/three-column-python.json    wireprobe-python-matrix
#
# It compares nothing. Each column holds its own octets against
# tests/interop-corpus/expected-bytes.tsv in its own crate
# (tools/wireprobe/wireprobe-zerodds-{c,python}-gen/tests/expected_bytes.rs,
# decision 3 of internal/release/rc8-test-suite.md); the test that compared
# the three columns with each other is gone with that. The name stays
# because the interop-results tree records it as the producer of the two
# columns.
#
# The C driver keeps compiled probes in target/wireprobe-c-cache, so a run
# after the first builds only the probes that are not there. `--full` is
# accepted for the callers that pass it; there is no other tier.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/../.." && pwd)"

while [ $# -gt 0 ]; do
    case "$1" in
        --full) shift ;;
        --help|-h) sed -n '5,26p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "three-column-gate: \`$1\` is not an option" >&2; exit 2 ;;
    esac
done

target="${CARGO_TARGET_DIR:-$root/target}"
echo "three-column-gate: building the C and Python matrix drivers" >&2
cargo build -q --manifest-path "$root/Cargo.toml" --release \
    -p zerodds-wireprobe-c-gen --bin wireprobe-c-matrix
cargo build -q --manifest-path "$root/Cargo.toml" --release \
    -p zerodds-wireprobe-python-gen --bin wireprobe-python-matrix

mkdir -p "$root/target"
"$target/release/wireprobe-c-matrix" --out "$root/target/three-column-c-full.json" \
    --cache "$root/target/wireprobe-c-cache"
"$target/release/wireprobe-python-matrix" --out "$root/target/three-column-python.json"
