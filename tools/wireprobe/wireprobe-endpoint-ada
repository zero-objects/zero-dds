#
# wireprobe-endpoint-ada — one IDL type and one JSON sample, through the
# hand-written endpoint SDK in endpoints/ada.
#
# The same command line as every other column's probe, so a case runs
# through any of them by substituting the program name:
#
#   wireprobe-endpoint-ada --idl robot.idl --type common::Robot \
#       --values robot.json --encoding plain-cdr2 --endian le \
#       --out robot.endpoint-ada.plain-cdr2.le.bin
#
# The body is tools/wireprobe/endpoint-common.sh; it is shared because
# the six differ only in which compiler runs and which SDK is linked,
# and six copies of the caching and the exit codes would be six places
# for them to drift apart.
set -uo pipefail
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/endpoint-common.sh"
endpoint_probe ada "$@"
