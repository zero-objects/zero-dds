#!/bin/bash
# wireprobe-zerodds-lua — one IDL type and one JSON value, through the
# ZeroDDS Lua binding built by the shared codec walk.
#
# The same command line as `wireprobe-zerodds`, so a case runs through
# both by substituting the program name. See
# `docs/specs/zerodds-interop-suite-1.0.md` §3a.
#
#   wireprobe-zerodds-lua --idl robot.idl --type common::Robot \
#                         --values robot.json --encoding xcdr2 \
#                         --endian le --out robot.zerodds-lua.xcdr2.le.bin
#
#   wireprobe-zerodds-lua --idl robot.idl --type common::Robot \
#                         --in robot.cyclone.xcdr2.le.bin \
#                         --encoding xcdr2 --endian le \
#                         --values-out robot.read.json
#
# ## What is shared with the Rust probe and what is not
#
# Shared: the frontend, the common AST and the layout plan. Which
# members are written, in what order, with which header and which
# length code is `zerodds-ast-layout`'s answer, and a second answer
# would be a second place for the wire format to live.
#
# Not shared: the serialiser. The generated chunk calls
# `runtime/lua/zerodds_wire`, which implements DDS-XTypes 1.3 §7.4 in
# plain Lua — `string.pack` and 64-bit integers, no C module and no
# FFI: a probe that reached the Rust runtime through FFI would be
# byte-identical by construction and would prove nothing about whether
# the two read the specification the same way.
#
# ## The interpreter
#
# The target is Lua 5.4. `$LUA` names the interpreter outright;
# otherwise `lua5.4` is taken where it exists and `lua` after it, which
# on a host carrying 5.5 runs the chunk under 5.5 — the constructs used
# are common to both, and the runtime's own comments say which
# measurements were taken under which. No interpreter at all is exit 6:
# a tool this column needs is not installed, which is a gap and not a
# refusal.
#
# ## The exit codes
#
# `docs/specs/zerodds-verdicts-1.0.md`, structural rather than read out
# of a message:
#
#   0  it carried the case
#   1  the sample is outside the type — `runtime/lua` refuses at the
#      octet, and the Rust probe answers 1 for the same sample
#   2  the command line
#   3  no-form (`adapter/lua.rs` refused the construct by name), or a
#      DISCARDED sample on the read side — both the Rust probe's 3
#   6  harness-gap — a tool of ours has not written it: the generator
#      did not build, the walk stopped, or no interpreter is installed
#   7  generator-defect — the generator accepted the case and the Lua
#      it produced is not a chunk (`lua`'s own compiler refuses it)
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/../.." && pwd)"
runtime="${ZERODDS_LUA_RUNTIME:-$root/runtime/lua}"

LUA="${LUA:-}"
if [ -z "$LUA" ]; then
    if command -v lua5.4 >/dev/null 2>&1; then
        LUA=lua5.4
    elif command -v lua >/dev/null 2>&1; then
        LUA=lua
    else
        echo "wireprobe-zerodds-lua: no lua interpreter on the path (set \$LUA)" >&2
        exit 9
    fi
fi

gen="${WIREPROBE_LUA_GEN:-}"
if [ -z "$gen" ]; then
    gen="${CARGO_TARGET_DIR:-$root/target}/debug/wireprobe-zerodds-lua-gen"
    # Built when it is missing *or stale*: a generator older than the
    # sources it came from measures the previous build.
    . "$here/generator.sh"
    probe_generator zerodds-wireprobe-lua-gen "$gen" "$root" || exit 6
fi

out=""
values_out=""
argv=()
idl=""
reading=0
while [ $# -gt 0 ]; do
    case "$1" in
        --out) out="$2"; shift 2 ;;
        --values-out) values_out="$2"; argv+=("$1" "$2"); shift 2 ;;
        --in) reading=1; argv+=("$1" "$2"); shift 2 ;;
        --idl|--type|--values|--encoding|--endian|--emit|--dialect)
            if [ "$1" = --idl ]; then idl="$2"; fi
            argv+=("$1" "$2"); shift 2 ;;
        --help|-h) sed -n '2,57p' "${BASH_SOURCE[0]}"; exit 0 ;;
        *) echo "wireprobe-zerodds-lua: \`$1\` is not an option" >&2; exit 2 ;;
    esac
done

. "$here/diagnostics.sh"

work="$(mktemp -d)"
trap 'probe_keep_generated "$work" "zerodds-lua" "$idl" probe.lua; rm -rf "$work"' EXIT

# The generator's own code passes straight through: 3 is "Lua has no
# form for it" and 6 is "a tool of ours stopped".
code=0
"$gen" "${argv[@]}" --out-dir "$work" || code=$?
[ "$code" = 0 ] || exit "$code"

# The syntax is checked before the chunk is run, because the two
# failures are different verdicts and running the chunk conflates them.
# `load` compiles without executing, so a generator that emitted a
# near-program is 7 here rather than "the probe did not run" (6) —
# the distinction every compiled column gets from its compiler.
# The path is embedded rather than passed as an argument: `lua -e`
# followed by a positional file *runs* the file, which is exactly the
# conflation this gate exists to avoid. `mktemp` paths carry no quote.
if ! "$LUA" -e "assert(loadfile('$work/probe.lua'))" \
        > "$work/syntax.log" 2>&1; then
    echo "wireprobe-zerodds-lua: the generated Lua is not a chunk" >&2
    head -10 "$work/syntax.log" >&2 || true
    probe_diagnostics_after "zerodds-lua" "$work" "$idl" 7
    exit 7
fi
probe_diagnostics_after "zerodds-lua" "$work" "$idl" 0

export LUA_PATH="$runtime/?.lua;$runtime/?/init.lua;;"

code=0
"$LUA" "$work/probe.lua" > "$work/bytes.bin" 2> "$work/run.log" || code=$?
if [ "$code" != 0 ]; then
    head -5 "$work/run.log" >&2 || true
    [ "$code" = 1 ] && exit 1
    [ "$code" = 3 ] && exit 3
    echo "wireprobe-zerodds-lua: the probe did not run" >&2
    exit 6
fi

# The read direction writes its JSON where `--values-out` said and puts
# nothing on stdout, so there are no octets to hand back.
if [ "$reading" = 1 ]; then
    [ -n "$values_out" ] || {
        echo "wireprobe-zerodds-lua: --in without --values-out" >&2
        exit 2
    }
    exit 0
fi

if [ -n "$out" ]; then
    cp "$work/bytes.bin" "$out"
else
    od -An -tx1 -v "$work/bytes.bin" | tr -d ' \n'; echo
fi
