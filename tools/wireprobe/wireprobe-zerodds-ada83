#!/bin/bash
# wireprobe-zerodds-ada83 — one IDL type and one JSON value, through the
# ZeroDDS Ada 83 binding built by the shared codec walk.
#
# The same command line as `wireprobe-zerodds`, so a case runs through
# both by substituting the program name. See
# `docs/specs/zerodds-interop-suite-1.0.md` §3a.
#
#   wireprobe-zerodds-ada83 --idl robot.idl --type common::Robot \
#                           --values robot.json --encoding xcdr2 \
#                           --endian le --out robot.zerodds-ada83.xcdr2.le.bin
#
#   wireprobe-zerodds-ada83 --idl robot.idl --type common::Robot \
#                           --in robot.cyclone.xcdr2.le.bin \
#                           --encoding xcdr2 --endian le \
#                           --values-out robot.read.json
#
# ## What is shared with the Rust probe and what is not
#
# Shared: the frontend, the common AST and the layout plan — the same
# division `wireprobe-zerodds-ada` documents.
#
# Not shared: the serialiser. The generated program is compiled together
# with `runtime/ada-83/src/zd_wire83.adb`, which implements DDS-XTypes
# 1.3 §7.4 a further time, over strict Ada 83.
#
# ## The toolchain
#
# GNAT, through `gnatmake` (preferred) or `gprbuild`; `alr` counts only
# as a way to put one of the two on the path. Strict Ada 83
# (`-gnat83`) — a probe built under any later `-gnat` mode is not this
# column's answer, and this is checked at every build below.
#
# ## Why this driver differs from `wireprobe-zerodds-ada`'s
#
# Ada 83 has no `Ada.Command_Line` and nothing this harness can stream
# stdout through, so the generated program neither reads `argv` nor
# writes its octets to standard output: `--bytes-out` bakes the write
# direction's output path into the generated source at generation
# time, exactly as `--values-out` already does for the read direction,
# and this driver reads the file back afterwards rather than
# redirecting the probe's own stdout.
#
# ## The runtime is compiled once, not once per case
#
# The same cache `wireprobe-zerodds-ada` keeps, keyed on the content of
# `zd_wire83.ads`/`zd_wire83.adb` and the switches they are compiled
# with — a stale hit is impossible by construction, not by a check.
# `ZERODDS_ADA83_OBJ` names the directory; unset, it is
# `$TMPDIR/zd-ada83-runtime`. `ZERODDS_ADA83_NO_OBJ_CACHE=1` turns it
# off.
#
# ## The exit codes
#
# `docs/specs/zerodds-verdicts-1.0.md`, and structural rather than read
# out of a message:
#
#   0  it carried the case
#   1  refused — the sample is outside the type or the stream is
#      malformed (a run-time refusal, in `Zd_Wire83`'s own exceptions),
#      or the specification itself does not admit the model: a member
#      whose type closes a cycle through an array rather than through a
#      sequence, a map or `@optional` (IDL 4.2 §7.4.1.4.4.4.4) is
#      caught by the generator before it runs the materialiser, through
#      the same layout-planner check every column's codec generation
#      goes through
#   2  the command line
#   3  no-form — Ada 83 has no form for the construct, which is
#      `adapter/ada83.rs`'s answer and nobody else's — or the reader
#      discarded the sample under try-construct DISCARD, which is not
#      a failed decode either
#   6  harness-gap — a tool of ours has not written it: the generator
#      did not build, the walk stopped, or the toolchain is missing
#   7  generator-defect — the generator accepted the case and the Ada
#      it produced does not compile
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/../.." && pwd)"
runtime="${ZERODDS_ADA83_RUNTIME:-$root/runtime/ada-83}"

switches=(-gnat83 -O1)

# The directory holding the runtime's objects for these sources and
# these switches, built if it is not there yet. Prints the path, or
# nothing when the cache is off or the runtime does not compile.
runtime_objects() {
    [ -z "${ZERODDS_ADA83_NO_OBJ_CACHE:-}" ] || return 0
    command -v sha256sum >/dev/null 2>&1 || return 0
    local key store dir build
    key=$({
        printf '%s\0' "${switches[@]}"
        cat "$runtime/src/zd_wire83.ads" "$runtime/src/zd_wire83.adb"
    } | sha256sum | cut -c1-40) || return 0
    store="${ZERODDS_ADA83_OBJ:-${TMPDIR:-/tmp}/zd-ada83-runtime}"
    dir="$store/$key"
    [ -f "$dir/zd_wire83.ali" ] && { printf '%s' "$dir"; return 0; }
    mkdir -p "$store" || return 0
    build="$(mktemp -d "$store/build.XXXXXX")" || return 0
    if gnatmake -q -c "${switches[@]}" -D "$build" -I"$runtime/src" \
            "$runtime/src/zd_wire83.adb" >/dev/null 2>&1; then
        mv "$build" "$dir" 2>/dev/null || rm -rf "$build"
        [ -f "$dir/zd_wire83.ali" ] && printf '%s' "$dir"
    else
        rm -rf "$build"
    fi
    return 0
}

if command -v gnatmake >/dev/null 2>&1; then
    objects="$(runtime_objects)"
    build_probe() {
        local reuse=()
        [ -n "$objects" ] && reuse=(-aO"$objects")
        (cd "$1" && gnatmake -q "${switches[@]}" "${reuse[@]}" \
             -I"$runtime/src" zd83_probe.adb -o probe)
    }
elif command -v gprbuild >/dev/null 2>&1; then
    build_probe() {
        cat > "$1/zd83_probe.gpr" <<EOF
project Zd83_Probe is
   for Source_Dirs use (".", "$runtime/src");
   for Object_Dir use ".";
   for Main use ("zd83_probe.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat83", "-O1");
   end Compiler;
   package Builder is
      for Executable ("zd83_probe.adb") use "probe";
   end Builder;
end Zd83_Probe;
EOF
        (cd "$1" && gprbuild -q -P zd83_probe.gpr)
    }
else
    echo "wireprobe-zerodds-ada83: neither \`gnatmake\` nor \`gprbuild\` is on the path; the Ada 83 column is unmeasured here" >&2
    exit 9
fi

gen="${WIREPROBE_ADA83_GEN:-}"
if [ -z "$gen" ]; then
    gen="${CARGO_TARGET_DIR:-$root/target}/debug/wireprobe-zerodds-ada83-gen"
    . "$here/generator.sh"
    probe_generator zerodds-wireprobe-ada83-gen "$gen" "$root" || exit 6
fi

out=""
values_out=""
argv=()
idl=""
reading=0
while [ $# -gt 0 ]; do
    case "$1" in
        --out) out="$2"; shift 2 ;;
        --values-out) values_out="$2"; argv+=("$1" "$2"); shift 2 ;;
        --in) reading=1; argv+=("$1" "$2"); shift 2 ;;
        --idl|--type|--values|--encoding|--endian|--emit|--dialect)
            if [ "$1" = --idl ]; then idl="$2"; fi
            argv+=("$1" "$2"); shift 2 ;;
        --help|-h) sed -n '2,66p' "${BASH_SOURCE[0]}"; exit 0 ;;
        *) echo "wireprobe-zerodds-ada83: \`$1\` is not an option" >&2; exit 2 ;;
    esac
done

. "$here/diagnostics.sh"

work="$(mktemp -d)"
trap 'probe_keep_generated "$work" "zerodds-ada83" "$idl" zd83_probe.adb; rm -rf "$work"' EXIT

if [ "$reading" = 0 ]; then
    argv+=(--bytes-out "$work/bytes.bin")
fi

# The generator's own code passes straight through: 3 is "Ada 83 has
# no form for it" and 6 is "a tool of ours stopped".
code=0
"$gen" "${argv[@]}" --out-dir "$work" || code=$?
[ "$code" = 0 ] || exit "$code"

# GNAT is the syntax and type check in one: a generated file that is
# not Ada is the generator's defect, exit 7. The runtime is compiled
# beside the probe rather than linked from anywhere.
if ! build_probe "$work" > "$work/build.log" 2>&1; then
    echo "wireprobe-zerodds-ada83: the generated Ada does not compile" >&2
    head -20 "$work/build.log" >&2 || true
    probe_diagnostics_after "zerodds-ada83" "$work" "$idl" 7
    exit 7
fi
probe_diagnostics_after "zerodds-ada83" "$work" "$idl" 0

code=0
(cd "$work" && ./probe) > "$work/run.log" 2>&1 || code=$?
if [ "$code" != 0 ]; then
    head -5 "$work/run.log" >&2 || true
    [ "$code" = 1 ] && exit 1
    [ "$code" = 3 ] && exit 3
    echo "wireprobe-zerodds-ada83: the probe did not run" >&2
    exit 6
fi

# The read direction writes its JSON where `--values-out` said and
# leaves nothing to hand back.
if [ "$reading" = 1 ]; then
    [ -n "$values_out" ] || {
        echo "wireprobe-zerodds-ada83: --in without --values-out" >&2
        exit 2
    }
    exit 0
fi

# The write direction wrote its octets to the path this driver named
# through `--bytes-out`, because the probe has nothing to stream
# stdout through.
if [ ! -f "$work/bytes.bin" ]; then
    echo "wireprobe-zerodds-ada83: the probe reported success but wrote no bytes" >&2
    exit 6
fi
if [ -n "$out" ]; then
    cp "$work/bytes.bin" "$out"
else
    od -An -tx1 -v "$work/bytes.bin" | tr -d ' \n'; echo
fi
