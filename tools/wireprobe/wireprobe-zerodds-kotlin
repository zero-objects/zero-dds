#!/bin/bash
# wireprobe-zerodds-kotlin — one IDL type and one JSON value, through the
# ZeroDDS Kotlin binding built by the shared codec walk.
#
# The same command line as `wireprobe-zerodds`, so a case runs through
# both by substituting the program name. See
# `docs/specs/zerodds-interop-suite-1.0.md` §3a.
#
#   wireprobe-zerodds-kotlin --idl robot.idl --type common::Robot \
#                            --values robot.json --encoding xcdr2 \
#                            --endian le --out robot.zerodds-kotlin.xcdr2.le.bin
#
#   wireprobe-zerodds-kotlin --idl robot.idl --type common::Robot \
#                            --in robot.cyclone.xcdr2.le.bin \
#                            --encoding xcdr2 --endian le \
#                            --values-out robot.read.json
#
# ## What is shared with the Rust probe and what is not
#
# Shared: the frontend, the common AST and the layout plan. Which
# members are written, in what order, with which header and which length
# code is `zerodds-ast-layout`'s answer, and a second answer would be a
# second place for the wire format to live.
#
# Not shared: the serialiser. The generated program is compiled together
# with `runtime/kotlin/ZdWire.kt`, which implements DDS-XTypes 1.3 §7.4 a
# further time in Kotlin. Nothing here reaches the Rust runtime through
# FFI: a probe that did would be byte-identical by construction and
# would prove nothing about whether the two read the specification the
# same way.
#
# ## The exit codes
#
# `docs/specs/zerodds-verdicts-1.0.md`, and structural rather than read
# out of a message:
#
#   0    it carried the case
#   1    refused — it was asked and said no. A sample outside the type —
#        `primitive-char-above-latin1` is a `char` holding U+0161 and
#        §7.2.2.2.1.2.2 says a CHAR_8_TYPE "shall be representable using
#        8 bits" — is refused at run time in `checkedChar`, in
#        `runtime/kotlin/ZdWire.kt`, and that is the runtime's refusal
#        and not a gap. A model IDL 4.2 does not admit —
#        `recursive-array` is one — is refused by `zerodds-ast-layout`
#        before any Kotlin is written. The Rust probe answers 1 for
#        both.
#   2    the command line — not a measurement; the collection stops
#   3    no-form — Kotlin has no form for the construct, which is
#        `adapter/kotlin.rs`'s answer and nobody else's
#   6    harness-gap — a tool of ours has not written it: the generator
#        did not build, or the shared walk has no writer or reader for a
#        construct
#   7    generator-defect — the generator accepted the case and the
#        Kotlin it produced does not compile
#   9    toolchain-absent — this host has no `kotlinc`; not a
#        measurement, the collection stops
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/../.." && pwd)"
runtime="${ZERODDS_KOTLIN_RUNTIME:-$root/runtime/kotlin}"
KOTLINC="${KOTLINC:-kotlinc}"
# `-Werror` for the reason the C column compiles with it: a generated
# file that warns is one whose warnings stop being read. Kotlin flags a
# redundant numeric conversion the same way `javac -Xlint:cast` flags a
# redundant cast, and `crates/lang-rules/src/emit/kotlin.rs` writes
# exactly one conversion at every site this column reaches for the same
# reason C writes none where none is needed.
KOTLINCFLAGS="${KOTLINCFLAGS:--Werror}"

if ! "$KOTLINC" -version >/dev/null 2>&1; then
    echo "wireprobe-zerodds-kotlin: \`$KOTLINC\` is not on the path; the Kotlin column is unmeasured here" >&2
    exit 9
fi

gen="${WIREPROBE_KOTLIN_GEN:-}"
if [ -z "$gen" ]; then
    gen="${CARGO_TARGET_DIR:-$root/target}/debug/wireprobe-zerodds-kotlin-gen"
    # Built when it is missing *or stale*: a generator older than the
    # sources it came from measures the previous build.
    . "$here/generator.sh"
    probe_generator zerodds-wireprobe-kotlin-gen "$gen" "$root" || exit 6
fi

out=""
values_out=""
argv=()
idl=""
reading=0
while [ $# -gt 0 ]; do
    case "$1" in
        --out) out="$2"; shift 2 ;;
        --values-out) values_out="$2"; argv+=("$1" "$2"); shift 2 ;;
        --in) reading=1; argv+=("$1" "$2"); shift 2 ;;
        --idl|--type|--values|--encoding|--endian|--emit|--dialect)
            if [ "$1" = --idl ]; then idl="$2"; fi
            argv+=("$1" "$2"); shift 2 ;;
        --help|-h) sed -n '2,58p' "${BASH_SOURCE[0]}"; exit 0 ;;
        *) echo "wireprobe-zerodds-kotlin: \`$1\` is not an option" >&2; exit 2 ;;
    esac
done

. "$here/diagnostics.sh"
. "$here/probe-cache.sh"

work="$(mktemp -d)"
trap 'probe_keep_generated "$work" "zerodds-kotlin" "$idl" ZdTypes.kt; rm -rf "$work"' EXIT

# The generator's own code passes straight through: 3 is "Kotlin has no
# form for it" and 6 is "a tool of ours stopped", and folding the two
# into one here would lose the distinction the ledger turns on.
code=0
"$gen" "${argv[@]}" --out-dir "$work" || code=$?
[ "$code" = 0 ] || exit "$code"

# The runtime module is compiled beside the probe rather than published
# separately; `import zerodds.wire.*` resolves against the copy beside
# `ZdTypes.kt`.
cp "$runtime/ZdWire.kt" "$work/ZdWire.kt"

# A binary already built from exactly these inputs is reused: the key is
# the *content* of the generated program and of the runtime it is
# compiled with, plus the compiler that did it. Off unless
# WIREPROBE_CACHE names a directory, as in the sibling drivers.
kotlinc_version="$("$KOTLINC" -version 2>&1)"
cache_key="$(probe_cache_key zerodds-kotlin "$kotlinc_version" -- \
    "$work/ZdTypes.kt" "$work/ZdWire.kt")"
cache_dir="$(probe_cache_dir "$cache_key")"
if [ -n "$cache_dir" ] && [ -f "$cache_dir/probe.jar" ]; then
    cp "$cache_dir/probe.jar" "$work/probe.jar"
else
    # The Kotlin compiler is the syntax and type check in one: a
    # generated file that is not Kotlin, or that names something the
    # runtime does not have, is the generator's defect, exit 7, which
    # every compiled column reports the same way.
    if ! "$KOTLINC" $KOTLINCFLAGS "$work/ZdTypes.kt" "$work/ZdWire.kt" \
            -include-runtime -d "$work/probe.jar" > "$work/build.log" 2>&1; then
        echo "wireprobe-zerodds-kotlin: the generated Kotlin does not compile" >&2
        head -20 "$work/build.log" >&2 || true
        probe_diagnostics_after "zerodds-kotlin" "$work" "$idl" 7
        exit 7
    fi
    if [ -n "$cache_dir" ]; then
        publish="$(mktemp -d)"
        cp "$work/probe.jar" "$publish/probe.jar"
        probe_cache_publish "$publish" "$cache_dir"
    fi
fi
probe_diagnostics_after "zerodds-kotlin" "$work" "$idl" 0

code=0
# The JVM writes its own warnings to stdout unless told otherwise, and
# stdout is the sample here. Measured in the matrix refresh of 2026-10-01:
# `[0.022s][warning][perf,memops] Cannot use file /tmp/hsperfdata_root/...
# because it is locked by another process` became the first 133 octets of
# zerodds-java/omniorb-xcdr1-le/bitmask-bitbound-8, and the read refused
# them. -XX:-UsePerfData drops the hsperfdata file that warning is about;
# -Xlog:disable -Xlog:all=warning:stderr sends any other JVM warning to
# stderr, away from the octets.
JVM_FLAGS=(-XX:-UsePerfData -Xlog:disable -Xlog:all=warning:stderr)
java "${JVM_FLAGS[@]}" -jar "$work/probe.jar" > "$work/bytes.bin" 2> "$work/run.log" || code=$?
if [ "$code" != 0 ]; then
    head -5 "$work/run.log" >&2 || true
    [ "$code" = 1 ] && exit 1
    [ "$code" = 3 ] && exit 3
    echo "wireprobe-zerodds-kotlin: the probe did not run" >&2
    exit 6
fi

# The read direction writes its JSON where `--values-out` said and puts
# nothing on stdout, so there are no octets to hand back.
if [ "$reading" = 1 ]; then
    [ -n "$values_out" ] || {
        echo "wireprobe-zerodds-kotlin: --in without --values-out" >&2
        exit 2
    }
    exit 0
fi

if [ -n "$out" ]; then
    cp "$work/bytes.bin" "$out"
else
    od -An -tx1 -v "$work/bytes.bin" | tr -d ' \n'; echo
fi
