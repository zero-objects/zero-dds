emit_ocaml() {
    local call="$1" argument="$2" suffix=""
    # `put_u64` takes an `Int64`, whose literal carries an `L`.
    [ "$call" = put_u64 ] && suffix=L
    mkdir -p "$work/ocaml"
    cp "$root/endpoints/ocaml/zerodds.ml" "$work/ocaml/"
    # The run-time refusal is caught as well as the compile-time one. OCaml
    # answered every one of these questions at compile time until its integer
    # writes grew a range check, and an uncaught `Invalid_argument` prints
    # `Fatal error: exception …` — which is a refusal wearing the wrong
    # words, and the one string this table must never have to be read past.
    cat > "$work/ocaml/probe.ml" <<EOF
let () =
  match
    let w = Zerodds.Wire.writer Zerodds.Wire.LE Zerodds.Wire.XCDR2 in
    Zerodds.Wire.$call w ($argument$suffix);
    Zerodds.Wire.bytes w
  with
  | out ->
    Bytes.iter (fun c -> Printf.printf "%02x" (Char.code c)) out;
    print_newline ()
  | exception Invalid_argument reason -> print_endline ("REFUSED " ^ reason)
EOF
    if ! (cd "$work/ocaml" && ocamlfind ocamlopt -thread -package threads.posix \
            -linkpkg zerodds.ml probe.ml -o probe) > "$work/ocaml/build.log" 2>&1; then
        echo "REFUSED $(grep -m1 -E 'Error|error' "$work/ocaml/build.log" | cut -c1-120)"
        return
    fi
    "$work/ocaml/probe" 2>&1 | tail -1
}

emit_elixir() {
    local call="$1" argument="$2"
    elixir -e "
Code.require_file(\"$root/endpoints/elixir/lib/zerodds.ex\")
w = ZeroDDS.Wire.writer(:little, :xcdr2)
try do
  w = ZeroDDS.Wire.$call(w, $argument)
  IO.puts(Base.encode16(ZeroDDS.Wire.bytes(w), case: :lower))
rescue
  e -> IO.puts(\"REFUSED \" <> Exception.message(e))
end" 2>&1 | tail -1
}


# --- the ten the fold brought with it ---------------------------------
#
# Same contract: print the octets in hexadecimal, or `REFUSED <reason>`,
# and nothing else. Four of these refuse at compile time, because their
# parameter is the wire width itself and the argument is a literal
# outside it; that is the answer and it is reported as one.

emit_zig() {
    local call="$1" argument="$2" put
    case "$call" in
        put_u8) put=putU8 ;; put_u16) put=putU16 ;;
        put_u32) put=putU32 ;; put_u64) put=putU64 ;;
    esac
    mkdir -p "$work/zig"
    # The whole module directory: `zerodds.zig` imports `reliable.zig`.
    cp "$root"/endpoints/zig/src/*.zig "$work/zig/"
    cat > "$work/zig/probe.zig" <<EOF
const std = @import("std");
const zd = @import("zerodds.zig");
pub fn main(zd_init: std.process.Init) !void {
    // xcdr2: this probe writes one scalar from a freshly made writer, so
    // MAXALIGN never applies before the first octet -- the choice cannot
    // change the answer -- and xcdr2 is what refusal-edge-surface's zig
    // probes use for the same put_* calls.
    var w = zd.Writer.init(zd_init.arena.allocator(), .little, .xcdr2);
    defer w.deinit();
    try w.$put($argument);
    var stdout_buf: [256]u8 = undefined;
    var stdout_file = std.Io.File.stdout().writer(zd_init.io, &stdout_buf);
    const out = &stdout_file.interface;
    defer out.flush() catch {};
    for (w.bytes()) |b| try out.print("{x:0>2}", .{b});
    try out.print("\n", .{});
}
EOF
    if ! (cd "$work/zig" && "${ZIG:-zig}" build-exe \
            --global-cache-dir "${ZIG_GLOBAL_CACHE_DIR:-${TMPDIR:-/tmp}/zd-zig-cache}" \
            -femit-bin=probe probe.zig) > "$work/zig/build.log" 2>&1; then
        echo "REFUSED $(grep -m1 -E 'error' "$work/zig/build.log" | cut -c1-120)"
        return
    fi
    "$work/zig/probe" 2>&1 | tail -1
}

