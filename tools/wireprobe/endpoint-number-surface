emit_kotlin() {
    local call="$1" argument="$2" put suffix=""
    case "$call" in
        put_u8) put=putU8 ;; put_u16) put=putU16 ;;
        # `putU32` and `putU64` both take a Long.
        put_u32) put=putU32; suffix=L ;; put_u64) put=putU64; suffix=L ;;
    esac
    local kotlinc="${KOTLINC:-kotlinc}" stdlib
    stdlib="${KOTLIN_STDLIB:-$(dirname "$(dirname "$(readlink -f \
        "$(command -v "$kotlinc")")")")/lib/kotlin-stdlib.jar}"
    mkdir -p "$work/kotlin"
    cp "$root/endpoints/kotlin/src/Zerodds.kt" "$work/kotlin/"
    cat > "$work/kotlin/Probe.kt" <<EOF
import zerodds.Encoding
import zerodds.Endian
import zerodds.Writer
fun main() {
    val w = Writer(Endian.LITTLE, Encoding.XCDR2)
    w.$put($argument$suffix)
    println(w.bytes().joinToString("") { "%02x".format(it) })
}
EOF
    if ! (cd "$work/kotlin" && "$kotlinc" -Werror -d classes Zerodds.kt Probe.kt) \
            > "$work/kotlin/build.log" 2>&1; then
