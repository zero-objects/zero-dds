        return
    fi
    if ! "${JAVA:-java}" -cp "$work/kotlin/classes:$stdlib" ProbeKt \
            > "$work/kotlin/out" 2>&1; then
        echo "REFUSED $(head -1 "$work/kotlin/out" | cut -c1-120)"
        return
    fi
    tail -1 "$work/kotlin/out"
}

emit_node() {
    local call="$1" argument="$2" put suffix=""
    case "$call" in
        put_u8) put=putU8 ;; put_u16) put=putU16 ;;
        put_u32) put=putU32 ;;
        # `putU64` takes a BigInt; the SDK says why (a JavaScript number
        # loses precision above 2^53).
        put_u64) put=putU64; suffix=n ;;
    esac
    "${NODE:-node}" --throw-deprecation -e "
const zd = require('$root/endpoints/node/zerodds.js');
const w = new zd.Writer(zd.LITTLE, zd.XCDR2);
try {
  w.$put($argument$suffix);
  console.log(Buffer.from(w.bytes()).toString('hex'));
} catch (e) {
  console.log('REFUSED ' + e.message);
}" 2>&1 | tail -1
}

emit_fsharp() {
    local call="$1" argument="$2" put suffix=""
    case "$call" in
        put_u8) put=PutU8 ;; put_u16) put=PutU16 ;;
        put_u32) put=PutU32; suffix=u ;; put_u64) put=PutU64; suffix=UL ;;
    esac
    # `-1234567u` is not a literal in F#: the suffix makes it unsigned and
    # the minus is then applied to an unsigned value. Dropped for a
    # negative argument, so what the compiler sees is the `int` a caller
    # would actually write and the refusal below is the binding's.
    case "$argument" in -*) suffix="" ;; esac
    mkdir -p "$work/fsharp"
    cp "$root/endpoints/fsharp/zerodds.fs" "$work/fsharp/"
    cat > "$work/fsharp/probe.fsx" <<EOF
#load "zerodds.fs"
open ZeroDDS
try
    let w = Writer(LE, XCDR2)
    w.$put($argument$suffix)
    printfn "%s" (w.Bytes() |> Array.map (sprintf "%02x") |> String.concat "")
with e -> printfn "REFUSED %s" e.Message
EOF
    if ! (cd "$work/fsharp" && DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1 \
            "${DOTNET:-dotnet}" fsi --nologo --warnaserror+ probe.fsx) \
            > "$work/fsharp/out" 2>&1; then
        echo "REFUSED $(grep -m1 -E 'error' "$work/fsharp/out" | cut -c1-120)"
        return
    fi
    tail -1 "$work/fsharp/out"
}

