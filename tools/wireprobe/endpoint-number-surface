# The three Ada bindings share one shape: a `probe.adb` that writes into
# the binding's own writer and prints the octets. They differ in which
# package it is and how a 64-bit value is spelled, which is the whole of
# what the case statements below carry.
emit_ada() {
    local call="$1" argument="$2" put ctype
    # The C type of that parameter, and only that one: `-gnatwae` makes an
    # idle `use type` clause an error, so naming all four would report
    # this program's warning where the binding's answer belongs.
    #
    # Put_U64 takes a two-word record, whose aggregate needs no operator,
    # so it gets no clause at all.
    local clause=""
    case "$call" in
        put_u8) put=Put_U8; ctype=unsigned_char ;;
        put_u16) put=Put_U16; ctype=unsigned ;;
        put_u32) put=Put_U32; ctype=unsigned_long ;;
        put_u64) put=Put_U64; ctype="" ;;
    esac
    # Only for a negative argument: that is the one spelling with an
    # operator in it. For 70000 the clause would be idle, and idle is an
    # error under -gnatwae.
    case "$argument" in
        -*) [ -n "$ctype" ] && clause="   use type Interfaces.C.$ctype;"$'\n' ;;
    esac
    mkdir -p "$work/ada"
    local arg="$argument"
    # `zdw_put_u64` takes a two-word record; the argument is split the way
    # `wireprobe-endpoint-gen` splits it. In Python and not in the shell:
    # bash's arithmetic is signed 64-bit, so `16045690984833335998 >> 32`
    # is a negative number there and the halves came out as
    # `bec2addeefbfaedf` — this program's arithmetic reported as the
    # binding's.
    if [ "$call" = put_u64 ]; then
        arg="(Hi => $(python3 -c "print($argument >> 32)"), \
              Lo => $(python3 -c "print($argument & 0xffffffff)"))"
    fi
    cat > "$work/ada/probe.adb" <<EOF
with Ada.Text_IO;
with Interfaces.C;
with Zdw;
procedure Probe is
   use Zdw;
   use type Interfaces.C.int;
   --  The parameter's own scalar type, so a negative or out-of-range
   --  literal has its operator directly visible and gnat reports the
   --  binding's answer instead of a visibility rule. Emitted only where
   --  there is one: -gnatwae makes an idle use clause an error, and
   --  Put_U64's parameter is a record whose aggregate needs none. No
   --  backticks in this comment either -- the heredoc is unquoted,
   --  because the call and the argument are substituted into it, and a
   --  backtick here is a command substitution the shell ran.
$clause   type Octets is array (Natural range <>) of aliased Interfaces.C.unsigned_char;
   pragma Convention (C, Octets);
   Buf  : aliased Octets (0 .. 255) := [others => 0];
   W    : aliased Zdw.Zdw_Writer;
   Digs : constant String := "0123456789abcdef";
begin
   Writer_Init (W'Access, Buf'Address, Buf'Length, ZDW_LE);
   if $put (W'Access, $arg) /= Zdw.ZDW_OK then
      Ada.Text_IO.Put_Line ("REFUSED the writer reported an error");
      return;
   end if;
   for I in 0 .. Natural (W.Len) - 1 loop
      Ada.Text_IO.Put (Digs (Natural (Buf (I)) / 16 + 1));
      Ada.Text_IO.Put (Digs (Natural (Buf (I)) mod 16 + 1));
   end loop;
   Ada.Text_IO.New_Line;
end Probe;
EOF
    if ! (cd "$work/ada" \
          && gcc -std=c89 -pedantic -Wall -Werror -O1 -c \
                -I"$root/endpoints/c/include" -o zerodds_wire.o \
                "$root/endpoints/c/src/zerodds_wire.c" \
          && gnatmake -q -gnat2022 -gnatwae -D "$work/ada" \
                -aI"$root/endpoints/ada/src" -o probe probe.adb \
                -largs "$work/ada/zerodds_wire.o") > "$work/ada/build.log" 2>&1; then
        echo "REFUSED $(grep -m1 -E 'probe\.adb:[0-9]+' "$work/ada/build.log" \
            || grep -m1 -iE 'error' "$work/ada/build.log" | cut -c1-120)"
        return
    fi
    "$work/ada/probe" 2>&1 | tail -1
}

emit_ada_83() {
    local call="$1" argument="$2" put
    case "$call" in
        put_u8) put=Put_U8 ;; put_u16) put=Put_U16 ;;
        put_u32) put=Put_U32 ;; put_u64) put=Put_U64 ;;
    esac
    local arg="$argument"
    # See `emit_ada`: the shell's arithmetic is signed and this value is
    # not.
    if [ "$call" = put_u64 ]; then
        arg="$(python3 -c "print($argument >> 32)"), $(python3 -c "print($argument & 0xffffffff)")"
    fi
    mkdir -p "$work/ada83"
    cat > "$work/ada83/probe.adb" <<EOF
with Text_IO;
with Zerodds_Ada83_Wire; use Zerodds_Ada83_Wire;
procedure Probe is
   W    : Writer;
   Digs : constant String := "0123456789abcdef";
begin
   Init (W, Little);
   $put (W, $arg);
   if W.Overflow then
      Text_IO.Put_Line ("REFUSED the writer overflowed");
      return;
   end if;
   for I in 0 .. Length (W) - 1 loop
      Text_IO.Put (Digs (Integer (W.Buf (I)) / 16 + 1));
      Text_IO.Put (Digs (Integer (W.Buf (I)) mod 16 + 1));
   end loop;
   Text_IO.New_Line;
end Probe;
EOF
    if ! (cd "$work/ada83" && gnatmake -q -gnat83 -gnatwae -D "$work/ada83" \
            -aI"$root/endpoints/ada-83/src" -o probe probe.adb) \
            > "$work/ada83/build.log" 2>&1; then
        echo "REFUSED $(grep -m1 -E 'probe\.adb:[0-9]+' "$work/ada83/build.log" \
            || grep -m1 -iE 'error' "$work/ada83/build.log" | cut -c1-120)"
        return
    fi
    # A run-time Constraint_Error is an answer and not a crash of this
    # program: `tail -1` carries the exception line out as the refusal.
    if ! "$work/ada83/probe" > "$work/ada83/out" 2>&1; then
        echo "REFUSED $(tail -1 "$work/ada83/out" | cut -c1-120)"
        return
    fi
    tail -1 "$work/ada83/out"
}

emit_ada_native() {
    local call="$1" argument="$2" put utype
    case "$call" in
        put_u8) put=Put_U8 ;; put_u16) put=Put_U16; utype=Unsigned_16 ;;
        put_u32) put=Put_U32; utype=Unsigned_32 ;; put_u64) put=Put_U64; utype=Unsigned_64 ;;
    esac
    # As in `emit_ada`: the parameter's own type made directly visible for
    # a negative argument and for nothing else. `Byte` is the package's own
    # and its operators come with the `use` below.
    # The `with` goes with it: an unreferenced unit is an error there too.
    local with_clause="" clause=""
    case "$argument" in
        -*) if [ -n "${utype:-}" ]; then
                with_clause="with Interfaces;"$'\n'
                clause="   use type Interfaces.$utype;"$'\n'
            fi ;;
    esac
    mkdir -p "$work/adanative"
    cat > "$work/adanative/probe.adb" <<EOF
with Ada.Text_IO;
${with_clause}with Zerodds_Native_Wire; use Zerodds_Native_Wire;
procedure Probe is
$clause   W    : Writer;
   Digs : constant String := "0123456789abcdef";
begin
   Init (W, Little);
   $put (W, $argument);
   declare
      Out_Bytes : constant Byte_Array := Bytes (W);
   begin
      for B of Out_Bytes loop
         Ada.Text_IO.Put (Digs (Natural (B) / 16 + 1));
         Ada.Text_IO.Put (Digs (Natural (B) mod 16 + 1));
      end loop;
   end;
   Ada.Text_IO.New_Line;
exception
   when others =>
      Ada.Text_IO.Put_Line ("REFUSED a constraint check rejected the argument");
end Probe;
EOF
    if ! (cd "$work/adanative" && gnatmake -q -gnat2022 -gnatwae -D "$work/adanative" \
            -aI"$root/endpoints/ada-native/src" -o probe probe.adb) \
            > "$work/adanative/build.log" 2>&1; then
        echo "REFUSED $(grep -m1 -E 'probe\.adb:[0-9]+' "$work/adanative/build.log" \
            || grep -m1 -iE 'error' "$work/adanative/build.log" | cut -c1-120)"
        return
    fi
    "$work/adanative/probe" 2>&1 | tail -1
}

# --- the table --------------------------------------------------------

# The control. `put_u16(1)` is `01 00` in every binding and has no
# question in it, so a program that does not answer it is this program's
# failure and not the binding's: a constructor that grew an argument, a
# renamed write, an emitter nobody wrote. Each of those printed a compiler
# message here and was read as a refusal — a table that says "refuses"
# for a binding that was never asked. A binding whose control does not
# come back as `0100` gets no row below, and the run exits 3.
broken=0
working=""
for lang in $(printf '%s' "$langs" | tr ',' ' '); do
    control=$("emit_${lang//-/_}" put_u16 1 < /dev/null 2>&1 | tr -d '\r')
    if [ "$control" = 0100 ]; then
        working="$working $lang"
    else
        broken=$((broken + 1))
        echo "endpoint-number-surface: $lang does not answer the control put_u16(1):" >&2
        echo "  ${control:0:200}" >&2
    fi
done

printf '%-12s %-10s %-22s %s\n' question call argument answer
silent=0
unread=0
while read -r name call argument; do
    [ -n "$name" ] || continue
    for lang in $working; do
        # `< /dev/null`: `go run`, `julia` and `elixir` all read
        # standard input, and without this the first of them swallows
        # the rest of the question list and the table stops after one
        # row — which looked like a loop that had finished.
        # `-` is not a character a shell function name may carry, so the
        # two hyphenated bindings map onto underscores here and nowhere
        # else.
        answer=$("emit_${lang//-/_}" "$call" "$argument" < /dev/null 2>&1 | tr -d '\r')
        printf '%-12s %-10s %-22s %-8s %s\n' \
            "$name" "$call" "$argument" "$lang" "${answer:0:110}"
        # A question whose argument does not fit the width, answered
        # with octets, is the silent one. `over-u16` is the only such
        # question here: the negatives and the value past 2⁶³ all have
        # an exact form in the width and octets are the right answer to
        # them.
        if [ "$name" = over-u16 ] && [ "${answer#REFUSED}" = "$answer" ] \
                && printf '%s' "$answer" | grep -qE '^[0-9a-f]+$'; then
            silent=$((silent + 1))
            echo "  ^ $lang wrote octets for a value that does not fit $call" >&2
        fi
        # Neither octets nor a refusal: a crash, a version banner, an
        # interpreter's last line. Not an answer, and not passed over.
        if [ "${answer#REFUSED }" = "$answer" ] \
                && ! printf '%s' "$answer" | grep -qE '^[0-9a-f]+$'; then
            unread=$((unread + 1))
            echo "  ^ $lang answered neither octets nor a refusal" >&2
        fi
    done
done <<< "$questions"

if [ "$broken" -gt 0 ] || [ "$unread" -gt 0 ]; then
    echo >&2
    echo "endpoint-number-surface: $broken binding(s) failed the control and" >&2
    echo "$unread answer(s) were neither octets nor a refusal. The table above" >&2
    echo "is not a measurement of those." >&2
    exit 3
fi

if [ "$silent" -gt 0 ]; then
    echo >&2
    echo "endpoint-number-surface: $silent of the bindings dropped the high" >&2
    echo "half of a value and returned. That is the class this tree treats" >&2
    echo "as the worst there is; the others refuse the same call." >&2
    exit 8
fi
