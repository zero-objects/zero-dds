#
# endpoint-number-surface — what each endpoint SDK does with a number
# its writer cannot hold.
#
#   tools/wireprobe/endpoint-number-surface
#   tools/wireprobe/endpoint-number-surface --langs go,lua
#
# ## The question, and why it is not the corpus's
#
# Every write these seventeen bindings export is named for an unsigned
# wire width — `put_u8`, `put_u16`, `put_u32`, `put_u64` — and the IDL
# types they carry are not all unsigned. A `short` of -12345 and an
# `unsigned long long` of 16045690984833335998 both have to reach one of
# them, and none of the seventeen converts, so the conversion is the
# caller's in all seventeen.
#
# `wireprobe-endpoint-corpus` answers the wire question and hands each
# binding the same unsigned bit pattern to keep it that way. This asks
# the other one: what happens when the argument is a number the write
# cannot hold. The corpus cannot ask it — no IDL type carries 70000 into
# an `unsigned short`, and `wireprobe-endpoint-gen` refuses a sample that
# does not fit its member before a renderer sees it — so it is asked
# directly, of the exported call.
#
# ## What counts as a finding
#
# Not "the binding refused". A `put_u16` that will not take 70000 is a
# binding that says so, and it is said in two places: at compile time
# where the parameter is the wire width itself (Go, Zig, Swift,
# Ada-native, D, Nim), and at run time where it is wider and the write
# checks the range (the other eleven).
#
# The finding is the other answer: octets. A binding that takes 70000,
# writes `70 11` and returns is one that dropped the high half of a
# value without a word, and a caller who mis-sized a member learns it
# from a peer's decoder or does not learn it. This tree calls that the
# worst class there is, so this exits non-zero when it happens, with the
# language and the octets named.
#
# The standard is not in dispute and is not the measurement: 70000 is
# not representable in sixteen bits, and -12345 in sixteen bits is
# `c7 cf` on a little-endian wire by two's complement. What is measured
# is which of the bindings says which.
set -uo pipefail

cd "$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)" || exit 2
root="$PWD"

langs="ada,ada-83,ada-native,d,elixir,fsharp,go,java,julia,kotlin,lua,nim,node,ocaml,python,swift,zig"
while [ $# -gt 0 ]; do
    case "$1" in
        --langs) langs="$2"; shift 2 ;;
        --help|-h) sed -n '5,45p' "${BASH_SOURCE[0]}"; exit 0 ;;
        *) echo "endpoint-number-surface: \`$1\` is not an option" >&2; exit 2 ;;
    esac
done

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

# One row per question. `call` is the write and `argument` the number,
# spelled the same way everywhere; where a language needs a suffix the
# emitter adds it and says why.
#
#   over-u16     70000 into sixteen bits — 0x11170, and 0x1170 of it fits
#   negative-u16 a `short` of -12345 — 0xcfc7 by two's complement
#   negative-u32 a `long` of -1234567 — 0xffed2979
#   past-2-63    an `unsigned long long` of 0xdeadbeefdeadc2be, written
#                as the decimal a caller reads off the sample
questions="over-u16 put_u16 70000
negative-u16 put_u16 -12345
negative-u32 put_u32 -1234567
past-2-63 put_u64 16045690984833335998"

# --- one program per (language, question) -----------------------------
#
# Each prints the octets in hexadecimal, or `REFUSED <reason>`, and
# nothing else. The octets go to standard output here rather than to a
# file: there is one write per program and no framing to get wrong.

emit_go() { # $1 call  $2 argument
    local call="$1" argument="$2" put
    case "$call" in
        put_u8) put=PutU8 ;; put_u16) put=PutU16 ;;
        put_u32) put=PutU32 ;; put_u64) put=PutU64 ;;
    esac
    mkdir -p "$work/go"
    cat > "$work/go/go.mod" <<EOF
module zdnumbersurface

go 1.19

require zeroddsendpoint v0.0.0

replace zeroddsendpoint => $root/endpoints/go
EOF
    cat > "$work/go/main.go" <<EOF
package main

import (
	"fmt"

	zerodds "zeroddsendpoint"
)

func main() {
	w := zerodds.NewWriter(zerodds.Little, zerodds.Xcdr2)
	w.$put($argument)
	fmt.Printf("%x\n", w.Buf)
}
EOF
    if ! (cd "$work/go" && GOFLAGS=-mod=mod GOTOOLCHAIN=local CGO_ENABLED=0 \
            GOCACHE="${ZERODDS_GO_CACHE:-${TMPDIR:-/tmp}/zd-endpoint-go-cache}" \
            go run .) > "$work/go/out" 2>&1; then
        echo "REFUSED $(grep -m1 -E 'error|cannot|overflow' "$work/go/out" | cut -c1-120)"
        return
    fi
    tail -1 "$work/go/out"
}

emit_lua() {
    local call="$1" argument="$2" put
    case "$call" in
        put_u8) put=putU8 ;; put_u16) put=putU16 ;;
        put_u32) put=putU32 ;; put_u64) put=putU64 ;;
    esac
    # `$LUA`: Debian ships no unversioned `lua` (endpoints-gate's run_lua).
    LUA_PATH="$root/endpoints/lua/?.lua;;" "${LUA:-lua}" -e "
local zd = require('zerodds')
local w = zd.Writer.new(zd.LE, zd.XCDR2)
local ok, err = pcall(function() w:$put($argument) end)
if ok then
  print((w:bytes():gsub('.', function(c) return string.format('%02x', c:byte()) end)))
else
  print('REFUSED ' .. tostring(err))
end" 2>&1 | tail -1
}

emit_julia() {
    local call="$1" argument="$2"
    julia --startup-file=no --history-file=no --color=no -e "
include(\"$root/endpoints/julia/zerodds.jl\")
w = ZeroDDS.Writer(ZeroDDS.LE, ZeroDDS.XCDR2)
try
    ZeroDDS.$call!(w, $argument)
    println(bytes2hex(ZeroDDS.bytes(w)))
