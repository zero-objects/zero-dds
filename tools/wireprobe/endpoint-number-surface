emit_python() {
    local call="$1" argument="$2"
    PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$root/endpoints/python" \
        "${PYTHON:-python3}" -W error -c "
import zerodds_wire as zd
w = zd.Writer(zd.LE, zd.XCDR2)
try:
    w.$call($argument)
except ValueError as e:
