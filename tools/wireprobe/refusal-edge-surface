#
# refusal-edge-surface — every row of `refusal-range-edges.tsv`, asked of
# every binding that can be asked.
#
#   tools/wireprobe/refusal-edge-surface
#   tools/wireprobe/refusal-edge-surface --langs go,lua,rt-c
#   tools/wireprobe/refusal-edge-surface --edges over-u16,short-pid-past-0x3f00
#   tools/wireprobe/refusal-edge-surface --list
#
# ## What this asks
#
# `tools/wireprobe/refusal-range-edges.tsv` is the case list for the
# values no corpus sample can carry: seventeen edges, each with exactly
# one right answer derived from the named clause — `refuse`, or the
# exact octets where the value has an exact form in the width.
# `endpoint-number-surface` asks four of its rows of fifteen bindings;
# this asks all seventeen of thirty surfaces:
#
#   - the fifteen hand-written endpoint SDKs that lay their own octets
#     from a writer somebody typed (`docs/interop-harnesses.md`): ada,
#     ada-83, ada-native, d, elixir, fsharp, go, julia, kotlin, lua,
#     nim, node, ocaml, swift, zig
#   - the fourteen wire-runtime columns under `runtime/`: rt-ada, rt-c,
#     rt-cpp, rt-csharp, rt-d, rt-elixir, rt-go, rt-java, rt-lua,
#     rt-nim, rt-python, rt-swift, rt-typescript, rt-zig
#   - the Rust wire core, `crates/wire` (rust-wire)
#
# `runtime/{ada,lua,nim,swift,zig}` are the five newest of those
# columns. They are separate surfaces from the endpoint SDKs of the same
# five names: `endpoints/nim` exports `putU16`, `runtime/nim` exports
# `writeU16`, and the two are different code answering the same clause.
#
# `endpoints/java` and `endpoints/python` are not surfaces here and are
# not skipped silently either: neither exports a writer at all — their
# corpus columns are generated codecs — so there is no call to ask.
# `endpoint-number-surface` lists both in its `--langs` default and has
# no emitter for either, which is why its `java` and `python` rows have
# always been `emit_java: command not found` rather than an answer.
#
# ## The shape of a probe
#
# One program per surface, taking the edge name as its one argument. It
# makes a fresh little-endian XCDR2 writer, performs that row's
# operation with that row's argument, and prints exactly one line:
#
#   <hex>                    the octets the writer holds
#   wrote-frame len=<n>      a frame writer that produced a frame
#   REFUSED <the binding's own words>
#   BROKEN <why the probe could not run>
#
# Three rows have no spelling inside that program, because several
# bindings put the wire width in the parameter type and a literal
# outside it is a compile error rather than a statement: `over-u8`,
# `over-u16` and `over-u32` are each compiled on their own, so that the
# compiler's refusal is attributed to the row it belongs to and does not
# take the other fourteen down with it.
#
# ## What is never silent
#
#   PASS          the answer is the ledger's answer.
#   FAIL          the answer contradicts the ledger — octets where
#                 `refuse` is required (the silent-drop class), a
#                 refusal where the value has an exact form, or the
#                 wrong octets. Reported at once, with the row, the
#                 surface, what was answered and what the clause says.
#                 Any FAIL sets exit code 8.
#   n/a           the surface exports no operation that can reach the
#                 row. Each such cell names why; nothing is skipped
#                 without a word.
#   skipped       the surface's toolchain is not on this host. Named,
#                 and never counted as passed.
#   broken-probe  the probe itself could not be built, started or run.
#                 Two controls stand in front of every answer: a
#                 surface control (`c:writer` — a fresh writer and one
#                 octet) and, for each row, an operation control — the
#                 same call with an in-range argument. If either fails
#                 the cell is the probe's failure and NOT an answer. A
#                 compile error of a stale probe must never be mistaken
#                 for a binding's refusal.
#   timeout       the probe was still running at the limit. Its own
#                 class, never an answer, never a hang of the run.
#   no-probe      a ledger row this driver has no case for. A new edge
#                 must get a probe, not silence.
#
# broken-probe, timeout and no-probe each set exit code 2. 8 wins.
#
# ## Attribution of compile-time refusals
#
# Several bindings put the wire width in the parameter type (`PutU16`
# takes a `uint16`), so `over-u16` has no spelling at all and the
# compiler's error IS the binding's refusal. That attribution is only
# made when the operation control — same harness, `PutU16(0x1234)` — is
# green; otherwise the failure is `broken-probe`. For the rows whose
# ledger answer is octets (the negatives, the value past 2^63, -0.0),
# the argument is spelled the way a caller of that binding spells it —
# the two's-complement bit pattern where the parameter is the wire
# width, the IDL value where it is wider — because the conversion is
# the caller's in every one of these SDKs (`--numbers bits` in
# `wireprobe-endpoint-gen`), and a probe that handed an unspellable
# literal would measure its own arithmetic. `endpoint-number-surface`
# hands `put_u16(-12345)` to a `uint16` parameter and reads the
# compiler's `cannot use -12345` as the binding's answer; it is not.
set -uo pipefail

cd "$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)" || exit 2
root="$PWD"
tsv="$root/tools/wireprobe/refusal-range-edges.tsv"

all_surfaces="ada,ada-83,ada-native,d,elixir,fsharp,go,julia,kotlin,lua,nim,node,ocaml,swift,zig,rt-ada,rt-c,rt-cpp,rt-csharp,rt-d,rt-elixir,rt-go,rt-java,rt-lua,rt-nim,rt-python,rt-swift,rt-typescript,rt-zig,rust-wire"
langs="$all_surfaces"
edges_filter=""
build_secs="${ZERODDS_EDGE_BUILD_TIMEOUT:-180}"
run_secs="${ZERODDS_EDGE_RUN_TIMEOUT:-25}"
list_only=0
while [ $# -gt 0 ]; do
    case "$1" in
        --langs) langs="$2"; shift 2 ;;
        --edges) edges_filter="$2"; shift 2 ;;
        --timeout) run_secs="$2"; shift 2 ;;
        --build-timeout) build_secs="$2"; shift 2 ;;
        --list) list_only=1; shift ;;
        --help|-h) sed -n '5,105p' "${BASH_SOURCE[0]}"; exit 0 ;;
        *) echo "refusal-edge-surface: \`$1\` is not an option" >&2; exit 2 ;;
    esac
done

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
LIMOUT="$work/.limout"

# --- the ledger -------------------------------------------------------

[ -f "$tsv" ] || { echo "refusal-edge-surface: $tsv is missing" >&2; exit 2; }

# The edge names this driver knows a probe for. A ledger row outside
# this list is reported as `no-probe` for every surface and fails the
# run with exit 2: a new edge must get a probe, not silence.
known_edges="over-u8 over-u16 over-u32 negative-u16 negative-u32 past-2-63 \
negative-zero-f32 negative-zero-f64 char-above-8-bit wchar-above-bmp \
member-id-past-28-bit short-pid-past-0x3f00 fixed-digits-past-31 \
fixed-scale-past-digits bitset-anchor-width lc-body-size-mismatch \
frame-past-0xffff"

ledger_edges=$(awk -F'\t' '/^[^#]/ && NF >= 4 { print $1 }' "$tsv")

expected_of() { # $1 edge -> the ledger's answer column, verbatim
    awk -F'\t' -v e="$1" '$1 == e { print $4; exit }' "$tsv"
}

operation_of() { # $1 edge -> the ledger's operation column
    awk -F'\t' -v e="$1" '$1 == e { print $2; exit }' "$tsv"
}

is_known_edge() {
    local e
    for e in $known_edges; do [ "$e" = "$1" ] && return 0; done
    return 1
}

in_filter() { # $1 value  $2 comma list ("" = everything)
    [ -z "$2" ] && return 0
    local v
    for v in $(printf '%s' "$2" | tr ',' ' '); do
        [ "$v" = "$1" ] && return 0
    done
    return 1
}

# The in-range call that has to work before the out-of-range one is an
# answer. Same operation, an argument the width holds.
control_of() { # $1 edge -> the control token
    case "$1" in
        over-u8|over-u16|over-u32)             echo "c:$1" ;;
        negative-u16|negative-u32|past-2-63)   echo "c:int" ;;
        negative-zero-f32|negative-zero-f64)   echo "c:float" ;;
        char-above-8-bit)                      echo "c:char" ;;
        wchar-above-bmp)                       echo "c:wchar" ;;
        member-id-past-28-bit|lc-body-size-mismatch) echo "c:emheader" ;;
        short-pid-past-0x3f00)                 echo "c:pid" ;;
        fixed-digits-past-31|fixed-scale-past-digits) echo "c:fixed" ;;
        bitset-anchor-width)                   echo "c:bitset" ;;
        frame-past-0xffff)                     echo "c:frame" ;;
    esac
}

# --- reachability -----------------------------------------------------
#
# A row a surface cannot reach is `n/a` WITH the reason, never silence.

na_reason() { # $1 surface  $2 edge -> prints the reason, rc 0 = n/a
    case "$1" in
        rt-*|rust-wire)
            case "$2" in
                frame-past-0xffff)
                    echo "the wire runtime exports no frame writer; DDS-XRCE framing lives in the endpoint SDKs"
                    return 0 ;;
            esac ;;
    esac
    case "$1" in
        rust-wire)
            case "$2" in
                fixed-digits-past-31|fixed-scale-past-digits)
                    echo "crates/wire exports no write_fixed; the BCD packing lives in crates/wire-codec"
                    return 0 ;;
                bitset-anchor-width)
                    echo "crates/wire exports no write_bitset; the anchor writer lives in crates/wire-codec"
                    return 0 ;;
            esac ;;
        ada)
            case "$2" in
                frame-past-0xffff)
                    echo "endpoints/ada/src imports no zdw_xrce_write_frame; the C core's frame writer has no Ada binding"
                    return 0 ;;
            esac ;;
    esac
    return 1
}

# --- toolchains -------------------------------------------------------

toolchain_of() { # $1 surface -> the commands the surface needs
    case "$1" in
        go|rt-go)         echo "go" ;;
        lua|rt-lua)       echo "lua" ;;
        julia)            echo "julia" ;;
        ocaml)            echo "ocamlfind" ;;
        elixir|rt-elixir) echo "elixir" ;;
        zig|rt-zig)       echo "${ZIG:-zig}" ;;
        nim|rt-nim)       echo "${NIM:-nim}" ;;
        d|rt-d)           echo "${GDC:-gdc}" ;;
        kotlin)           echo "${KOTLINC:-kotlinc} ${JAVA:-java}" ;;
        node)             echo "${NODE:-node}" ;;
        fsharp|rt-csharp) echo "${DOTNET:-dotnet}" ;;
        swift|rt-swift)   echo "${SWIFTC:-swiftc}" ;;
        rt-java)          echo "javac ${JAVA:-java}" ;;
        rt-python)        echo "python3" ;;
        ada|ada-83|ada-native|rt-ada) echo "gnatmake gcc" ;;
        rt-c)             echo "${CC:-gcc}" ;;
        rt-cpp)           echo "${CXX:-g++}" ;;
        rt-typescript)    echo "${TSC:-tsc} ${NODE:-node}" ;;
        rust-wire)        echo "cargo" ;;
        *)                echo "" ;;
    esac
}

missing_toolchain() { # $1 surface -> prints the first missing command
    local c
    for c in $(toolchain_of "$1"); do
        command -v "$c" > /dev/null 2>&1 || { echo "$c"; return 0; }
    done
    return 1
}

# A toolchain that is present and cannot build anything is not the same
# as a probe that is wrong, and it is not a pass either. The smoke build
# is a hello-world of the toolchain's own: if that does not link, the
# surface is `skipped` with the toolchain's words, not `broken-probe`.
# Measured 2026-08-25: zig 0.14.1 on macOS 15 links nothing at all
# (`undefined symbol: __availability_version_check`), and every zig cell
# was reported as this file's defect until the smoke build separated
# them.
toolchain_unusable() { # $1 surface -> prints why, rc 0 = unusable
    local dir="$work/.smoke-$1"
    case "$1" in
        zig|rt-zig)
            [ -f "$dir/.no" ] && { cat "$dir/.no"; return 0; }
            [ -f "$dir/.yes" ] && return 1
            mkdir -p "$dir"
            cat > "$dir/hello.zig" <<'SMOKE'
const std = @import("std");
pub fn main(zd_init: std.process.Init) !void {
    var stdout_buf: [64]u8 = undefined;
    var stdout_file = std.Io.File.stdout().writer(zd_init.io, &stdout_buf);
    const stdout = &stdout_file.interface;
    defer stdout.flush() catch {};
    try stdout.print("hi\n", .{});
}
SMOKE
            if (cd "$dir" && "${ZIG:-zig}" build-exe \
                    --global-cache-dir "$(zig_cache)" -femit-bin=hello hello.zig) \
                    > "$dir/log" 2>&1 && [ -s "$dir/hello" ]; then
                : > "$dir/.yes"; return 1
            fi
            first_error_line "$dir/log" > "$dir/.no"
            cat "$dir/.no"
            return 0 ;;
    esac
    return 1
}

is_known_surface() {
    local s
    for s in $(printf '%s' "$all_surfaces" | tr ',' ' '); do
        [ "$s" = "$1" ] && return 0
    done
    return 1
}

# --- shared probe plumbing --------------------------------------------

first_error_line() { # $1 log file — the first line worth carrying out
    # Warnings are dropped first. `ocamlfind` opens every run with
    # `[WARNING] Cannot read directory ./stublibs`, and a first line
    # matched on `cannot` reported that as the reason a build failed —
    # a probe's real error hidden behind a toolchain's noise.
    grep -viE '\[warning\]|^ *warning:|: warning' "$1" \
        | grep -m1 -iE 'error|cannot|overflow|not enough|panic|exception|refused|raised|constraint|assert|traceback' \
        | tr -d '\r' | cut -c1-160
    true
}

last_line() { tr -d '\r' < "$1" | grep -v '^[[:space:]]*$' | tail -1; }

# An answer that counts as a working control: octets, or a frame the
# writer actually produced. `len=0` is not one — it is the error return
# the ledger's `frame-past-0xffff` row calls the right answer, and a
# control that produces it has not shown that the call works.
control_answers() { # $1 answer
    printf '%s' "$1" | grep -qE '^([0-9a-f]+|wrote-frame len=[1-9][0-9]*)$'
}

# Run a command under a wall-clock limit. Combined output lands in
# $LIMOUT. Returns 124 on the limit, and only on the limit: the killer
# leaves a mark so a probe that dies of a signal on its own is not
# reported as a hang.
lim() { # $1 seconds, rest: the command
    local secs="$1"; shift
    rm -f "$LIMOUT" "$LIMOUT.killed"
    : > "$LIMOUT"
    "$@" > "$LIMOUT" 2>&1 &
    local pid=$!
    (
        i=0
        while [ "$i" -lt "$((secs * 4))" ]; do
            kill -0 "$pid" 2>/dev/null || exit 0
            sleep 0.25
            i=$((i + 1))
        done
        : > "$LIMOUT.killed"
        kill -9 "$pid" 2>/dev/null
    ) &
    local killer=$!
    wait "$pid"; local rc=$?
    kill "$killer" 2>/dev/null
    wait "$killer" 2>/dev/null
    [ -f "$LIMOUT.killed" ] && return 124
    return "$rc"
}

# Build once per surface. `$work/<surface>/.bad` holds why, if it went
# wrong; every cell of that surface is then broken-probe.
build_state() { # $1 surface -> 0 built, 1 not yet, 2 known broken
    [ -f "$work/$1/.ok" ] && return 0
    [ -f "$work/$1/.bad" ] && return 2
    return 1
}
build_ok()  { mkdir -p "$work/$1"; : > "$work/$1/.ok"; }
build_bad() { mkdir -p "$work/$1"; printf '%s\n' "$2" > "$work/$1/.bad"; }

# Run a built native probe and turn its exit into one answer line.
run_native() { # $1 surface  $2 executable  rest: arguments
    local surface="$1" exe="$2"; shift 2
    local rc=0
    lim "$run_secs" "$exe" "$@" || rc=$?
    if [ "$rc" = 124 ]; then echo "TIMEOUT"; return; fi
    local out; out="$(last_line "$LIMOUT")"
    if [ "$rc" != 0 ] && [ "${out#REFUSED}" = "$out" ]; then
        local words; words="$(first_error_line "$LIMOUT")"
        if [ -n "$words" ]; then echo "REFUSED $words"
        else echo "BROKEN the probe exited $rc without a word"; fi
        return
    fi
    if [ -z "$out" ]; then echo "BROKEN the probe printed nothing"; return; fi
    printf '%s\n' "$out"
}

# =====================================================================
# The fifteen endpoint SDKs.
#
# They export one surface — `putU8` .. `putU64`, `putF32`/`putF64`,
# `putChar`, `putWchar`, `emHeaderBegin`/`emHeaderEnd`,
# `pidBegin`/`pidEnd`, `putBitset`, `putFixed` and a frame writer — so
# every runner below performs the same seventeen operations and differs
# only in how its language spells them.
#
# Both constructor arguments are required in all fifteen: the encoding
# decides MAXALIGN and none of them defaults it. `endpoint-number-surface`
# leaves it out for go, node, zig, nim, d, kotlin, fsharp and swift, and
# those eight probes have never compiled.
# =====================================================================

# --- go ---------------------------------------------------------------

go_env() {
    export GOFLAGS=-mod=mod GOTOOLCHAIN=local CGO_ENABLED=0
    export GOCACHE="${ZERODDS_GO_CACHE:-${TMPDIR:-/tmp}/zd-endpoint-go-cache}"
}

go_module() { # $1 directory  $2 module path to replace
    cat > "$1/go.mod" <<EOF
module zdedgesurface

go 1.19

require zeroddsendpoint v0.0.0

replace zeroddsendpoint => $2
EOF
}

go_build() {
    build_state go; case $? in 0) return 0 ;; 2) return 1 ;; esac
    mkdir -p "$work/go"
    go_module "$work/go" "$root/endpoints/go"
    cat > "$work/go/main.go" <<'EOF'
package main

import (
	"fmt"
	"math"
	"os"

	zerodds "zeroddsendpoint"
)

func frame(sample []byte) {
	f := zerodds.XrceWriteFrame(0x80, 0x01, 1, sample)
	if len(f) == 0 {
		fmt.Println("REFUSED the frame writer produced no frame")
		return
	}
	fmt.Printf("wrote-frame len=%d\n", len(f))
}

func main() {
	defer func() {
		if r := recover(); r != nil {
			fmt.Printf("REFUSED %v\n", r)
		}
	}()
	w := zerodds.NewWriter(zerodds.Little, zerodds.Xcdr2)
	switch os.Args[1] {
	case "c:writer":
		w.PutU8(0x41)
	case "c:int":
		w.PutU16(0x1234)
	case "negative-u16":
		w.PutU16(0xcfc7)
	case "negative-u32":
		w.PutU32(0xffed2979)
	case "past-2-63":
		w.PutU64(16045690984833335998)
	case "c:float":
		w.PutF32(1.0)
	case "negative-zero-f32":
		w.PutF32(float32(math.Copysign(0, -1)))
	case "negative-zero-f64":
		w.PutF64(math.Copysign(0, -1))
	case "c:char":
		w.PutChar(0x41)
	case "char-above-8-bit":
		w.PutChar(0x100)
	case "c:wchar":
		w.PutWchar(0x41)
	case "wchar-above-bmp":
		w.PutWchar(0x1D11E)
	case "c:emheader":
		s := w.EmHeaderBegin(1, false, zerodds.Lc4)
		w.PutU32(0)
		w.EmHeaderEnd(s, zerodds.Lc4)
	case "member-id-past-28-bit":
		s := w.EmHeaderBegin(0x10000000, false, zerodds.Lc4)
		w.PutU32(0)
		w.EmHeaderEnd(s, zerodds.Lc4)
	case "lc-body-size-mismatch":
		s := w.EmHeaderBegin(1, false, zerodds.Lc1)
		w.PutU8(1)
		w.PutU8(2)
		w.PutU8(3)
		w.EmHeaderEnd(s, zerodds.Lc1)
	case "c:pid":
		p := w.PidBegin(0x3F00, false)
		w.PutU32(0)
		w.PidEnd(p)
	case "short-pid-past-0x3f00":
		p := w.PidBegin(0x3F01, false)
		w.PutU32(0)
		w.PidEnd(p)
	case "c:fixed":
		w.PutFixed("1.00", 5, 2)
	case "fixed-digits-past-31":
		w.PutFixed("1.00", 32, 2)
	case "fixed-scale-past-digits":
		w.PutFixed("1.00", 5, 6)
	case "c:bitset":
		w.PutBitset(0x1234, 2)
	case "bitset-anchor-width":
		w.PutBitset(0x222111, 4)
	case "c:frame":
		frame([]byte{1, 2, 3, 4})
		return
	case "frame-past-0xffff":
		frame(make([]byte, 65536))
		return
	default:
		fmt.Printf("BROKEN the go probe has no case for %s\n", os.Args[1])
		return
	}
	fmt.Printf("%x\n", w.Buf)
}
EOF
    (go_env; cd "$work/go" && go build -o probe .) > "$work/go/build.log" 2>&1 || {
        build_bad go "$(first_error_line "$work/go/build.log")"; return 1; }
    build_ok go
}

go_over() { # $1 token
    local put lit dir="$work/go-$1"
    case "$1" in
        over-u8|c:over-u8)   put=PutU8 ;;
        over-u16|c:over-u16) put=PutU16 ;;
        over-u32|c:over-u32) put=PutU32 ;;
    esac
    case "$1" in
        over-u8)     lit=256 ;;        c:over-u8)   lit=0x12 ;;
        over-u16)    lit=70000 ;;      c:over-u16)  lit=0x1234 ;;
        over-u32)    lit=4294967296 ;; c:over-u32)  lit=0x12345678 ;;
    esac
    mkdir -p "$dir"
    go_module "$dir" "$root/endpoints/go"
    cat > "$dir/main.go" <<EOF
package main

import (
	"fmt"

	zerodds "zeroddsendpoint"
)

func main() {
	defer func() {
		if r := recover(); r != nil {
			fmt.Printf("REFUSED %v\n", r)
		}
	}()
	w := zerodds.NewWriter(zerodds.Little, zerodds.Xcdr2)
	w.$put($lit)
	fmt.Printf("%x\n", w.Buf)
}
EOF
    local rc=0
    (go_env; cd "$dir" && go build -o probe .) > "$dir/build.log" 2>&1 || rc=$?
    if [ "$rc" != 0 ]; then
        echo "REFUSED $(first_error_line "$dir/build.log")"
        return
    fi
    run_native go "$dir/probe"
}

probe_go() {
    case "$1" in over-u*|c:over-u*) go_over "$1"; return ;; esac
    go_build || { echo "BROKEN $(cat "$work/go/.bad")"; return; }
    run_native go "$work/go/probe" "$1"
}

# --- lua --------------------------------------------------------------

probe_lua() {
    mkdir -p "$work/lua"
    cat > "$work/lua/probe.lua" <<'EOF'
local zd = require('zerodds')
local token = arg[1]
local function frame(sample)
  local f = zd.writeFrame(0x80, 0x01, 1, sample)
  if f == nil or #f == 0 then
    print('REFUSED the frame writer produced no frame')
  else
    print('wrote-frame len=' .. #f)
  end
end
local w = zd.Writer.new(zd.LE, zd.XCDR2)
local ok, err = pcall(function()
  if token == 'c:writer' then w:putU8(0x41)
  elseif token == 'c:int' then w:putU16(0x1234)
  elseif token == 'negative-u16' then w:putU16(0xcfc7)
  elseif token == 'negative-u32' then w:putU32(0xffed2979)
  elseif token == 'past-2-63' then w:putU64(0xdeadbeefdeadc2be)
  elseif token == 'c:float' then w:putF32(1.0)
  elseif token == 'negative-zero-f32' then w:putF32(-0.0)
  elseif token == 'negative-zero-f64' then w:putF64(-0.0)
  elseif token == 'c:char' then w:putChar(0x41)
  elseif token == 'char-above-8-bit' then w:putChar(0x100)
  elseif token == 'c:wchar' then w:putWchar(0x41)
  elseif token == 'wchar-above-bmp' then w:putWchar(0x1D11E)
  elseif token == 'c:emheader' then
    local s = w:emheaderBegin(1, false, 4); w:putU32(0); w:emheaderEnd(s, 4)
  elseif token == 'member-id-past-28-bit' then
