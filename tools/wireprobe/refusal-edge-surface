# --- ada-83 -----------------------------------------------------------
#
# Ada 83 has no child units, so no `Ada.Command_Line` and no
# `Ada.Exceptions`: the token arrives on standard input through a two-line
# wrapper, and a refusal is `when others` without a name. The binding's
# own words for these edges are its exception names, which is what its
# `.ads` carries; the probe reports the class it caught.

ada83_build() {
    build_state ada-83; case $? in 0) return 0 ;; 2) return 1 ;; esac
    mkdir -p "$work/ada83"
    cat > "$work/ada83/probe.adb" <<'EOF'
with Text_IO;
with Zerodds_Ada83_Wire; use Zerodds_Ada83_Wire;
with Zerodds_Ada83_Endpoint;
procedure Probe is
   W     : Writer;
   Digs  : constant String := "0123456789abcdef";
   Token : String (1 .. 64);
   Last  : Natural;
   Start : Integer;
   Head  : Pid_Header;

   procedure Emit is
   begin
      if W.Overflow then
         Text_IO.Put_Line ("REFUSED the writer overflowed");
         return;
      end if;
      for I in 0 .. Length (W) - 1 loop
         Text_IO.Put (Digs (Integer (W.Buf (I)) / 16 + 1));
         Text_IO.Put (Digs (Integer (W.Buf (I)) mod 16 + 1));
      end loop;
      Text_IO.New_Line;
   end Emit;

   procedure Frame (N : Integer) is
      Sample : constant Byte_Array (0 .. N - 1) := (others => 0);
      F      : Writer;
   begin
      Init (F, Little);
      Zerodds_Ada83_Endpoint.Xrce_Write_Frame (F, 16#80#, 16#01#, 1, Sample);
      if F.Overflow or else Length (F) = 0 then
         Text_IO.Put_Line ("REFUSED the frame writer produced no frame");
      else
         Text_IO.Put_Line ("wrote-frame len=" &
            Integer'Image (Length (F)) (2 .. Integer'Image (Length (F))'Last));
      end if;
   exception
      when others =>
         Text_IO.Put_Line ("REFUSED a check rejected the sample");
   end Frame;
begin
   Text_IO.Get_Line (Token, Last);
   Init (W, Little);
   declare
      T : constant String := Token (1 .. Last);
   begin
      if T = "c:writer" then Put_U8 (W, 16#41#);
      elsif T = "c:int" then Put_U16 (W, 16#1234#);
      elsif T = "negative-u16" then Put_U16 (W, 16#CFC7#);
      elsif T = "negative-u32" then Put_U32 (W, 16#FFED2979#);
      elsif T = "past-2-63" then Put_U64 (W, 16#DEADBEEF#, 16#DEADC2BE#);
      elsif T = "c:float" then Put_F32 (W, 1.0);
      elsif T = "negative-zero-f32" then Put_F32 (W, -0.0);
      elsif T = "negative-zero-f64" then Put_F64 (W, -0.0);
      elsif T = "c:char" then Put_Char (W, 16#41#);
      elsif T = "char-above-8-bit" then Put_Char (W, 16#100#);
      elsif T = "c:wchar" then Put_Wchar (W, 16#41#);
      elsif T = "wchar-above-bmp" then Put_Wchar (W, 16#1D11E#);
      elsif T = "c:emheader" then
         EMHeader_Begin (W, 1, False, LC4, Start);
         Put_U32 (W, 0);
         EMHeader_End (W, Start, LC4);
      elsif T = "member-id-past-28-bit" then
         EMHeader_Begin (W, 16#10000000#, False, LC4, Start);
         Put_U32 (W, 0);
         EMHeader_End (W, Start, LC4);
      elsif T = "lc-body-size-mismatch" then
         EMHeader_Begin (W, 1, False, LC1, Start);
         Put_U8 (W, 1); Put_U8 (W, 2); Put_U8 (W, 3);
         EMHeader_End (W, Start, LC1);
      elsif T = "c:pid" then
         Pid_Begin (W, 16#3F00#, False, Head);
         Put_U32 (W, 0);
         Pid_End (W, Head);
      elsif T = "short-pid-past-0x3f00" then
         Pid_Begin (W, 16#3F01#, False, Head);
         Put_U32 (W, 0);
         Pid_End (W, Head);
      elsif T = "c:fixed" then Put_Fixed (W, "1.00", 5, 2);
      elsif T = "fixed-digits-past-31" then Put_Fixed (W, "1.00", 32, 2);
      elsif T = "fixed-scale-past-digits" then Put_Fixed (W, "1.00", 5, 6);
      elsif T = "c:bitset" then Put_Bitset (W, 0, 16#1234#, 2);
      elsif T = "bitset-anchor-width" then Put_Bitset (W, 0, 16#222111#, 4);
      elsif T = "c:frame" then Frame (4); return;
      elsif T = "frame-past-0xffff" then Frame (65536); return;
      else
         Text_IO.Put_Line ("BROKEN the ada-83 probe has no case for " & T);
         return;
      end if;
      Emit;
   end;
exception
   when others =>
      Text_IO.Put_Line ("REFUSED a check rejected the argument");
end Probe;
EOF
    cat > "$work/ada83/run.sh" <<EOF
#!/bin/sh
printf '%s\n' "\$1" | "$work/ada83/probe"
EOF
    chmod +x "$work/ada83/run.sh"
    (cd "$work/ada83" && gnatmake -q -gnat83 -D "$work/ada83" \
        -aI"$root/endpoints/ada-83/src" -o probe probe.adb) \
        > "$work/ada83/build.log" 2>&1 || {
        build_bad ada-83 "$(first_error_line "$work/ada83/build.log")"; return 1; }
    build_ok ada-83
}

