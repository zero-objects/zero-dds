        w.pidEnd(p) catch |e| return refused(out, e);
    } else if (eq(u8, token, "short-pid-past-0x3f00")) {
        const p = w.pidBegin(0x3F01, false) catch |e| return refused(out, e);
        w.putU32(0) catch |e| return refused(out, e);
        w.pidEnd(p) catch |e| return refused(out, e);
    } else if (eq(u8, token, "c:fixed")) {
        w.putFixed("1.00", 5, 2) catch |e| return refused(out, e);
    } else if (eq(u8, token, "fixed-digits-past-31")) {
        w.putFixed("1.00", 32, 2) catch |e| return refused(out, e);
    } else if (eq(u8, token, "fixed-scale-past-digits")) {
        w.putFixed("1.00", 5, 6) catch |e| return refused(out, e);
    } else if (eq(u8, token, "c:bitset")) {
        w.putBitset(0x1234, 2) catch |e| return refused(out, e);
    } else if (eq(u8, token, "bitset-anchor-width")) {
        w.putBitset(0x222111, 4) catch |e| return refused(out, e);
    } else if (eq(u8, token, "c:frame")) {
        return frame(out, alloc, &[_]u8{ 1, 2, 3, 4 });
    } else if (eq(u8, token, "frame-past-0xffff")) {
        const big = try alloc.alloc(u8, 65536);
        @memset(big, 0);
        return frame(out, alloc, big);
    } else {
        try out.print("BROKEN the zig probe has no case for {s}\n", .{token});
        return;
    }
    try hex(out, w.bytes());
}
EOF
