    case "short-pid-past-0x3f00":
        let p = try w.pidBegin(0x3F01, mustUnderstand: false)
        w.putU32(0)
        try w.pidEnd(p)
    case "c:fixed": try w.putFixed("1.00", digits: 5, scale: 2)
    case "fixed-digits-past-31": try w.putFixed("1.00", digits: 32, scale: 2)
    case "fixed-scale-past-digits": try w.putFixed("1.00", digits: 5, scale: 6)
    case "c:bitset": try w.putBitset(0x1234, anchor: 2)
    case "bitset-anchor-width": try w.putBitset(0x22_2111, anchor: 4)
    case "c:frame": frame([1, 2, 3, 4]); exit(0)
    case "frame-past-0xffff": frame([UInt8](repeating: 0, count: 65536)); exit(0)
    default:
        print("BROKEN the swift probe has no case for \(token)")
        exit(0)
    }
    hex(w.bytes())
} catch {
    print("REFUSED \(error)")
}
