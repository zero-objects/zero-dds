# --- rt-csharp --------------------------------------------------------

# `runtime/csharp` targets net8.0. A host with only a newer runtime
# installed builds that and then exits 150 at launch — a probe that
# never ran, and one this file must not read as an answer. The target
# framework is taken from the runtimes actually installed, so the probe
# runs where the runtime is; the wire code is the same either way.
dotnet_tfm() {
    local major
    major="$("${DOTNET:-dotnet}" --list-runtimes 2>/dev/null \
        | awk '/^Microsoft.NETCore.App /{split($2, v, "."); if (v[1] + 0 > m) m = v[1] + 0} END {print m}')"
    case "$major" in
        ''|0) echo net8.0 ;;
        *) [ "$major" -lt 8 ] && echo net8.0 || echo "net$major.0" ;;
    esac
}

rt_csharp_build() {
    build_state rt-csharp; case $? in 0) return 0 ;; 2) return 1 ;; esac
    mkdir -p "$work/rtcsharp"
    cat > "$work/rtcsharp/Probe.csproj" <<EOF
