# Where `kotlin-stdlib.jar` sits differs by packaging: next to the
# compiler under `lib/` in the tarball, under `libexec/lib/` in
# Homebrew's. Both are looked for, and `KOTLIN_STDLIB` overrides.
kotlin_stdlib() {
    if [ -n "${KOTLIN_STDLIB:-}" ]; then echo "$KOTLIN_STDLIB"; return; fi
    local bin base candidate
    bin="$(command -v "${KOTLINC:-kotlinc}")"
    # `readlink -f` is GNU; the loop is the portable spelling.
    while [ -L "$bin" ]; do bin="$(cd "$(dirname "$bin")" && pwd)/$(readlink "$bin")"; done
    base="$(cd "$(dirname "$(dirname "$bin")")" && pwd)"
    for candidate in "$base/lib" "$base/libexec/lib" "$base/../libexec/lib"; do
        [ -f "$candidate/kotlin-stdlib.jar" ] && {
            echo "$candidate/kotlin-stdlib.jar"; return; }
    done
    echo "$base/lib/kotlin-stdlib.jar"
}

