using System;
using ZeroDds.Wire;

public static class Probe
{
    public static void Main(string[] args)
    {
        string token = args[0];
        var w = new Writer(Endianness.Little, 4, null, false);
        try
        {
            switch (token)
            {
                case "c:writer": w.WriteU8(0x41); break;
                case "c:int": w.WriteU16(0x1234); break;
                case "negative-u16": w.WriteU16(0xcfc7); break;
                case "negative-u32": w.WriteU32(0xffed2979u); break;
                case "past-2-63": w.WriteU64(0xdeadbeefdeadc2beUL); break;
                case "c:float": w.WriteF32(1.0f); break;
                case "negative-zero-f32": w.WriteF32(-0.0f); break;
                case "negative-zero-f64": w.WriteF64(-0.0); break;
                case "c:char": w.WriteChar('A'); break;
                case "c:wchar":
                    w.WriteWchar('A', WcharWidth.Octets2, WcharFraming.Fixed,
                        WstringUnitOrder.Stream);
                    break;
                case "c:emheader": {
                    var h = w.WriteEmheader(1, 4, false); w.WriteU32(0); w.FinishEmheader(h); break;
                }
                case "member-id-past-28-bit": {
                    var h = w.WriteEmheader(0x10000000, 4, false);
                    w.WriteU32(0); w.FinishEmheader(h); break;
                }
                case "lc-body-size-mismatch": {
                    var h = w.WriteEmheader(1, 1, false);
                    w.WriteU8(1); w.WriteU8(2); w.WriteU8(3);
                    w.FinishEmheader(h); break;
                }
                case "c:pid": {
                    var p = w.WritePid(0x3F00, ParameterRole.Member, false);
                    w.WriteU32(0); w.FinishPid(p); break;
                }
                case "short-pid-past-0x3f00": {
                    var p = w.WritePid(0x3F01, ParameterRole.Member, false);
                    w.WriteU32(0); w.FinishPid(p); break;
                }
                case "c:fixed": w.WriteFixed("1.00", 5, 2, FixedDigitCount.Declared); break;
                case "fixed-digits-past-31":
                    w.WriteFixed("1.00", 32, 2, FixedDigitCount.Declared); break;
                case "fixed-scale-past-digits":
                    w.WriteFixed("1.00", 5, 6, FixedDigitCount.Declared); break;
                case "c:bitset": w.WriteBitset(2, 0x1234UL); break;
                case "bitset-anchor-width": w.WriteBitset(4, 0x222111UL); break;
                default:
                    Console.WriteLine("BROKEN the rt-csharp probe has no case for " + token);
                    return;
            }
            Console.WriteLine(Convert.ToHexString(w.Finish()).ToLowerInvariant());
        }
        catch (Exception e)
        {
            Console.WriteLine("REFUSED " + e.GetType().Name + ": " + e.Message);
        }
    }
}
