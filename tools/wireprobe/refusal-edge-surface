# --- ada-native -------------------------------------------------------

adanative_build() {
    build_state ada-native; case $? in 0) return 0 ;; 2) return 1 ;; esac
    mkdir -p "$work/adanative"
    cat > "$work/adanative/probe.adb" <<'EOF'
with Ada.Command_Line;
with Ada.Exceptions;
with Ada.Text_IO;
with Interfaces;
with Native_Framing;
with Zerodds_Native_Wire; use Zerodds_Native_Wire;
procedure Probe is
   --  `-0.0` below needs the unary minus of the float types to be
   --  visible; without these the probe does not compile and every cell
   --  of this surface reads `broken-probe` instead of an answer.
   use type Interfaces.IEEE_Float_32;
   use type Interfaces.IEEE_Float_64;
   W     : Writer;
   Digs  : constant String := "0123456789abcdef";
   Token : constant String := Ada.Command_Line.Argument (1);
   Start : Natural;
   Head  : Pid_Header;

   procedure Emit is
      Out_Bytes : constant Byte_Array := Bytes (W);
   begin
      for B of Out_Bytes loop
         Ada.Text_IO.Put (Digs (Natural (B) / 16 + 1));
         Ada.Text_IO.Put (Digs (Natural (B) mod 16 + 1));
      end loop;
      Ada.Text_IO.New_Line;
   end Emit;

   procedure Frame (N : Natural) is
      Sample : constant Byte_Array (0 .. N - 1) := [others => 0];
      F      : constant Byte_Array :=
        Native_Framing.Xrce_Write_Frame (16#80#, 16#01#, 1, Sample);
   begin
      if F'Length = 0 then
         Ada.Text_IO.Put_Line ("REFUSED the frame writer produced no frame");
      else
         Ada.Text_IO.Put_Line ("wrote-frame len=" &
            Natural'Image (F'Length) (2 .. Natural'Image (F'Length)'Last));
      end if;
   exception
      when E : others =>
         Ada.Text_IO.Put_Line ("REFUSED " & Ada.Exceptions.Exception_Name (E));
   end Frame;
begin
   Init (W, Little);
   if Token = "c:writer" then Put_U8 (W, 16#41#);
   elsif Token = "c:int" then Put_U16 (W, 16#1234#);
   elsif Token = "negative-u16" then Put_U16 (W, 16#CFC7#);
   elsif Token = "negative-u32" then Put_U32 (W, 16#FFED2979#);
   elsif Token = "past-2-63" then Put_U64 (W, 16#DEADBEEFDEADC2BE#);
   elsif Token = "c:float" then Put_F32 (W, 1.0);
   elsif Token = "negative-zero-f32" then Put_F32 (W, -0.0);
   elsif Token = "negative-zero-f64" then Put_F64 (W, -0.0);
   elsif Token = "c:char" then Put_Char (W, 16#41#);
   elsif Token = "char-above-8-bit" then Put_Char (W, 16#100#);
   elsif Token = "c:wchar" then Put_Wchar (W, 16#41#);
   elsif Token = "wchar-above-bmp" then Put_Wchar (W, 16#1D11E#);
   elsif Token = "c:emheader" then
      EMHeader_Begin (W, 1, False, LC4, Start);
      Put_U32 (W, 0);
      EMHeader_End (W, Start, LC4);
   elsif Token = "member-id-past-28-bit" then
      EMHeader_Begin (W, 16#10000000#, False, LC4, Start);
      Put_U32 (W, 0);
      EMHeader_End (W, Start, LC4);
   elsif Token = "lc-body-size-mismatch" then
      EMHeader_Begin (W, 1, False, LC1, Start);
      Put_U8 (W, 1); Put_U8 (W, 2); Put_U8 (W, 3);
      EMHeader_End (W, Start, LC1);
   elsif Token = "c:pid" then
      Pid_Begin (W, 16#3F00#, False, Head);
      Put_U32 (W, 0);
      Pid_End (W, Head);
   elsif Token = "short-pid-past-0x3f00" then
      Pid_Begin (W, 16#3F01#, False, Head);
      Put_U32 (W, 0);
      Pid_End (W, Head);
   elsif Token = "c:fixed" then Put_Fixed (W, "1.00", 5, 2);
   elsif Token = "fixed-digits-past-31" then Put_Fixed (W, "1.00", 32, 2);
   elsif Token = "fixed-scale-past-digits" then Put_Fixed (W, "1.00", 5, 6);
   elsif Token = "c:bitset" then Put_Bitset (W, 16#1234#, 2);
   elsif Token = "bitset-anchor-width" then Put_Bitset (W, 16#222111#, 4);
   elsif Token = "c:frame" then Frame (4); return;
   elsif Token = "frame-past-0xffff" then Frame (65536); return;
   else
      Ada.Text_IO.Put_Line ("BROKEN the ada-native probe has no case for " & Token);
      return;
   end if;
   Emit;
exception
   when E : others =>
      Ada.Text_IO.Put_Line ("REFUSED " & Ada.Exceptions.Exception_Name (E));
end Probe;
EOF
    (cd "$work/adanative" && gnatmake -q -gnat2022 -D "$work/adanative" \
        -aI"$root/endpoints/ada-native/src" -o probe probe.adb) \
        > "$work/adanative/build.log" 2>&1 || {
        build_bad ada-native "$(first_error_line "$work/adanative/build.log")"; return 1; }
    build_ok ada-native
}

adanative_over() {
    local put lit dir="$work/adanative-${1//:/_}"
    case "$1" in
        over-u8|c:over-u8)   put=Put_U8 ;;
        over-u16|c:over-u16) put=Put_U16 ;;
        over-u32|c:over-u32) put=Put_U32 ;;
    esac
    case "$1" in
        over-u8)  lit=256 ;;         c:over-u8)  lit=16#12# ;;
        over-u16) lit=70000 ;;       c:over-u16) lit=16#1234# ;;
        over-u32) lit=4294967296 ;;  c:over-u32) lit=16#12345678# ;;
    esac
    mkdir -p "$dir"
    cat > "$dir/probe.adb" <<EOF
with Ada.Exceptions;
with Ada.Text_IO;
with Zerodds_Native_Wire; use Zerodds_Native_Wire;
procedure Probe is
   W    : Writer;
   Digs : constant String := "0123456789abcdef";
begin
   Init (W, Little);
   $put (W, $lit);
   declare
      Out_Bytes : constant Byte_Array := Bytes (W);
   begin
      for B of Out_Bytes loop
         Ada.Text_IO.Put (Digs (Natural (B) / 16 + 1));
         Ada.Text_IO.Put (Digs (Natural (B) mod 16 + 1));
      end loop;
   end;
   Ada.Text_IO.New_Line;
exception
   when E : others =>
      Ada.Text_IO.Put_Line ("REFUSED " & Ada.Exceptions.Exception_Name (E));
end Probe;
EOF
    local rc=0
    (cd "$dir" && gnatmake -q -gnat2022 -D "$dir" \
        -aI"$root/endpoints/ada-native/src" -o probe probe.adb) \
        > "$dir/build.log" 2>&1 || rc=$?
    if [ "$rc" != 0 ]; then echo "REFUSED $(first_error_line "$dir/build.log")"; return; fi
    run_native ada-native "$dir/probe"
}

probe_ada_native() {
    case "$1" in over-u*|c:over-u*) adanative_over "$1"; return ;; esac
    adanative_build || { echo "BROKEN $(cat "$work/ada-native/.bad")"; return; }
    run_native ada-native "$work/adanative/probe" "$1"
}

# =====================================================================
# The eight wire-runtime columns.
#
# A different surface from the endpoint SDKs: `write_u8` .. `write_u64`,
# `write_char`/`write_wchar`, `write_emheader`/`finish_emheader`,
# `write_pid`/`finish_pid`, `write_bitset`, `write_fixed`. No frame
# writer — DDS-XRCE framing is the endpoint SDKs' — which is the one
# `n/a` every runtime column carries.
# =====================================================================

# --- rt-python --------------------------------------------------------

probe_rt_python() {
    mkdir -p "$work/rtpython"
    cat > "$work/rtpython/probe.py" <<'EOF'
import sys

from zerodds_wire import Endianness, ParameterRole
from zerodds_wire.writer import Writer

token = sys.argv[1]
w = Writer(Endianness.LITTLE, 4)
try:
    if token == "c:writer":
        w.write_u8(0x41)
    elif token == "c:int":
        w.write_u16(0x1234)
    elif token == "negative-u16":
        w.write_u16(0xCFC7)
    elif token == "negative-u32":
        w.write_u32(0xFFED2979)
    elif token == "past-2-63":
        w.write_u64(0xDEADBEEFDEADC2BE)
    elif token == "c:float":
        w.write_f32(1.0)
    elif token == "negative-zero-f32":
        w.write_f32(-0.0)
    elif token == "negative-zero-f64":
        w.write_f64(-0.0)
    elif token == "c:char":
        w.write_char("A")
    elif token == "char-above-8-bit":
        w.write_char("Ā")
    elif token == "c:wchar":
        w.write_wchar("A")
    elif token == "wchar-above-bmp":
        w.write_wchar("\U0001D11E")
    elif token == "c:emheader":
        h = w.write_emheader(1, 4, False)
        w.write_u32(0)
        w.finish_emheader(h)
    elif token == "member-id-past-28-bit":
        h = w.write_emheader(0x10000000, 4, False)
        w.write_u32(0)
        w.finish_emheader(h)
    elif token == "lc-body-size-mismatch":
        h = w.write_emheader(1, 1, False)
        w.write_u8(1)
        w.write_u8(2)
        w.write_u8(3)
        w.finish_emheader(h)
    elif token == "c:pid":
        p = w.write_pid(0x3F00, ParameterRole.MEMBER, False)
        w.write_u32(0)
        w.finish_pid(p)
    elif token == "short-pid-past-0x3f00":
        p = w.write_pid(0x3F01, ParameterRole.MEMBER, False)
        w.write_u32(0)
        w.finish_pid(p)
    elif token == "c:fixed":
        w.write_fixed("1.00", 5, 2)
    elif token == "fixed-digits-past-31":
        w.write_fixed("1.00", 32, 2)
    elif token == "fixed-scale-past-digits":
        w.write_fixed("1.00", 5, 6)
    elif token == "c:bitset":
        w.write_bitset(0x1234, 2)
    elif token == "bitset-anchor-width":
        w.write_bitset(0x222111, 4)
    elif token == "over-u8":
        w.write_u8(256)
    elif token == "c:over-u8":
        w.write_u8(0x12)
    elif token == "over-u16":
        w.write_u16(70000)
    elif token == "c:over-u16":
        w.write_u16(0x1234)
    elif token == "over-u32":
        w.write_u32(4294967296)
    elif token == "c:over-u32":
        w.write_u32(0x12345678)
    else:
        print("BROKEN the rt-python probe has no case for " + token)
        raise SystemExit(0)
    print(w.as_bytes().hex())
except Exception as e:  # noqa: BLE001 — the binding's refusal, in its words
    print("REFUSED " + type(e).__name__ + ": " + str(e))
EOF
    PYTHONPATH="$root/runtime/python" run_native rt-python python3 \
        "$work/rtpython/probe.py" "$1"
}

