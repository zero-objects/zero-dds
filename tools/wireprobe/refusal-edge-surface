rt_zig_framing() {
    cat <<'EOF'
    const framing = zd.PlCdr1Framing{
        .pid_flags = "sentinel-must-understand",
        .highest_short_id = 0x3F00,
        .pad_declared_length = false,
        .pad_declared_optional_length = false,
        .member_must_understand = true,
        .pad_after_value = true,
    };
EOF
}

rt_zig_build() {
    build_state rt-zig; case $? in 0) return 0 ;; 2) return 1 ;; esac
    mkdir -p "$work/rtzig"
    cp "$root/runtime/zig/zdwire.zig" "$work/rtzig/"
    {
        cat <<'EOF'
const std = @import("std");
const zd = @import("zdwire.zig");

fn refused(out: *std.Io.Writer, e: anyerror) !void {
    try out.print("REFUSED {s}\n", .{@errorName(e)});
}

pub fn main(zd_init: std.process.Init) !void {
    const alloc = zd_init.arena.allocator();
    const args = try zd_init.minimal.args.toSlice(alloc);
    const token = args[1];
    var stdout_buf: [4096]u8 = undefined;
    var stdout_file = std.Io.File.stdout().writer(zd_init.io, &stdout_buf);
    const out = &stdout_file.interface;
    defer out.flush() catch {};
EOF
        rt_zig_framing
        cat <<'EOF'
    var w = zd.Writer.init(alloc, .little, 4, framing, false);
    const eq = std.mem.eql;
    if (eq(u8, token, "c:writer")) {
        w.writeU8(0x41) catch |e| return refused(out, e);
    } else if (eq(u8, token, "c:int")) {
        w.writeU16(0x1234) catch |e| return refused(out, e);
    } else if (eq(u8, token, "negative-u16")) {
        w.writeU16(0xcfc7) catch |e| return refused(out, e);
    } else if (eq(u8, token, "negative-u32")) {
        w.writeU32(0xffed2979) catch |e| return refused(out, e);
    } else if (eq(u8, token, "past-2-63")) {
        w.writeU64(0xdeadbeefdeadc2be) catch |e| return refused(out, e);
    } else if (eq(u8, token, "c:float")) {
        w.writeF32(1.0) catch |e| return refused(out, e);
    } else if (eq(u8, token, "negative-zero-f32")) {
        w.writeF32(-0.0) catch |e| return refused(out, e);
    } else if (eq(u8, token, "negative-zero-f64")) {
        w.writeF64(-0.0) catch |e| return refused(out, e);
    } else if (eq(u8, token, "c:char")) {
        w.writeChar(zd.checkedChar(0x41) catch |e| return refused(out, e)) catch |e| return refused(out, e);
    } else if (eq(u8, token, "char-above-8-bit")) {
        w.writeChar(zd.checkedChar(0x100) catch |e| return refused(out, e)) catch |e| return refused(out, e);
    } else if (eq(u8, token, "c:wchar")) {
        const u = zd.checkedWchar(0x41) catch |e| return refused(out, e);
        w.writeWchar(u, 2, "fixed", "stream") catch |e| return refused(out, e);
    } else if (eq(u8, token, "wchar-above-bmp")) {
        const u = zd.checkedWchar(0x1D11E) catch |e| return refused(out, e);
        w.writeWchar(u, 2, "fixed", "stream") catch |e| return refused(out, e);
    } else if (eq(u8, token, "c:emheader")) {
        const h = w.writeEmheader(1, 4, false) catch |e| return refused(out, e);
        w.writeU32(0) catch |e| return refused(out, e);
        w.finishEmheader(h) catch |e| return refused(out, e);
    } else if (eq(u8, token, "member-id-past-28-bit")) {
        const h = w.writeEmheader(0x10000000, 4, false) catch |e| return refused(out, e);
        w.writeU32(0) catch |e| return refused(out, e);
        w.finishEmheader(h) catch |e| return refused(out, e);
    } else if (eq(u8, token, "lc-body-size-mismatch")) {
        const h = w.writeEmheader(1, 1, false) catch |e| return refused(out, e);
        w.writeU8(1) catch |e| return refused(out, e);
        w.writeU8(2) catch |e| return refused(out, e);
        w.writeU8(3) catch |e| return refused(out, e);
        w.finishEmheader(h) catch |e| return refused(out, e);
    } else if (eq(u8, token, "c:pid")) {
        const p = w.writePid(0x3F00, .member, false) catch |e| return refused(out, e);
        w.writeU32(0) catch |e| return refused(out, e);
        w.finishPid(p) catch |e| return refused(out, e);
    } else if (eq(u8, token, "short-pid-past-0x3f00")) {
        const p = w.writePid(0x3F01, .member, false) catch |e| return refused(out, e);
        w.writeU32(0) catch |e| return refused(out, e);
        w.finishPid(p) catch |e| return refused(out, e);
    } else if (eq(u8, token, "c:fixed")) {
        w.writeFixed("1.00", 5, 2, "declared") catch |e| return refused(out, e);
    } else if (eq(u8, token, "fixed-digits-past-31")) {
        w.writeFixed("1.00", 32, 2, "declared") catch |e| return refused(out, e);
    } else if (eq(u8, token, "fixed-scale-past-digits")) {
        w.writeFixed("1.00", 5, 6, "declared") catch |e| return refused(out, e);
    } else if (eq(u8, token, "c:bitset")) {
        w.writeBitset(2, 0x1234) catch |e| return refused(out, e);
    } else if (eq(u8, token, "bitset-anchor-width")) {
        w.writeBitset(4, 0x222111) catch |e| return refused(out, e);
    } else {
        try out.print("BROKEN the rt-zig probe has no case for {s}\n", .{token});
        return;
    }
    for (w.finish()) |b| try out.print("{x:0>2}", .{b});
    try out.print("\n", .{});
}
EOF
    } > "$work/rtzig/probe.zig"
    local rc=0
    lim "$build_secs" bash -c "cd '$work/rtzig' && '${ZIG:-zig}' build-exe \
        --global-cache-dir '$(zig_cache)' -femit-bin=probe probe.zig" \
        > /dev/null 2>&1 || rc=$?
    cp "$LIMOUT" "$work/rtzig/build.log" 2>/dev/null || true
    if [ "$rc" = 124 ]; then
        build_bad rt-zig "the build did not finish in ${build_secs}s"; return 1
    fi
    if [ ! -x "$work/rtzig/probe" ]; then
        build_bad rt-zig "$(first_error_line "$work/rtzig/build.log")"; return 1
    fi
    build_ok rt-zig
}

