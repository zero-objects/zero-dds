import std.stdio;
import zdwire;

void main(string[] args) {
    string token = args.length > 1 ? args[1] : "";
    // `PlCdr1Framing.init` leaves `highestShortID` at zero, so the
    // writer refuses every parameter id — including the control
    // row's. The specification's bound is 0x3F00 inclusive
    // (ZDW_PID_SHORT_MAX_ID in runtime/c), which is what the other
    // surfaces build their framing with.
    PlCdr1Framing zdFraming;
    zdFraming.pidFlags = "bare";
    zdFraming.highestShortID = 0x3F00;
    auto w = new Writer(Endianness.little, 4, zdFraming, false);
    try {
        switch (token) {
        case "c:writer": w.WriteU8(0x41); break;
        case "c:int": w.WriteU16(0x1234); break;
        case "negative-u16": w.WriteU16(0xcfc7); break;
        case "negative-u32": w.WriteU32(0xffed2979); break;
        case "past-2-63": w.WriteU64(0xdeadbeefdeadc2beUL); break;
        case "c:float": w.WriteF32(1.0f); break;
        case "negative-zero-f32": w.WriteF32(-0.0f); break;
        case "negative-zero-f64": w.WriteF64(-0.0); break;
        case "c:wchar": w.WriteWchar(0x41, 2, "fixed", "stream"); break;
        case "c:emheader":
            auto h1 = w.WriteEmheader(1, 4, false);
            w.WriteU32(0); w.FinishEmheader(h1); break;
        case "member-id-past-28-bit":
            auto h2 = w.WriteEmheader(0x10000000, 4, false);
            w.WriteU32(0); w.FinishEmheader(h2); break;
        case "lc-body-size-mismatch":
            auto h3 = w.WriteEmheader(1, 1, false);
            w.WriteU8(1); w.WriteU8(2); w.WriteU8(3);
            w.FinishEmheader(h3); break;
        case "c:pid":
            auto p1 = w.WritePid(0x3F00, ParameterRole.member, false);
            w.WriteU32(0); w.FinishPid(p1); break;
        case "short-pid-past-0x3f00":
            auto p2 = w.WritePid(0x3F01, ParameterRole.member, false);
            w.WriteU32(0); w.FinishPid(p2); break;
        case "c:fixed": w.WriteFixed("1.00", 5, 2, "declared"); break;
        case "fixed-digits-past-31": w.WriteFixed("1.00", 32, 2, "declared"); break;
        case "fixed-scale-past-digits": w.WriteFixed("1.00", 5, 6, "declared"); break;
        case "c:bitset": w.WriteBitset(2, 0x1234); break;
        case "bitset-anchor-width": w.WriteBitset(4, 0x222111); break;
        default:
            writeln("BROKEN the rt-d probe has no case for ", token); return;
        }
        foreach (b; w.Finish()) writef("%02x", b);
        writeln();
    } catch (Exception e) {
        writeln("REFUSED ", e.msg);
    }
}
EOF
    (cd "$work/rtd" && "${GDC:-gdc}" -I"$root/runtime/d" -o probe probe.d \
        "$root/runtime/d/zdwire.d") > "$work/rtd/build.log" 2>&1 || {
        build_bad rt-d "$(first_error_line "$work/rtd/build.log")"; return 1; }
    build_ok rt-d
}

rt_d_typed() { # $1 token
    local dir="$work/rtd-${1//:/_}" stmt
    case "$1" in
        over-u8)          stmt='w.WriteU8(256);' ;;
        c:over-u8)        stmt='w.WriteU8(0x12);' ;;
        over-u16)         stmt='w.WriteU16(70000);' ;;
        c:over-u16)       stmt='w.WriteU16(0x1234);' ;;
        over-u32)         stmt='w.WriteU32(4294967296);' ;;
        c:over-u32)       stmt='w.WriteU32(0x12345678);' ;;
        c:char)           stmt='w.WriteChar(0x41);' ;;
        char-above-8-bit) stmt='w.WriteChar(0x100);' ;;
        wchar-above-bmp)  stmt='w.WriteWchar(0x1D11E, 2, "fixed", "stream");' ;;
    esac
    mkdir -p "$dir"
    cat > "$dir/probe.d" <<EOF
import std.stdio;
import zdwire;
void main() {
    // `PlCdr1Framing.init` leaves `highestShortID` at zero, so the
    // writer refuses every parameter id — including the control
    // row's. The specification's bound is 0x3F00 inclusive
    // (ZDW_PID_SHORT_MAX_ID in runtime/c), which is what the other
    // surfaces build their framing with.
    PlCdr1Framing zdFraming;
    zdFraming.pidFlags = "bare";
    zdFraming.highestShortID = 0x3F00;
    auto w = new Writer(Endianness.little, 4, zdFraming, false);
    try {
        $stmt
        foreach (b; w.Finish()) writef("%02x", b);
        writeln();
    } catch (Exception e) {
        writeln("REFUSED ", e.msg);
    }
}
EOF
    local rc=0
    (cd "$dir" && "${GDC:-gdc}" -I"$root/runtime/d" -o probe probe.d \
        "$root/runtime/d/zdwire.d") > "$dir/build.log" 2>&1 || rc=$?
    if [ "$rc" != 0 ]; then echo "REFUSED $(first_error_line "$dir/build.log")"; return; fi
    run_native rt-d "$dir/probe"
}

probe_rt_d() {
    case "$1" in
        over-u*|c:over-u*|c:char|char-above-8-bit|wchar-above-bmp)
            rt_d_typed "$1"; return ;;
    esac
    rt_d_build || { echo "BROKEN $(cat "$work/rt-d/.bad")"; return; }
    run_native rt-d "$work/rtd/probe" "$1"
}

# --- rust-wire --------------------------------------------------------
#
# A crate of its own under the run's working directory, with the
# repository's own target directory so the dependency graph is not built
# a second time.

rust_build() {
    build_state rust-wire; case $? in 0) return 0 ;; 2) return 1 ;; esac
    mkdir -p "$work/rustwire/src"
    cat > "$work/rustwire/Cargo.toml" <<EOF
[package]
name = "zd-refusal-edge-probe"
version = "0.0.0"
edition = "2021"

[workspace]

[dependencies]
zerodds-wire = { path = "$root/crates/wire" }

[[bin]]
name = "probe"
path = "src/main.rs"
EOF
    cat > "$work/rustwire/src/main.rs" <<'EOF'
use std::panic;

use zerodds_wire::writer::{ParameterRole, Writer};

fn hex(bytes: &[u8]) -> String {
    bytes.iter().map(|b| format!("{b:02x}")).collect()
}

fn body(token: &str) -> Option<String> {
    let mut w = Writer::little_endian();
    match token {
        "c:writer" => w.write_u8(0x41),
        "c:int" => w.write_u16(0x1234),
        "negative-u16" => w.write_u16(0xcfc7),
        "negative-u32" => w.write_u32(0xffed_2979),
        "past-2-63" => w.write_u64(0xdead_beef_dead_c2be),
        "c:float" => w.write_f32(1.0),
        "negative-zero-f32" => w.write_f32(-0.0),
        "negative-zero-f64" => w.write_f64(-0.0),
        "c:char" => match w.write_char('A') {
            Ok(()) => {}
            Err(e) => return Some(format!("REFUSED {e}")),
        },
        "char-above-8-bit" => match w.write_char('\u{0100}') {
            Ok(()) => {}
            Err(e) => return Some(format!("REFUSED {e}")),
        },
        "c:wchar" => match w.write_wchar_member('A') {
            Ok(()) => {}
            Err(e) => return Some(format!("REFUSED {e}")),
        },
        "wchar-above-bmp" => match w.write_wchar_member('\u{1D11E}') {
            Ok(()) => {}
            Err(e) => return Some(format!("REFUSED {e}")),
        },
        "c:emheader" => {
            let h = match w.write_emheader(1, 4, false) {
                Ok(h) => h,
                Err(e) => return Some(format!("REFUSED {e}")),
            };
            w.write_u32(0);
            if let Err(e) = w.finish_emheader(h) {
                return Some(format!("REFUSED {e}"));
            }
        }
        "member-id-past-28-bit" => {
            let h = match w.write_emheader(0x1000_0000, 4, false) {
                Ok(h) => h,
                Err(e) => return Some(format!("REFUSED {e}")),
            };
            w.write_u32(0);
            if let Err(e) = w.finish_emheader(h) {
                return Some(format!("REFUSED {e}"));
            }
        }
        "lc-body-size-mismatch" => {
            let h = match w.write_emheader(1, 1, false) {
                Ok(h) => h,
                Err(e) => return Some(format!("REFUSED {e}")),
            };
            w.write_u8(1);
            w.write_u8(2);
            w.write_u8(3);
            if let Err(e) = w.finish_emheader(h) {
                return Some(format!("REFUSED {e}"));
            }
        }
        "c:pid" => {
            let p = match w.write_pid(0x3F00, ParameterRole::Member, false) {
                Ok(p) => p,
                Err(e) => return Some(format!("REFUSED {e}")),
            };
            w.write_u32(0);
            w.finish_pid(p);
        }
        "short-pid-past-0x3f00" => {
            let p = match w.write_pid(0x3F01, ParameterRole::Member, false) {
                Ok(p) => p,
                Err(e) => return Some(format!("REFUSED {e}")),
            };
            w.write_u32(0);
            w.finish_pid(p);
        }
        "over-u8" | "c:over-u8" | "over-u16" | "c:over-u16" | "over-u32" | "c:over-u32" => {
            unreachable!("the width rows are compiled on their own")
        }
        other => return Some(format!("BROKEN the rust-wire probe has no case for {other}")),
    }
    Some(hex(w.as_bytes()))
}

fn main() {
    let token = std::env::args().nth(1).unwrap_or_default();
    panic::set_hook(Box::new(|info| {
        println!("REFUSED {info}");
    }));
    match panic::catch_unwind(|| body(&token)) {
        Ok(Some(line)) => println!("{line}"),
        Ok(None) => println!("BROKEN the probe produced nothing"),
        Err(_) => {}
    }
}
EOF
    # The build's own exit code decides, not the file's existence: the
    # target directory is kept between runs, so a probe that no longer
    # compiles leaves the previous run's binary in place and the cells
    # would report yesterday's octets as today's. `rust_typed` below
    # already tests the code; this one tested only the file.
    local rc=0
    lim "$build_secs" env CARGO_TARGET_DIR="$root/target/refusal-edge-probe" \
        cargo build -q --manifest-path "$work/rustwire/Cargo.toml" > /dev/null 2>&1 || rc=$?
    cp "$LIMOUT" "$work/rustwire/build.log" 2>/dev/null || true
    if [ "$rc" != 0 ] || [ ! -x "$root/target/refusal-edge-probe/debug/probe" ]; then
        build_bad rust-wire "$(first_error_line "$work/rustwire/build.log")"; return 1
    fi
    build_ok rust-wire
}

rust_typed() { # $1 token
    local dir="$work/rustwire-${1//:/_}" stmt
    case "$1" in
        over-u8)    stmt='w.write_u8(256);' ;;
        c:over-u8)  stmt='w.write_u8(0x12);' ;;
        over-u16)   stmt='w.write_u16(70000);' ;;
        c:over-u16) stmt='w.write_u16(0x1234);' ;;
        over-u32)   stmt='w.write_u32(4294967296);' ;;
        c:over-u32) stmt='w.write_u32(0x12345678);' ;;
    esac
    mkdir -p "$dir/src"
    cat > "$dir/Cargo.toml" <<EOF
[package]
name = "zd-refusal-edge-typed"
version = "0.0.0"
edition = "2021"

[workspace]

[dependencies]
zerodds-wire = { path = "$root/crates/wire" }

[[bin]]
name = "typed"
path = "src/main.rs"
EOF
    cat > "$dir/src/main.rs" <<EOF
use zerodds_wire::writer::Writer;

fn main() {
    let mut w = Writer::little_endian();
    $stmt
    println!("{}", w.as_bytes().iter().map(|b| format!("{b:02x}")).collect::<String>());
}
EOF
    local rc=0
    lim "$build_secs" env CARGO_TARGET_DIR="$root/target/refusal-edge-typed" \
        cargo build -q --manifest-path "$dir/Cargo.toml" > /dev/null 2>&1 || rc=$?
    cp "$LIMOUT" "$dir/build.log" 2>/dev/null || true
    if [ "$rc" != 0 ] || [ ! -x "$root/target/refusal-edge-typed/debug/typed" ]; then
        echo "REFUSED $(first_error_line "$dir/build.log")"; return
    fi
    run_native rust-wire "$root/target/refusal-edge-typed/debug/typed"
}

probe_rust_wire() {
    case "$1" in over-u*|c:over-u*) rust_typed "$1"; return ;; esac
    rust_build || { echo "BROKEN $(cat "$work/rust-wire/.bad")"; return; }
    run_native rust-wire "$root/target/refusal-edge-probe/debug/probe" "$1"
}

# =====================================================================
# The five newest wire-runtime columns: runtime/{lua,nim,swift,zig,ada}.
#
# Not the endpoint SDKs of the same names. The endpoint spells the call
# `putU16` and takes the encoding as a constructor enum; the runtime
# spells it `writeU16` and takes MAXALIGN and the PL_CDR1 framing as
# arguments, because it is the layer a generated codec calls and the
# layout plan is what decides those. Four here (nim, zig, swift, ada)
# put the wire width in the parameter type, so `over-u8`, `over-u16` and
# `over-u32` are compiled on their own; `char-above-8-bit` and
# `wchar-above-bmp` are not, because all five export a checked
# code-point conversion (`checkedChar`, `zdCheckedChar`, `Checked_Char`)
# that takes a full 32-bit code point and is the operation the row
# names.
# =====================================================================

# --- rt-lua -----------------------------------------------------------

probe_rt_lua() {
    mkdir -p "$work/rtlua"
    cat > "$work/rtlua/probe.lua" <<'EOF'
local zdw = require('zerodds_wire')
local token = arg[1]
local w = zdw.writer_new({ endianness = 'le', max_align = 4 })
local ok, err = pcall(function()
  if token == 'c:writer' then zdw.write_u8(w, 0x41)
  elseif token == 'c:int' then zdw.write_u16(w, 0x1234)
  elseif token == 'negative-u16' then zdw.write_u16(w, 0xcfc7)
  elseif token == 'negative-u32' then zdw.write_u32(w, 0xffed2979)
  elseif token == 'past-2-63' then zdw.write_u64(w, 0xdeadbeefdeadc2be)
  elseif token == 'c:float' then zdw.write_f32(w, 1.0)
  elseif token == 'negative-zero-f32' then zdw.write_f32(w, -0.0)
  elseif token == 'negative-zero-f64' then zdw.write_f64(w, -0.0)
  elseif token == 'c:char' then zdw.write_char(w, 0x41)
  elseif token == 'char-above-8-bit' then zdw.write_char(w, 0x100)
  elseif token == 'c:wchar' then zdw.write_wchar(w, 0x41, 2, 'fixed', 'stream')
  elseif token == 'wchar-above-bmp' then zdw.write_wchar(w, 0x1D11E, 2, 'fixed', 'stream')
  elseif token == 'c:emheader' then
    local h = zdw.write_emheader(w, 1, 4, false)
    zdw.write_u32(w, 0); zdw.finish_emheader(w, h)
  elseif token == 'member-id-past-28-bit' then
    local h = zdw.write_emheader(w, 0x10000000, 4, false)
    zdw.write_u32(w, 0); zdw.finish_emheader(w, h)
  elseif token == 'lc-body-size-mismatch' then
    local h = zdw.write_emheader(w, 1, 1, false)
    zdw.write_u8(w, 1); zdw.write_u8(w, 2); zdw.write_u8(w, 3)
    zdw.finish_emheader(w, h)
  elseif token == 'c:pid' then
    local p = zdw.write_pid(w, 0x3F00, 'member', false)
    zdw.write_u32(w, 0); zdw.finish_pid(w, p)
  elseif token == 'short-pid-past-0x3f00' then
    local p = zdw.write_pid(w, 0x3F01, 'member', false)
    zdw.write_u32(w, 0); zdw.finish_pid(w, p)
  elseif token == 'c:fixed' then zdw.write_fixed(w, '1.00', 5, 2, 'declared')
  elseif token == 'fixed-digits-past-31' then zdw.write_fixed(w, '1.00', 32, 2, 'declared')
  elseif token == 'fixed-scale-past-digits' then zdw.write_fixed(w, '1.00', 5, 6, 'declared')
  elseif token == 'c:bitset' then zdw.write_bitset(w, 2, 0x1234)
  elseif token == 'bitset-anchor-width' then zdw.write_bitset(w, 4, 0x222111)
  elseif token == 'over-u8' then zdw.write_u8(w, 256)
  elseif token == 'c:over-u8' then zdw.write_u8(w, 0x12)
  elseif token == 'over-u16' then zdw.write_u16(w, 70000)
  elseif token == 'c:over-u16' then zdw.write_u16(w, 0x1234)
  elseif token == 'over-u32' then zdw.write_u32(w, 4294967296)
  elseif token == 'c:over-u32' then zdw.write_u32(w, 0x12345678)
  else
    print('BROKEN the rt-lua probe has no case for ' .. tostring(token))
    return 'none'
  end
  return 'octets'
end)
if not ok then
  print('REFUSED ' .. tostring(err))
elseif err == 'octets' then
  print((zdw.finish(w):gsub('.', function(c) return string.format('%02x', c:byte()) end)))
end
EOF
    LUA_PATH="$root/runtime/lua/?.lua;$root/runtime/lua/?/init.lua;;" \
        run_native rt-lua lua "$work/rtlua/probe.lua" "$1"
}

# --- rt-elixir --------------------------------------------------------
#
# `runtime/elixir` is a mix project and its `Writer` is a persistent
# struct: every operation answers the state it advanced, and the two
# header openers answer a `{handle, writer}` pair. So the probe threads
# rather than mutates, and a row's operation is one expression.
#
# The runtime's `.beam` files are compiled once into the work directory
# and reused across the seventeen rows; `elixir -pa` puts them on the
# code path. A refusal is a raised `ZeroddsWire.WireError`, which is why
# the whole body sits in a `try`.

probe_rt_elixir() {
    mkdir -p "$work/rtelixir/ebin"
    if [ ! -f "$work/rtelixir/ebin/.built" ]; then
        if ! (cd "$root/runtime/elixir" && lim "$build_secs" elixirc \
                -o "$work/rtelixir/ebin" lib/zerodds_wire.ex lib/zerodds_wire/*.ex) \
                > "$work/rtelixir/build.log" 2>&1; then
            echo "BROKEN $(first_error_line "$work/rtelixir/build.log")"
            return
        fi
        : > "$work/rtelixir/ebin/.built"
    fi
    cat > "$work/rtelixir/probe.exs" <<'EOF'
alias ZeroddsWire.Writer
token = List.first(System.argv())
w = Writer.new(:le, 4)

result =
  try do
    case token do
      "c:writer" -> {:octets, Writer.write_u8(w, 0x41)}
      "c:int" -> {:octets, Writer.write_u16(w, 0x1234)}
      "negative-u16" -> {:octets, Writer.write_u16(w, 0xCFC7)}
      "negative-u32" -> {:octets, Writer.write_u32(w, 0xFFED2979)}
      "past-2-63" -> {:octets, Writer.write_u64(w, 0xDEADBEEFDEADC2BE)}
      "c:float" -> {:octets, Writer.write_f32(w, 1.0)}
      "negative-zero-f32" -> {:octets, Writer.write_f32(w, -0.0)}
      "negative-zero-f64" -> {:octets, Writer.write_f64(w, -0.0)}
      "c:char" -> {:octets, Writer.write_char(w, "A")}
      "char-above-8-bit" -> {:octets, Writer.write_char(w, "\u0100")}
      "c:wchar" -> {:octets, Writer.write_wchar(w, "A", 2, :fixed, :stream)}
      "wchar-above-bmp" -> {:octets, Writer.write_wchar(w, "\u{1D11E}", 2, :fixed, :stream)}
      "c:emheader" ->
        {h, w} = Writer.write_emheader(w, 1, 4, false)
        {:octets, w |> Writer.write_u32(0) |> Writer.finish_emheader(h)}

      "member-id-past-28-bit" ->
        {h, w} = Writer.write_emheader(w, 0x10000000, 4, false)
        {:octets, w |> Writer.write_u32(0) |> Writer.finish_emheader(h)}

      "lc-body-size-mismatch" ->
        {h, w} = Writer.write_emheader(w, 1, 1, false)
        w = w |> Writer.write_u8(1) |> Writer.write_u8(2) |> Writer.write_u8(3)
        {:octets, Writer.finish_emheader(w, h)}

      "c:pid" ->
        {p, w} = Writer.write_pid(w, 0x3F00, :member, false)
        {:octets, w |> Writer.write_u32(0) |> Writer.finish_pid(p)}

      "short-pid-past-0x3f00" ->
        {p, w} = Writer.write_pid(w, 0x3F01, :member, false)
        {:octets, w |> Writer.write_u32(0) |> Writer.finish_pid(p)}

      "c:fixed" -> {:octets, Writer.write_fixed(w, "1.00", 5, 2, :declared)}
      "fixed-digits-past-31" -> {:octets, Writer.write_fixed(w, "1.00", 32, 2, :declared)}
      "fixed-scale-past-digits" -> {:octets, Writer.write_fixed(w, "1.00", 5, 6, :declared)}
      "c:bitset" -> {:octets, Writer.write_bitset(w, 2, 0x1234)}
      "bitset-anchor-width" -> {:octets, Writer.write_bitset(w, 4, 0x222111)}
      "over-u8" -> {:octets, Writer.write_u8(w, 256)}
      "c:over-u8" -> {:octets, Writer.write_u8(w, 0x12)}
      "over-u16" -> {:octets, Writer.write_u16(w, 70000)}
      "c:over-u16" -> {:octets, Writer.write_u16(w, 0x1234)}
      "over-u32" -> {:octets, Writer.write_u32(w, 4_294_967_296)}
      "c:over-u32" -> {:octets, Writer.write_u32(w, 0x12345678)}
      other -> {:none, other}
    end
  rescue
    error -> {:refused, Exception.message(error)}
  end

case result do
  {:octets, w} -> IO.puts(Base.encode16(Writer.finish(w), case: :lower))
  {:refused, why} -> IO.puts("REFUSED " <> why)
  {:none, other} -> IO.puts("BROKEN the rt-elixir probe has no case for #{inspect(other)}")
end
EOF
    run_native rt-elixir elixir -pa "$work/rtelixir/ebin" \
        "$work/rtelixir/probe.exs" "$1"
}

# --- rt-nim -----------------------------------------------------------

# The framing every probe below builds: the clause's, which is what a
# reader with no stated framing expects. None of the five runtimes
# defaults it — the layout plan is what decides — so each probe states
# all six fields rather than leaving the driver's own habits in them.
probe_rt_nim() {
    case "$1" in over-u*|c:over-u*) rt_nim_typed "$1"; return ;; esac
    rt_nim_build || { echo "BROKEN $(cat "$work/rt-nim/.bad")"; return; }
    run_native rt-nim "$work/rtnim/probe" "$1"
}

rt_nim_build() {
    build_state rt-nim; case $? in 0) return 0 ;; 2) return 1 ;; esac
    mkdir -p "$work/rtnim"
    cat > "$work/rtnim/probe.nim" <<'EOF'
import os, strutils
import zdwire

let framing = PlCdr1Framing(
  pidFlags: "sentinel-must-understand", highestShortId: 0x3F00,
  padDeclaredLength: false, padDeclaredOptionalLength: false,
  memberMustUnderstand: true, padAfterValue: true)

let token = paramStr(1)
var w = newWriter(EndianLittle, 4, framing, false)
try:
  case token
  of "c:writer": w.writeU8(0x41'u8)
  of "c:int": w.writeU16(0x1234'u16)
  of "negative-u16": w.writeU16(0xcfc7'u16)
  of "negative-u32": w.writeU32(0xffed2979'u32)
  of "past-2-63": w.writeU64(0xdeadbeefdeadc2be'u64)
  of "c:float": w.writeF32(1.0'f32)
  of "negative-zero-f32": w.writeF32(-0.0'f32)
  of "negative-zero-f64": w.writeF64(-0.0'f64)
  of "c:char": w.writeChar(checkedChar(0x41'u32))
  of "char-above-8-bit": w.writeChar(checkedChar(0x100'u32))
  of "c:wchar": w.writeWchar(checkedWchar(0x41'u32), 2, "fixed", "stream")
  of "wchar-above-bmp": w.writeWchar(checkedWchar(0x1D11E'u32), 2, "fixed", "stream")
  of "c:emheader":
    let h = w.writeEmheader(1, 4, false)
    w.writeU32(0'u32); w.finishEmheader(h)
  of "member-id-past-28-bit":
    let h = w.writeEmheader(0x10000000, 4, false)
    w.writeU32(0'u32); w.finishEmheader(h)
  of "lc-body-size-mismatch":
    let h = w.writeEmheader(1, 1, false)
    w.writeU8(1'u8); w.writeU8(2'u8); w.writeU8(3'u8)
    w.finishEmheader(h)
  of "c:pid":
    let p = w.writePid(0x3F00, ParameterMember, false)
    w.writeU32(0'u32); w.finishPid(p)
  of "short-pid-past-0x3f00":
    let p = w.writePid(0x3F01, ParameterMember, false)
    w.writeU32(0'u32); w.finishPid(p)
  of "c:fixed": w.writeFixed("1.00", 5, 2, "declared")
  of "fixed-digits-past-31": w.writeFixed("1.00", 32, 2, "declared")
  of "fixed-scale-past-digits": w.writeFixed("1.00", 5, 6, "declared")
  of "c:bitset": w.writeBitset(2, 0x1234'u64)
  of "bitset-anchor-width": w.writeBitset(4, 0x222111'u64)
  else:
    echo "BROKEN the rt-nim probe has no case for ", token; quit(0)
  var s = ""
  for b in w.finish(): s.add(toLowerAscii(toHex(int(b), 2)))
  echo s
except CatchableError as e:
  echo "REFUSED ", e.msg
EOF
    local rc=0
    lim "$build_secs" bash -c "cd '$work/rtnim' && '${NIM:-nim}' c --hints:off \
        --colors:off --nimcache:'$work/rtnim/cache' --path:'$root/runtime/nim' \
        -o:probe probe.nim" > /dev/null 2>&1 || rc=$?
    cp "$LIMOUT" "$work/rtnim/build.log" 2>/dev/null || true
    if [ "$rc" = 124 ]; then
        build_bad rt-nim "the build did not finish in ${build_secs}s"; return 1
    fi
    if [ ! -x "$work/rtnim/probe" ]; then
        build_bad rt-nim "$(first_error_line "$work/rtnim/build.log")"; return 1
    fi
    build_ok rt-nim
}

rt_nim_typed() { # $1 token — the widths `writeU8`/`writeU16`/`writeU32` type
    local put lit dir="$work/rtnim-${1//:/_}"
    case "$1" in
        over-u8|c:over-u8)   put=writeU8 ;;
        over-u16|c:over-u16) put=writeU16 ;;
        over-u32|c:over-u32) put=writeU32 ;;
    esac
    case "$1" in
        over-u8)  lit=256 ;;         c:over-u8)  lit=0x12 ;;
        over-u16) lit=70000 ;;       c:over-u16) lit=0x1234 ;;
        over-u32) lit=4294967296 ;;  c:over-u32) lit=0x12345678 ;;
    esac
    mkdir -p "$dir"
    cat > "$dir/probe.nim" <<EOF
import strutils
import zdwire
let framing = PlCdr1Framing(
  pidFlags: "sentinel-must-understand", highestShortId: 0x3F00,
  padDeclaredLength: false, padDeclaredOptionalLength: false,
  memberMustUnderstand: true, padAfterValue: true)
var w = newWriter(EndianLittle, 4, framing, false)
try:
  w.$put($lit)
  var s = ""
  for b in w.finish(): s.add(toLowerAscii(toHex(int(b), 2)))
  echo s
except CatchableError as e:
  echo "REFUSED ", e.msg
EOF
    local rc=0
    lim "$build_secs" bash -c "cd '$dir' && '${NIM:-nim}' c --hints:off --colors:off \
        --nimcache:'$dir/cache' --path:'$root/runtime/nim' -o:probe probe.nim" \
        > /dev/null 2>&1 || rc=$?
    cp "$LIMOUT" "$dir/build.log" 2>/dev/null || true
    # A build that ran out of time is not a refusal. Only a compiler that
    # finished and said no is the binding's answer.
    if [ "$rc" = 124 ]; then echo "TIMEOUT"; return; fi
    # The compiler's exit status decides, not the file: `zig build-exe`
    # leaves an empty, executable `probe` behind when it refuses, which
    # `-x` read as a built program and reported as a broken probe.
    if [ "$rc" != 0 ] || [ ! -s "$dir/probe" ]; then echo "REFUSED $(first_error_line "$dir/build.log")"; return; fi
    run_native rt-nim "$dir/probe"
}

