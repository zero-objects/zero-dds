rt_go_build() {
    build_state rt-go; case $? in 0) return 0 ;; 2) return 1 ;; esac
    mkdir -p "$work/rtgo"
    local mod; mod="$(awk '/^module /{print $2; exit}' "$root/runtime/go/go.mod")"
    cat > "$work/rtgo/go.mod" <<EOF
module zdedgesurfacert

go 1.19

require $mod v0.0.0

replace $mod => $root/runtime/go
EOF
    cat > "$work/rtgo/main.go" <<EOF
package main

import (
	"fmt"
	"math"
	"os"

	wire "$mod"
)
EOF
    cat >> "$work/rtgo/main.go" <<'EOF'

func main() {
	defer func() {
		if r := recover(); r != nil {
			fmt.Printf("REFUSED %v\n", r)
		}
	}()
	w := wire.NewWriter(wire.LittleEndian, 4, wire.SpecificationFraming(), false)
	switch os.Args[1] {
	case "c:writer":
		w.WriteU8(0x41)
	case "c:int":
		w.WriteU16(0x1234)
	case "negative-u16":
		w.WriteU16(0xcfc7)
	case "negative-u32":
		w.WriteU32(0xffed2979)
	case "past-2-63":
		w.WriteU64(0xdeadbeefdeadc2be)
	case "c:float":
		w.WriteF32(1.0)
	case "negative-zero-f32":
		w.WriteF32(float32(math.Copysign(0, -1)))
	case "negative-zero-f64":
		w.WriteF64(math.Copysign(0, -1))
	case "c:char":
		w.WriteChar(0x41)
	case "c:wchar":
		w.WriteWchar(0x41, 2, "fixed", "stream")
	case "c:emheader":
		h := w.WriteEmheader(1, 4, false)
		w.WriteU32(0)
		w.FinishEmheader(h)
	case "member-id-past-28-bit":
		h := w.WriteEmheader(0x10000000, 4, false)
		w.WriteU32(0)
		w.FinishEmheader(h)
	case "lc-body-size-mismatch":
		h := w.WriteEmheader(1, 1, false)
		w.WriteU8(1)
		w.WriteU8(2)
		w.WriteU8(3)
		w.FinishEmheader(h)
	case "c:pid":
		p := w.WritePid(0x3F00, wire.ParameterMember, false)
		w.WriteU32(0)
		w.FinishPid(p)
	case "short-pid-past-0x3f00":
		p := w.WritePid(0x3F01, wire.ParameterMember, false)
		w.WriteU32(0)
		w.FinishPid(p)
	case "c:fixed":
		w.WriteFixed("1.00", 5, 2, "declared")
	case "fixed-digits-past-31":
		w.WriteFixed("1.00", 32, 2, "declared")
	case "fixed-scale-past-digits":
		w.WriteFixed("1.00", 5, 6, "declared")
	case "c:bitset":
		w.WriteBitset(2, 0x1234)
	case "bitset-anchor-width":
		w.WriteBitset(4, 0x222111)
	default:
		fmt.Printf("BROKEN the rt-go probe has no case for %s\n", os.Args[1])
		return
	}
	fmt.Printf("%x\n", w.Finish())
}
EOF
    (go_env; cd "$work/rtgo" && go build -o probe .) > "$work/rtgo/build.log" 2>&1 || {
        build_bad rt-go "$(first_error_line "$work/rtgo/build.log")"; return 1; }
    build_ok rt-go
}

rt_go_typed() { # $1 token — the rows whose argument the parameter type decides
    local dir="$work/rtgo-${1//:/_}" stmt
    local mod; mod="$(awk '/^module /{print $2; exit}' "$root/runtime/go/go.mod")"
    case "$1" in
        over-u8)              stmt='w.WriteU8(256)' ;;
        c:over-u8)            stmt='w.WriteU8(0x12)' ;;
        over-u16)             stmt='w.WriteU16(70000)' ;;
        c:over-u16)           stmt='w.WriteU16(0x1234)' ;;
        over-u32)             stmt='w.WriteU32(4294967296)' ;;
        c:over-u32)           stmt='w.WriteU32(0x12345678)' ;;
        char-above-8-bit)     stmt='w.WriteChar(0x100)' ;;
        wchar-above-bmp)      stmt='w.WriteWchar(0x1D11E, 2, "fixed", "stream")' ;;
    esac
    mkdir -p "$dir"
    cat > "$dir/go.mod" <<EOF
module zdedgetyped

go 1.19

require $mod v0.0.0

replace $mod => $root/runtime/go
EOF
    cat > "$dir/main.go" <<EOF
package main

import (
	"fmt"

	wire "$mod"
)

func main() {
	defer func() {
		if r := recover(); r != nil {
			fmt.Printf("REFUSED %v\n", r)
		}
	}()
	w := wire.NewWriter(wire.LittleEndian, 4, wire.SpecificationFraming(), false)
	$stmt
	fmt.Printf("%x\n", w.Finish())
}
EOF
    local rc=0
    (go_env; cd "$dir" && go build -o probe .) > "$dir/build.log" 2>&1 || rc=$?
    if [ "$rc" != 0 ]; then echo "REFUSED $(first_error_line "$dir/build.log")"; return; fi
    run_native rt-go "$dir/probe"
}

probe_rt_go() {
    case "$1" in
        over-u*|c:over-u*|char-above-8-bit|wchar-above-bmp)
            rt_go_typed "$1"; return ;;
    esac
    rt_go_build || { echo "BROKEN $(cat "$work/rt-go/.bad")"; return; }
    run_native rt-go "$work/rtgo/probe" "$1"
}

# --- rt-typescript ----------------------------------------------------
#
# Compiled from `runtime/typescript/src`, not from its `dist/`: the
# checked-in `dist/` has no `policy.js`, so `require`-ing it fails on
# `index.js`'s own re-export before a probe reaches the writer.

rt_ts_build() {
    build_state rt-typescript; case $? in 0) return 0 ;; 2) return 1 ;; esac
    mkdir -p "$work/rtts"
    mkdir -p "$work/rtts/src"
    cp "$root"/runtime/typescript/src/*.ts "$work/rtts/src/"
    cat > "$work/rtts/src/probe.ts" <<'EOF'
import { Endianness } from "./endianness.js";
import { FixedDigitCount, ParameterRole } from "./policy.js";
import { Writer } from "./writer.js";

const token = process.argv[2];
const w = new Writer(Endianness.Little, 4);
const hex = (b: Uint8Array) =>
  Array.from(b).map((x) => x.toString(16).padStart(2, "0")).join("");
try {
  switch (token) {
    case "c:writer": w.writeU8(0x41); break;
    case "c:int": w.writeU16(0x1234); break;
    case "negative-u16": w.writeU16(0xcfc7); break;
    case "negative-u32": w.writeU32(0xffed2979); break;
    case "past-2-63": w.writeU64(0xdeadbeefdeadc2ben); break;
    case "c:float": w.writeF32(1.0); break;
    case "negative-zero-f32": w.writeF32(-0.0); break;
    case "negative-zero-f64": w.writeF64(-0.0); break;
    case "c:char": w.writeChar("A"); break;
    case "char-above-8-bit": w.writeChar("Ā"); break;
    case "c:wchar": w.writeWchar("A"); break;
    case "wchar-above-bmp": w.writeWchar("\u{1D11E}"); break;
    case "c:emheader": {
      const h = w.writeEmheader(1, 4, false); w.writeU32(0); w.finishEmheader(h); break;
    }
    case "member-id-past-28-bit": {
      const h = w.writeEmheader(0x10000000, 4, false); w.writeU32(0); w.finishEmheader(h); break;
    }
    case "lc-body-size-mismatch": {
      const h = w.writeEmheader(1, 1, false);
      w.writeU8(1); w.writeU8(2); w.writeU8(3);
      w.finishEmheader(h); break;
    }
    case "c:pid": {
      const p = w.writePid(0x3f00, ParameterRole.Member, false);
      w.writeU32(0); w.finishPid(p); break;
    }
    case "short-pid-past-0x3f00": {
      const p = w.writePid(0x3f01, ParameterRole.Member, false);
      w.writeU32(0); w.finishPid(p); break;
    }
    case "c:fixed": w.writeFixed("1.00", 5, 2, FixedDigitCount.Declared); break;
    case "fixed-digits-past-31": w.writeFixed("1.00", 32, 2, FixedDigitCount.Declared); break;
    case "fixed-scale-past-digits": w.writeFixed("1.00", 5, 6, FixedDigitCount.Declared); break;
    case "c:bitset": w.writeBitset(2, 0x1234n); break;
    case "bitset-anchor-width": w.writeBitset(4, 0x222111n); break;
    case "over-u8": w.writeU8(256); break;
    case "c:over-u8": w.writeU8(0x12); break;
    case "over-u16": w.writeU16(70000); break;
    case "c:over-u16": w.writeU16(0x1234); break;
    case "over-u32": w.writeU32(4294967296); break;
    case "c:over-u32": w.writeU32(0x12345678); break;
    default:
      console.log("BROKEN the rt-typescript probe has no case for " + token);
      process.exit(0);
  }
  console.log(hex(w.finish()));
} catch (e) {
  console.log("REFUSED " + (e instanceof Error ? e.message : String(e)));
}
EOF
    cat > "$work/rtts/tsconfig.json" <<'EOF'
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "outDir": "out",
    "rootDir": "src"
  },
  "include": ["src/*.ts"]
}
EOF
    # `NodeNext` resolves the runtime's own `./x.js` specifiers, and node
    # reads the module kind of the emitted `.js` from the nearest
    # `package.json`. The runtime's `tsconfig.json` is copied rather than
    # relaxed: a probe compiled under looser settings is not the module
    # a consumer gets.
    printf '{"type":"module"}\n' > "$work/rtts/package.json"
    lim "$build_secs" bash -c "cd '$work/rtts' && '${TSC:-tsc}' -p tsconfig.json" \
        > /dev/null 2>&1
    cp "$LIMOUT" "$work/rtts/build.log" 2>/dev/null || true
    if [ ! -f "$work/rtts/out/probe.js" ]; then
        build_bad rt-typescript "$(first_error_line "$work/rtts/build.log")"; return 1
    fi
    printf '{"type":"module"}\n' > "$work/rtts/out/package.json"
    build_ok rt-typescript
}

probe_rt_typescript() {
    rt_ts_build || { echo "BROKEN $(cat "$work/rt-typescript/.bad")"; return; }
    run_native rt-typescript "${NODE:-node}" "$work/rtts/out/probe.js" "$1"
}

# --- rt-java ----------------------------------------------------------

rt_java_build() {
    build_state rt-java; case $? in 0) return 0 ;; 2) return 1 ;; esac
    mkdir -p "$work/rtjava"
    cat > "$work/rtjava/Probe.java" <<'EOF'
import org.zerodds.wire.Endianness;
import org.zerodds.wire.FixedDigitCount;
import org.zerodds.wire.ParameterRole;
import org.zerodds.wire.WcharFraming;
import org.zerodds.wire.WcharWidth;
import org.zerodds.wire.Writer;
import org.zerodds.wire.WstringUnitOrder;

public final class Probe {
    private Probe() { }

    public static void main(String[] args) {
        String token = args[0];
        Writer w = new Writer(Endianness.LITTLE, 4, null, false);
        try {
            if (token.equals("c:writer")) {
                w.writeU8(0x41);
            } else if (token.equals("c:int")) {
                w.writeU16(0x1234);
            } else if (token.equals("negative-u16")) {
                w.writeU16(0xcfc7);
            } else if (token.equals("negative-u32")) {
                w.writeU32(0xffed2979L);
            } else if (token.equals("past-2-63")) {
                w.writeU64(0xdeadbeefdeadc2beL);
            } else if (token.equals("c:float")) {
                w.writeF32(1.0);
            } else if (token.equals("negative-zero-f32")) {
                w.writeF32(-0.0f);
            } else if (token.equals("negative-zero-f64")) {
                w.writeF64(-0.0);
            } else if (token.equals("c:char")) {
                w.writeChar(0x41);
            } else if (token.equals("char-above-8-bit")) {
                w.writeChar(0x100);
            } else if (token.equals("c:wchar")) {
                w.writeWchar(0x41, WcharWidth.OCTETS_2, WcharFraming.FIXED, WstringUnitOrder.STREAM);
            } else if (token.equals("wchar-above-bmp")) {
                w.writeWchar(0x1D11E, WcharWidth.OCTETS_2, WcharFraming.FIXED, WstringUnitOrder.STREAM);
            } else if (token.equals("c:emheader")) {
                Writer.EmHeader h = w.writeEmheader(1, 4, false);
                w.writeU32(0);
                w.finishEmheader(h);
            } else if (token.equals("member-id-past-28-bit")) {
                Writer.EmHeader h = w.writeEmheader(0x10000000, 4, false);
                w.writeU32(0);
                w.finishEmheader(h);
            } else if (token.equals("lc-body-size-mismatch")) {
                Writer.EmHeader h = w.writeEmheader(1, 1, false);
                w.writeU8(1);
                w.writeU8(2);
                w.writeU8(3);
                w.finishEmheader(h);
            } else if (token.equals("c:pid")) {
                Writer.Pid p = w.writePid(0x3F00, ParameterRole.MEMBER, false);
                w.writeU32(0);
                w.finishPid(p);
            } else if (token.equals("short-pid-past-0x3f00")) {
                Writer.Pid p = w.writePid(0x3F01, ParameterRole.MEMBER, false);
                w.writeU32(0);
                w.finishPid(p);
            } else if (token.equals("c:fixed")) {
                w.writeFixed("1.00", 5, 2, FixedDigitCount.DECLARED);
            } else if (token.equals("fixed-digits-past-31")) {
                w.writeFixed("1.00", 32, 2, FixedDigitCount.DECLARED);
            } else if (token.equals("fixed-scale-past-digits")) {
                w.writeFixed("1.00", 5, 6, FixedDigitCount.DECLARED);
            } else if (token.equals("c:bitset")) {
                w.writeBitset(2, 0x1234L);
            } else if (token.equals("bitset-anchor-width")) {
                w.writeBitset(4, 0x222111L);
            } else if (token.equals("over-u8")) {
                w.writeU8(256);
            } else if (token.equals("c:over-u8")) {
                w.writeU8(0x12);
            } else if (token.equals("over-u16")) {
                w.writeU16(70000);
            } else if (token.equals("c:over-u16")) {
                w.writeU16(0x1234);
            } else if (token.equals("over-u32")) {
                w.writeU32(4294967296L);
            } else if (token.equals("c:over-u32")) {
                w.writeU32(0x12345678L);
            } else {
                System.out.println("BROKEN the rt-java probe has no case for " + token);
                return;
            }
            StringBuilder sb = new StringBuilder();
            for (byte b : w.finish()) {
                sb.append(String.format("%02x", b));
            }
            System.out.println(sb.toString());
        } catch (RuntimeException e) {
            System.out.println("REFUSED " + e.getClass().getSimpleName() + ": " + e.getMessage());
        }
    }
}
EOF
