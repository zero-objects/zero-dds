# --- rt-swift ---------------------------------------------------------

# The runtime throws a `ZdWireError` on a refusal rather than exiting on
# its own, so `rt_swift_build`'s probe catches it itself and prints
# `REFUSED zdwire: <error>` before exiting 1 — the runtime's own words
# on the answer line, the same effect the removed `zdFailurePrefix` hook
# used to have, instead of leaving `run_native` to guess a refusal out
# of a non-zero exit.
# One line, space separated: the list is spliced into a `bash -c`
# command string, and a newline there would end the command instead of
# adding a source file.
rt_swift_sources() {
    echo "$root"/runtime/swift/Sources/ZdWire/*.swift
}

rt_swift_build() {
    build_state rt-swift; case $? in 0) return 0 ;; 2) return 1 ;; esac
    mkdir -p "$work/rtswift"
    cat > "$work/rtswift/main.swift" <<'EOF'
import Foundation

let framing = ZdPlCdr1Framing("sentinel-must-understand", 0x3F00, false, false, true, true)
let token = CommandLine.arguments.count > 1 ? CommandLine.arguments[1] : ""
let w = ZdWriter(.little, 4, framing, false)

// The runtime throws a ZdWireError on a refusal now, rather than
// exiting on its own; this probe owns the exit code, the same as
// every other language's probe in this file does with its own catch.
do {
    switch token {
    case "c:writer": w.writeU8(0x41)
    case "c:int": w.writeU16(0x1234)
    case "negative-u16": w.writeU16(0xcfc7)
    case "negative-u32": w.writeU32(0xffed_2979)
    case "past-2-63": w.writeU64(0xdead_beef_dead_c2be)
    case "c:float": w.writeF32(1.0)
    case "negative-zero-f32": w.writeF32(-0.0)
    case "negative-zero-f64": w.writeF64(-0.0)
    case "c:char": w.writeChar(try zdCheckedChar(0x41))
    case "char-above-8-bit": w.writeChar(try zdCheckedChar(0x100))
    case "c:wchar": try w.writeWchar(zdCheckedWchar(0x41), 2, "fixed", "stream")
    case "wchar-above-bmp": try w.writeWchar(zdCheckedWchar(0x1D11E), 2, "fixed", "stream")
    case "c:emheader":
        let h = try w.writeEmheader(1, 4, false)
        w.writeU32(0)
        try w.finishEmheader(h)
    case "member-id-past-28-bit":
        let h = try w.writeEmheader(0x1000_0000, 4, false)
        w.writeU32(0)
        try w.finishEmheader(h)
    case "lc-body-size-mismatch":
        let h = try w.writeEmheader(1, 1, false)
        w.writeU8(1); w.writeU8(2); w.writeU8(3)
        try w.finishEmheader(h)
    case "c:pid":
        let p = try w.writePid(0x3F00, .member, false)
        w.writeU32(0)
        try w.finishPid(p)
    case "short-pid-past-0x3f00":
        let p = try w.writePid(0x3F01, .member, false)
        w.writeU32(0)
        try w.finishPid(p)
    case "c:fixed": try w.writeFixed("1.00", 5, 2, "declared")
    case "fixed-digits-past-31": try w.writeFixed("1.00", 32, 2, "declared")
    case "fixed-scale-past-digits": try w.writeFixed("1.00", 5, 6, "declared")
    case "c:bitset": try w.writeBitset(2, 0x1234)
    case "bitset-anchor-width": try w.writeBitset(4, 0x22_2111)
    default:
        print("BROKEN the rt-swift probe has no case for \(token)")
        exit(0)
    }
    print(w.finish().map { String(format: "%02x", $0) }.joined())
} catch {
    print("REFUSED zdwire: \(error)")
    exit(1)
}
EOF
    local rc=0
    lim "$build_secs" bash -c "cd '$work/rtswift' && '${SWIFTC:-swiftc}' \
        -swift-version 5 $(rt_swift_sources) main.swift -o probe" > /dev/null 2>&1 || rc=$?
    cp "$LIMOUT" "$work/rtswift/build.log" 2>/dev/null || true
    if [ "$rc" = 124 ]; then
        build_bad rt-swift "the build did not finish in ${build_secs}s"; return 1
    fi
    if [ ! -x "$work/rtswift/probe" ]; then
        build_bad rt-swift "$(first_error_line "$work/rtswift/build.log")"; return 1
    fi
    build_ok rt-swift
}

rt_swift_typed() { # $1 token — the widths `writeU8`/`writeU16`/`writeU32` type
    local put lit dir="$work/rtswift-${1//:/_}"
    case "$1" in
