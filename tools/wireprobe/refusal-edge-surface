        over-u16)   stmt='zdw_write_u16(&w, 70000);' ;;
        c:over-u16) stmt='zdw_write_u16(&w, 0x1234);' ;;
        over-u32)   stmt='zdw_write_u32(&w, 4294967296ull);' ;;
