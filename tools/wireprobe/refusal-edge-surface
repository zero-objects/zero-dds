rt_ada_build() {
    build_state rt-ada; case $? in 0) return 0 ;; 2) return 1 ;; esac
    mkdir -p "$work/rtada"
    cat > "$work/rtada/probe.adb" <<'EOF'
with Ada.Command_Line;
with Ada.Exceptions;
with Ada.Strings.Unbounded;
with Ada.Text_IO;
with Interfaces;
with Zd_Wire;

procedure Probe is
   use Ada.Strings.Unbounded;
   use type Interfaces.Unsigned_8;
   --  `Bytes /= null` below: the predefined operators of a named access
   --  type declared in another package are not directly visible from a
   --  `with` alone, and without this the probe does not compile at all --
   --  every rt-ada cell reads `broken-probe` instead of an answer.
   use type Zd_Wire.Byte_Array_Access;
   --  And the same for the two float types: `-0.0` needs the unary minus
   --  of Interfaces.IEEE_Float_32 and _64 to be visible.
   use type Interfaces.IEEE_Float_32;
   use type Interfaces.IEEE_Float_64;

   Digits_Hex : constant String := "0123456789abcdef";

   Framing : constant Zd_Wire.Pl_Cdr1_Framing :=
     (Pid_Flags                    => Zd_Wire.Flags_Sentinel_Must_Understand,
      Highest_Short_Id             => 16#3F00#,
      Pad_Declared_Length          => False,
      Pad_Declared_Optional_Length => False,
      Member_Must_Understand       => True,
      Pad_After_Value              => True);

   W     : Zd_Wire.Writer := Zd_Wire.New_Writer (Zd_Wire.Little, 4, Framing, False);
   Token : constant String :=
     (if Ada.Command_Line.Argument_Count > 0 then Ada.Command_Line.Argument (1) else "");

   procedure Put_Hex is
      Bytes : constant Zd_Wire.Byte_Array_Access := Zd_Wire.Finish (W);
      Line  : Unbounded_String;
   begin
      if Bytes /= null then
         for B of Bytes.all loop
            Append (Line, Digits_Hex (Digits_Hex'First + Natural (B / 16)));
            Append (Line, Digits_Hex (Digits_Hex'First + Natural (B mod 16)));
         end loop;
      end if;
      Ada.Text_IO.Put_Line (To_String (Line));
   end Put_Hex;
begin
   if Token = "c:writer" then
      Zd_Wire.Write_U8 (W, 16#41#);
   elsif Token = "c:int" then
      Zd_Wire.Write_U16 (W, 16#1234#);
   elsif Token = "negative-u16" then
      Zd_Wire.Write_U16 (W, 16#CFC7#);
   elsif Token = "negative-u32" then
      Zd_Wire.Write_U32 (W, 16#FFED_2979#);
   elsif Token = "past-2-63" then
      Zd_Wire.Write_U64 (W, 16#DEAD_BEEF_DEAD_C2BE#);
   elsif Token = "c:float" then
      Zd_Wire.Write_F32 (W, 1.0);
   elsif Token = "negative-zero-f32" then
      Zd_Wire.Write_F32 (W, -0.0);
   elsif Token = "negative-zero-f64" then
      Zd_Wire.Write_F64 (W, -0.0);
   elsif Token = "c:char" then
      Zd_Wire.Write_Char (W, 16#41#);
   elsif Token = "char-above-8-bit" then
      Zd_Wire.Write_Char (W, 16#100#);
   elsif Token = "c:wchar" then
      Zd_Wire.Write_Wchar (W, 16#41#, 2, Zd_Wire.Wchar_Fixed, Zd_Wire.Unit_Stream);
   elsif Token = "wchar-above-bmp" then
      Zd_Wire.Write_Wchar (W, 16#1D11E#, 2, Zd_Wire.Wchar_Fixed, Zd_Wire.Unit_Stream);
   elsif Token = "c:emheader" then
      declare
         H : constant Zd_Wire.Emheader := Zd_Wire.Write_Emheader (W, 1, 4, False);
      begin
         Zd_Wire.Write_U32 (W, 0);
         Zd_Wire.Finish_Emheader (W, H);
      end;
   elsif Token = "member-id-past-28-bit" then
      declare
         H : constant Zd_Wire.Emheader :=
           Zd_Wire.Write_Emheader (W, 16#1000_0000#, 4, False);
      begin
         Zd_Wire.Write_U32 (W, 0);
         Zd_Wire.Finish_Emheader (W, H);
      end;
   elsif Token = "lc-body-size-mismatch" then
      declare
         H : constant Zd_Wire.Emheader := Zd_Wire.Write_Emheader (W, 1, 1, False);
      begin
         Zd_Wire.Write_U8 (W, 1);
         Zd_Wire.Write_U8 (W, 2);
         Zd_Wire.Write_U8 (W, 3);
         Zd_Wire.Finish_Emheader (W, H);
      end;
   elsif Token = "c:pid" then
      declare
         P : constant Zd_Wire.Pid_Write :=
           Zd_Wire.Write_Pid (W, 16#3F00#, Zd_Wire.Role_Member, False);
      begin
         Zd_Wire.Write_U32 (W, 0);
         Zd_Wire.Finish_Pid (W, P);
      end;
   elsif Token = "short-pid-past-0x3f00" then
      declare
         P : constant Zd_Wire.Pid_Write :=
           Zd_Wire.Write_Pid (W, 16#3F01#, Zd_Wire.Role_Member, False);
      begin
         Zd_Wire.Write_U32 (W, 0);
         Zd_Wire.Finish_Pid (W, P);
      end;
   elsif Token = "c:fixed" then
      Zd_Wire.Write_Fixed (W, To_Unbounded_String ("1.00"), 5, 2, Zd_Wire.Fixed_Declared);
   elsif Token = "fixed-digits-past-31" then
      Zd_Wire.Write_Fixed (W, To_Unbounded_String ("1.00"), 32, 2, Zd_Wire.Fixed_Declared);
   elsif Token = "fixed-scale-past-digits" then
      Zd_Wire.Write_Fixed (W, To_Unbounded_String ("1.00"), 5, 6, Zd_Wire.Fixed_Declared);
   elsif Token = "c:bitset" then
      Zd_Wire.Write_Bitset (W, 2, 16#1234#);
   elsif Token = "bitset-anchor-width" then
      Zd_Wire.Write_Bitset (W, 4, 16#22_2111#);
   else
      Ada.Text_IO.Put_Line ("BROKEN the rt-ada probe has no case for " & Token);
      return;
   end if;
   Put_Hex;
exception
   when E : others =>
      Ada.Text_IO.Put_Line
        ("REFUSED " & Ada.Exceptions.Exception_Name (E) & ": "
         & Ada.Exceptions.Exception_Message (E));
end Probe;
EOF
    local rc=0
    lim "$build_secs" bash -c "cd '$work/rtada' && gnatmake -q -gnat2012 \
        -I'$root/runtime/ada/src' probe.adb" > /dev/null 2>&1 || rc=$?
    cp "$LIMOUT" "$work/rtada/build.log" 2>/dev/null || true
    if [ "$rc" = 124 ]; then
        build_bad rt-ada "the build did not finish in ${build_secs}s"; return 1
    fi
    if [ ! -x "$work/rtada/probe" ]; then
        build_bad rt-ada "$(first_error_line "$work/rtada/build.log")"; return 1
    fi
    build_ok rt-ada
}

rt_ada_typed() { # $1 token — the widths Unsigned_8/16/32 type
    local put lit dir="$work/rtada-${1//:/_}"
    case "$1" in
        over-u8|c:over-u8)   put=Write_U8 ;;
        over-u16|c:over-u16) put=Write_U16 ;;
        over-u32|c:over-u32) put=Write_U32 ;;
    esac
    case "$1" in
        over-u8)  lit=256 ;;         c:over-u8)  lit=16#12# ;;
        over-u16) lit=70000 ;;       c:over-u16) lit=16#1234# ;;
        over-u32) lit=4294967296 ;;  c:over-u32) lit=16#1234_5678# ;;
    esac
    mkdir -p "$dir"
    cat > "$dir/probe.adb" <<EOF
with Ada.Exceptions;
with Ada.Strings.Unbounded;
with Ada.Text_IO;
with Interfaces;
with Zd_Wire;

procedure Probe is
   use Ada.Strings.Unbounded;
   use type Interfaces.Unsigned_8;
   --  `Bytes /= null` below: the same visibility the whole-surface probe
   --  needs, and without it these three cells read `broken-probe`.
   use type Zd_Wire.Byte_Array_Access;
   Digits_Hex : constant String := "0123456789abcdef";
   Framing : constant Zd_Wire.Pl_Cdr1_Framing :=
     (Pid_Flags                    => Zd_Wire.Flags_Sentinel_Must_Understand,
      Highest_Short_Id             => 16#3F00#,
      Pad_Declared_Length          => False,
      Pad_Declared_Optional_Length => False,
      Member_Must_Understand       => True,
      Pad_After_Value              => True);
   W : Zd_Wire.Writer := Zd_Wire.New_Writer (Zd_Wire.Little, 4, Framing, False);
   Line : Unbounded_String;
begin
   Zd_Wire.$put (W, $lit);
   declare
      Bytes : constant Zd_Wire.Byte_Array_Access := Zd_Wire.Finish (W);
   begin
      if Bytes /= null then
         for B of Bytes.all loop
            Append (Line, Digits_Hex (Digits_Hex'First + Natural (B / 16)));
            Append (Line, Digits_Hex (Digits_Hex'First + Natural (B mod 16)));
         end loop;
      end if;
   end;
   Ada.Text_IO.Put_Line (To_String (Line));
exception
   when E : others =>
      Ada.Text_IO.Put_Line
        ("REFUSED " & Ada.Exceptions.Exception_Name (E) & ": "
         & Ada.Exceptions.Exception_Message (E));
end Probe;
EOF
    local rc=0
    lim "$build_secs" bash -c "cd '$dir' && gnatmake -q -gnat2012 \
        -I'$root/runtime/ada/src' probe.adb" > /dev/null 2>&1 || rc=$?
    cp "$LIMOUT" "$dir/build.log" 2>/dev/null || true
    if [ "$rc" = 124 ]; then echo "TIMEOUT"; return; fi
    # The compiler's exit status decides, not the file: `zig build-exe`
    # leaves an empty, executable `probe` behind when it refuses, which
    # `-x` read as a built program and reported as a broken probe.
    if [ "$rc" != 0 ] || [ ! -s "$dir/probe" ]; then echo "REFUSED $(first_error_line "$dir/build.log")"; return; fi
    run_native rt-ada "$dir/probe"
}

probe_rt_ada() {
    case "$1" in over-u*|c:over-u*) rt_ada_typed "$1"; return ;; esac
    rt_ada_build || { echo "BROKEN $(cat "$work/rt-ada/.bad")"; return; }
    run_native rt-ada "$work/rtada/probe" "$1"
}

# =====================================================================
# The sweep
# =====================================================================

ask() { # $1 surface  $2 token -> one answer line
    local fn="probe_${1//-/_}"
    if ! declare -f "$fn" > /dev/null; then
        echo "BROKEN this driver has no probe for the surface $1"
        return
    fi
    # `< /dev/null`: `go`, `julia`, `elixir` and `dotnet fsi` all read
    # standard input, and without this the first of them swallows the
    # rest of the token list.
    "$fn" "$2" < /dev/null 2>/dev/null | tr -d '\r' | tail -1
}

is_refusal() { [ "${1#REFUSED}" != "$1" ]; }
is_octets()  { printf '%s' "$1" | grep -qE '^[0-9a-f]+$'; }

# The one row whose right answer is not a single string: §7.4.1.2.2
# reserves 0x3F01..0x3FFF, and PID_EXTENDED *is* 0x3F01, so a binding
# that promotes the parameter instead of refusing the short form has
# answered the clause. `013f0800` is that header's first four octets:
# the marker with the must-understand bit clear is `013f`, then the
# declared 8.
is_pid_extended() {
    printf '%s' "$1" | grep -qE '^(01|41)3f0800'
}

classify() { # $1 edge  $2 expected  $3 answer -> PASS or FAIL <what is wrong>
    local edge="$1" want="$2" got="$3"
    case "$edge" in
        short-pid-past-0x3f00)
            if is_refusal "$got" || is_pid_extended "$got"; then echo PASS
            else echo "FAIL the short form was written for a reserved id"; fi
            return ;;
    esac
    case "$want" in
        refuse*)
            if is_refusal "$got"; then echo PASS
            elif is_octets "$got" || [ "${got#wrote-frame}" != "$got" ]; then
                echo "FAIL octets for a value the width cannot hold (the silent-drop class)"
            else echo "FAIL neither a refusal nor octets"; fi
            return ;;
    esac
    if [ "$got" = "$want" ]; then echo PASS
    elif is_refusal "$got"; then echo "FAIL a refusal where the value has an exact form"
    else echo "FAIL the wrong octets"; fi
}

surfaces=""
for s in $(printf '%s' "$langs" | tr ',' ' '); do
    is_known_surface "$s" || {
        echo "refusal-edge-surface: \`$s\` is not one of $all_surfaces" >&2; exit 2; }
    surfaces="$surfaces $s"
done

edges=""
for e in $ledger_edges; do
    in_filter "$e" "$edges_filter" && edges="$edges $e"
done
[ -n "$edges" ] || { echo "refusal-edge-surface: no ledger row matched --edges" >&2; exit 2; }

if [ "$list_only" = 1 ]; then
    printf '%-14s %-24s %s\n' surface edge state
    for surface in $surfaces; do
        miss="$(missing_toolchain "$surface")" && state="skipped (no $miss)" || state=""
        for edge in $edges; do
            if reason="$(na_reason "$surface" "$edge")"; then
                printf '%-14s %-24s n/a — %s\n' "$surface" "$edge" "$reason"
            elif ! is_known_edge "$edge"; then
                printf '%-14s %-24s no-probe\n' "$surface" "$edge"
            elif [ -n "$state" ]; then
                printf '%-14s %-24s %s\n' "$surface" "$edge" "$state"
            else
                printf '%-14s %-24s asked\n' "$surface" "$edge"
            fi
        done
    done
    exit 0
fi

pass=0; fail=0; na=0; skip=0; broke=0; tmo=0; noprobe=0
first_fail=""

report() { # $1 surface  $2 edge  $3 verdict  $4 detail
    printf '%-14s %-24s %-13s %s\n' "$1" "$2" "$3" "${4:0:96}"
}

printf '%-14s %-24s %-13s %s\n' surface edge verdict detail
for surface in $surfaces; do
    if miss="$(missing_toolchain "$surface")"; then
        for edge in $edges; do
            report "$surface" "$edge" skipped "no toolchain: $miss is not on this host"
            skip=$((skip + 1))
        done
        continue
    fi
    if why="$(toolchain_unusable "$surface")"; then
        for edge in $edges; do
            report "$surface" "$edge" skipped "the toolchain builds nothing here: $why"
            skip=$((skip + 1))
        done
        continue
    fi

    # The surface control. One fresh writer, one octet. If this is not
    # octets, nothing this surface says afterwards is an answer.
    surface_control="$(ask "$surface" "c:writer")"
    surface_ok=1
    control_answers "$surface_control" || surface_ok=0

    for edge in $edges; do
        if reason="$(na_reason "$surface" "$edge")"; then
            report "$surface" "$edge" n-a "$reason"
            na=$((na + 1))
            continue
        fi
        if ! is_known_edge "$edge"; then
            report "$surface" "$edge" no-probe "this driver has no probe for the row"
            noprobe=$((noprobe + 1))
            continue
        fi
        if [ "$surface_ok" = 0 ]; then
            report "$surface" "$edge" broken-probe "c:writer did not answer: $surface_control"
            broke=$((broke + 1))
            continue
        fi

        control="$(ask "$surface" "$(control_of "$edge")")"
        if [ "$control" = TIMEOUT ]; then
            report "$surface" "$edge" timeout "the control did not finish in ${run_secs}s"
            tmo=$((tmo + 1))
            continue
        fi
        if ! control_answers "$control"; then
            report "$surface" "$edge" broken-probe \
                "$(control_of "$edge") did not answer: $control"
            broke=$((broke + 1))
            continue
        fi

        answer="$(ask "$surface" "$edge")"
        case "$answer" in
            TIMEOUT)
                report "$surface" "$edge" timeout "the probe did not finish in ${run_secs}s"
                tmo=$((tmo + 1)); continue ;;
            BROKEN*)
                report "$surface" "$edge" broken-probe "${answer#BROKEN }"
                broke=$((broke + 1)); continue ;;
        esac

        want="$(expected_of "$edge")"
        verdict="$(classify "$edge" "$want" "$answer")"
        if [ "$verdict" = PASS ]; then
            report "$surface" "$edge" PASS "$answer"
            pass=$((pass + 1))
        else
            report "$surface" "$edge" FAIL "${verdict#FAIL }"
            printf '    is:   %s\n' "${answer:0:150}"
            printf '    soll: %s   (%s)\n' "$want" "$(operation_of "$edge")"
            fail=$((fail + 1))
            [ -z "$first_fail" ] && first_fail="$surface $edge: is \`${answer:0:60}\`, soll \`$want\`"
        fi
    done
done

echo
echo "PASS=$pass FAIL=$fail n-a=$na skipped=$skip broken-probe=$broke timeout=$tmo no-probe=$noprobe"

rc=0
if [ "$fail" -gt 0 ]; then
    echo >&2
    echo "refusal-edge-surface: $fail of the cells contradict the ledger." >&2
    echo "the first: $first_fail" >&2
    rc=8
elif [ $((broke + tmo + noprobe)) -gt 0 ]; then
    echo >&2
    echo "refusal-edge-surface: $((broke + tmo + noprobe)) cells were not answers —" >&2
    echo "$broke broken probes, $tmo timeouts, $noprobe rows without a probe." >&2
    echo "None of them is a pass; a probe that will not build is this file's" >&2
    echo "defect and a row without a probe is a gap in it." >&2
    rc=2
fi
exit "$rc"
