# --- ada (the thin binding over endpoints/c) --------------------------
#
# `Zdw` is the C core's own surface and `Zdw_Xcdr` the XCDR2 half above
# it. Put_U8 .. Put_U64 report through an `int` status; the XCDR2
# operations report through an `out` status of their own. Neither
# raises, so `REFUSED` here is the binding's error return and not an
# exception this probe caught.

ada_build() {
    build_state ada; case $? in 0) return 0 ;; 2) return 1 ;; esac
    mkdir -p "$work/ada"
    cat > "$work/ada/probe.adb" <<'EOF'
with Ada.Command_Line;
with Ada.Exceptions;
with Ada.Text_IO;
with Interfaces.C;
with Zdw;
with Zdw_Xcdr;
procedure Probe is
   use Zdw;
   use type Interfaces.C.int;
   use type Interfaces.C.size_t;
   --  `-0.0` below needs the unary minus of the float types to be
   --  visible; without these the probe does not compile and every cell
   --  of this surface reads `broken-probe` instead of an answer.
   use type Interfaces.C.C_float;
   use type Interfaces.C.double;
   type Octets is array (Natural range <>) of aliased Interfaces.C.unsigned_char;
   pragma Convention (C, Octets);
   Buf   : aliased Octets (0 .. 131071) := [others => 0];
   W     : aliased Zdw.Zdw_Writer;
   Digs  : constant String := "0123456789abcdef";
   Token : constant String := Ada.Command_Line.Argument (1);
   Start : Interfaces.C.size_t;
   Head  : Zdw_Xcdr.Pid_Header;

   procedure Check (Code : Interfaces.C.int) is
   begin
      if Code /= Zdw.ZDW_OK then
         raise Zdw_Xcdr.Wire_Refused;
      end if;
   end Check;

   procedure Emit is
   begin
      for I in 0 .. Natural (W.Len) - 1 loop
         Ada.Text_IO.Put (Digs (Natural (Buf (I)) / 16 + 1));
         Ada.Text_IO.Put (Digs (Natural (Buf (I)) mod 16 + 1));
      end loop;
      Ada.Text_IO.New_Line;
   end Emit;
begin
   Writer_Init (W'Access, Buf'Address, Buf'Length, ZDW_LE);
   if Token = "c:writer" then
      Check (Put_U8 (W'Access, 16#41#));
   elsif Token = "c:int" then
      Check (Put_U16 (W'Access, 16#1234#));
   elsif Token = "negative-u16" then
      Check (Put_U16 (W'Access, 16#CFC7#));
   elsif Token = "negative-u32" then
      Check (Put_U32 (W'Access, 16#FFED2979#));
   elsif Token = "past-2-63" then
      Check (Put_U64 (W'Access, (Hi => 16#DEADBEEF#, Lo => 16#DEADC2BE#)));
   elsif Token = "c:float" then
      Check (Put_F32 (W'Access, 1.0));
   elsif Token = "negative-zero-f32" then
      Check (Put_F32 (W'Access, -0.0));
   elsif Token = "negative-zero-f64" then
      Check (Put_F64 (W'Access, -0.0));
   elsif Token = "c:char" then
      Zdw_Xcdr.Put_Char (W'Access, 16#41#);
   elsif Token = "char-above-8-bit" then
      Zdw_Xcdr.Put_Char (W'Access, 16#100#);
   elsif Token = "c:wchar" then
      Zdw_Xcdr.Put_Wchar (W'Access, 16#41#);
   elsif Token = "wchar-above-bmp" then
      Zdw_Xcdr.Put_Wchar (W'Access, 16#1D11E#);
   elsif Token = "c:emheader" then
      Zdw_Xcdr.EMHeader_Begin (W'Access, 1, False, Zdw_Xcdr.LC4, Start);
      Check (Put_U32 (W'Access, 0));
      Zdw_Xcdr.EMHeader_End (W'Access, Start, Zdw_Xcdr.LC4);
   elsif Token = "member-id-past-28-bit" then
      Zdw_Xcdr.EMHeader_Begin (W'Access, 16#10000000#, False, Zdw_Xcdr.LC4, Start);
      Check (Put_U32 (W'Access, 0));
      Zdw_Xcdr.EMHeader_End (W'Access, Start, Zdw_Xcdr.LC4);
   elsif Token = "lc-body-size-mismatch" then
      Zdw_Xcdr.EMHeader_Begin (W'Access, 1, False, Zdw_Xcdr.LC1, Start);
      Check (Put_U8 (W'Access, 1));
      Check (Put_U8 (W'Access, 2));
      Check (Put_U8 (W'Access, 3));
      Zdw_Xcdr.EMHeader_End (W'Access, Start, Zdw_Xcdr.LC1);
   elsif Token = "c:pid" then
      Zdw_Xcdr.Pid_Begin (W'Access, 16#3F00#, False, Head);
      Check (Put_U32 (W'Access, 0));
      Zdw_Xcdr.Pid_End (W'Access, Head);
   elsif Token = "short-pid-past-0x3f00" then
      Zdw_Xcdr.Pid_Begin (W'Access, 16#3F01#, False, Head);
      Check (Put_U32 (W'Access, 0));
      Zdw_Xcdr.Pid_End (W'Access, Head);
   elsif Token = "c:fixed" then
      Zdw_Xcdr.Put_Fixed (W'Access, "1.00", 5, 2);
   elsif Token = "fixed-digits-past-31" then
      Zdw_Xcdr.Put_Fixed (W'Access, "1.00", 32, 2);
   elsif Token = "fixed-scale-past-digits" then
      Zdw_Xcdr.Put_Fixed (W'Access, "1.00", 5, 6);
   elsif Token = "c:bitset" then
      Zdw_Xcdr.Put_Bitset (W'Access, (Hi => 0, Lo => 16#1234#), 2);
   elsif Token = "bitset-anchor-width" then
      Zdw_Xcdr.Put_Bitset (W'Access, (Hi => 0, Lo => 16#222111#), 4);
   else
      Ada.Text_IO.Put_Line ("BROKEN the ada probe has no case for " & Token);
      return;
   end if;
   Emit;
exception
   when E : others =>
      Ada.Text_IO.Put_Line ("REFUSED " & Ada.Exceptions.Exception_Name (E));
end Probe;
EOF
    (cd "$work/ada" \
        && gcc -std=c89 -pedantic -Wall -O1 -c -I"$root/endpoints/c/include" \
              -o zerodds_wire.o "$root/endpoints/c/src/zerodds_wire.c" \
        && gnatmake -q -gnat2022 -D "$work/ada" -aI"$root/endpoints/ada/src" \
              -o probe probe.adb -largs "$work/ada/zerodds_wire.o") \
        > "$work/ada/build.log" 2>&1 || {
        build_bad ada "$(first_error_line "$work/ada/build.log")"; return 1; }
    build_ok ada
}

