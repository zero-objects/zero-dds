# --- rt-c -------------------------------------------------------------
#
# The C runtime has no exceptions: a refusal is `zdw_writer_status`
# leaving `ZDW_OK`, which is the error return the ledger's `refuse`
# admits as one of the three idioms.

rt_c_build() {
    build_state rt-c; case $? in 0) return 0 ;; 2) return 1 ;; esac
    mkdir -p "$work/rtc"
    cat > "$work/rtc/probe.c" <<'EOF'
#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include "zerodds_wire.h"

static unsigned char buffer[262144];

static const char *status_name(zdw_status s)
{
    switch (s) {
    case ZDW_OK: return "ZDW_OK";
    case ZDW_SHORT_BUFFER: return "ZDW_SHORT_BUFFER";
    case ZDW_RANGE: return "ZDW_RANGE";
    case ZDW_BAD_ARGUMENT: return "ZDW_BAD_ARGUMENT";
    case ZDW_NOT_UTF8: return "ZDW_NOT_UTF8";
    case ZDW_BAD_DECIMAL: return "ZDW_BAD_DECIMAL";
    default: return "a non-OK status";
    }
}

int main(int argc, char **argv)
{
    zdw_writer w;
    const char *token = argc > 1 ? argv[1] : "";
    size_t i;
    zdw_status s;

    zdw_writer_init(&w, buffer, sizeof buffer, ZDW_LITTLE, 4);

    if (strcmp(token, "c:writer") == 0) {
        zdw_write_u8(&w, 0x41);
    } else if (strcmp(token, "c:int") == 0) {
        zdw_write_u16(&w, 0x1234);
    } else if (strcmp(token, "negative-u16") == 0) {
        zdw_write_u16(&w, 0xcfc7);
    } else if (strcmp(token, "negative-u32") == 0) {
        zdw_write_u32(&w, 0xffed2979u);
    } else if (strcmp(token, "past-2-63") == 0) {
        zdw_write_u64(&w, 0xdeadbeefdeadc2beull);
    } else if (strcmp(token, "c:float") == 0) {
        zdw_write_f32(&w, 1.0f);
    } else if (strcmp(token, "negative-zero-f32") == 0) {
        zdw_write_f32(&w, -0.0f);
    } else if (strcmp(token, "negative-zero-f64") == 0) {
        zdw_write_f64(&w, -0.0);
    } else if (strcmp(token, "c:char") == 0) {
        zdw_write_char(&w, 0x41);
    } else if (strcmp(token, "char-above-8-bit") == 0) {
        zdw_write_char(&w, 0x100);
    } else if (strcmp(token, "c:wchar") == 0) {
        zdw_write_wchar(&w, 0x41, ZDW_WCHAR_WIDTH_2, ZDW_WCHAR_FIXED, ZDW_WSTRING_UNITS_STREAM);
    } else if (strcmp(token, "wchar-above-bmp") == 0) {
        zdw_write_wchar(&w, 0x1D11E, ZDW_WCHAR_WIDTH_2, ZDW_WCHAR_FIXED, ZDW_WSTRING_UNITS_STREAM);
    } else if (strcmp(token, "c:emheader") == 0) {
        zdw_emheader h = zdw_write_emheader(&w, 1, 4, false);
        zdw_write_u32(&w, 0);
        zdw_finish_emheader(&w, h);
    } else if (strcmp(token, "member-id-past-28-bit") == 0) {
        zdw_emheader h = zdw_write_emheader(&w, 0x10000000u, 4, false);
        zdw_write_u32(&w, 0);
        zdw_finish_emheader(&w, h);
    } else if (strcmp(token, "lc-body-size-mismatch") == 0) {
        zdw_emheader h = zdw_write_emheader(&w, 1, 1, false);
        zdw_write_u8(&w, 1);
        zdw_write_u8(&w, 2);
        zdw_write_u8(&w, 3);
        zdw_finish_emheader(&w, h);
    } else if (strcmp(token, "c:pid") == 0) {
        zdw_pid p = zdw_write_pid(&w, 0x3F00, ZDW_PARAM_MEMBER, false);
        zdw_write_u32(&w, 0);
        zdw_finish_pid(&w, p);
    } else if (strcmp(token, "short-pid-past-0x3f00") == 0) {
        zdw_pid p = zdw_write_pid(&w, 0x3F01, ZDW_PARAM_MEMBER, false);
        zdw_write_u32(&w, 0);
        zdw_finish_pid(&w, p);
    } else if (strcmp(token, "c:fixed") == 0) {
        zdw_write_fixed(&w, "1.00", 5, 2, ZDW_FIXED_DECLARED);
    } else if (strcmp(token, "fixed-digits-past-31") == 0) {
        zdw_write_fixed(&w, "1.00", 32, 2, ZDW_FIXED_DECLARED);
    } else if (strcmp(token, "fixed-scale-past-digits") == 0) {
        zdw_write_fixed(&w, "1.00", 5, 6, ZDW_FIXED_DECLARED);
    } else if (strcmp(token, "c:bitset") == 0) {
        zdw_write_bitset(&w, 2, 0x1234u);
    } else if (strcmp(token, "bitset-anchor-width") == 0) {
        zdw_write_bitset(&w, 4, 0x222111u);
    } else {
        printf("BROKEN the rt-c probe has no case for %s\n", token);
        return 0;
    }

    s = zdw_writer_status(&w);
    if (s != ZDW_OK) {
        printf("REFUSED %s\n", status_name(s));
        return 0;
    }
    for (i = 0; i < zdw_writer_length(&w); i++) {
        printf("%02x", buffer[i]);
    }
    printf("\n");
    return 0;
}
EOF
    (cd "$work/rtc" && "${CC:-gcc}" -std=c11 -O1 -I"$root/runtime/c/include" \
        -o probe probe.c "$root"/runtime/c/src/*.c) > "$work/rtc/build.log" 2>&1 || {
        build_bad rt-c "$(first_error_line "$work/rtc/build.log")"; return 1; }
    build_ok rt-c
}

