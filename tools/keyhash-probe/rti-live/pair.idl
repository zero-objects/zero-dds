//
// An 8-byte key behind a narrower one: PLAIN_CDR2 aligns `b` to 4 in the key
// holder (XTypes 1.3 §7.6.8 step 4), XCDR1 to 8.
module kh {
  @final struct Pair {
    @key short a;
    @key long long b;
    long v;
  };
};
