    ZERODDS_ENDPOINTS_MUTATION_LANGS="ada,ada-83,ada-native,d,elixir,go,java,lua,node,ocaml,python" \
    tools/endpoints-gate --require \
        ada,ada-83,ada-native,c,cpp,d,elixir,go,java,lua,node,ocaml,python,rust,codegen,mutation
}

# ---------------------------------------------------------------------
# The run. Preflight first: who else is on this host's RTPS ports.
#
# A DDS domain is a UDP port (RTPS 2.5 §9.6.1.1), so a stray participant
# is not isolated from a test by anything the test can do. On the Linux
# test host a stuck participant on domain 0 exchanged traffic with a run
# of these tests and produced two sample counts that said nothing about
# either vendor. The listeners are recorded here, before the first
# measurement, so a reader of the log can see what else was on the wire
# rather than having to guess afterwards.
# ---------------------------------------------------------------------

# A name on --require that is not in the run list would otherwise be a
# promise nothing checks: the summary would find no SKIP for it and the
# run would end green having never asked. That is the same silent hole
# the flag exists to close, so it is refused here.
for r in $require; do
    printf '%s\n' $tests | grep -qx "$r" || {
        echo "interop-gate: --require names \`$r\`, which is not in this run" >&2
        exit 2
    }
done

say "interop-gate: $(printf '%s\n' $tests | grep -c .) test(s), logs in $logs"
if command -v ss >/dev/null 2>&1; then
    foreign="$(ss -ulnp 2>/dev/null \
        | awk '$5 ~ /:(7[4-9][0-9][0-9]|[0-9]{5})$/ {print}' \
        | grep -E 'pid=' || true)"
    if [ -n "$foreign" ]; then
        say "RTPS-range UDP listeners on this host at the start of the run:"
        printf '%s\n' "$foreign" | sed 's/^/  /'
    else
        say "no UDP listener in the RTPS port range at the start of the run"
    fi
else
    say "ss(8) is not installed; this run cannot say what else held an RTPS port"
fi
hr

for t in $tests; do
    fn="${t//-/_}"
    if ! declare -F "run_$fn" >/dev/null; then
        echo "interop-gate: no such test: $t" >&2
        exit 2
    fi
    gone="$("need_$fn")"
    if [ -n "$gone" ]; then
        skip "$t" "$gone"
        say "SKIP  $t — not installed: $gone"
        continue
    fi
    band="$(domain_band "$t")"
    if [ -n "$band" ]; then
        # shellcheck disable=SC2086
        busy="$(busy_domains $band)"
        if [ -n "$busy" ]; then
            VERDICT[$t]=BLOCKED; REASON[$t]="$busy"
            say "BLOCKED $t — domains $band are not free: $busy"
            continue
        fi
    fi
    start=$SECONDS
    say "RUN   $t"
    if "run_$fn" > "$logs/$t.log" 2>&1; then
        VERDICT[$t]=PASS
    else
        VERDICT[$t]=FAIL
        REASON[$t]="$(grep -m1 -E '^(error|FAIL|CHANGED|thread .* panicked|[a-z-]+: [0-9]+ )' \
                      "$logs/$t.log" 2>/dev/null | cut -c1-160)"
        [ -n "${REASON[$t]}" ] || REASON[$t]="see $logs/$t.log"
    fi
    SECONDS_OF[$t]=$((SECONDS - start))
    say "${VERDICT[$t]}  $t (${SECONDS_OF[$t]}s)"
done

# ---------------------------------------------------------------------
# The table, then the two counts that decide the exit status.
# ---------------------------------------------------------------------
hr
pass=0; fail=0; skipped=0; blocked=0; required_missing=""
for t in $tests; do
    case "${VERDICT[$t]:-}" in
        PASS) pass=$((pass+1)); printf 'PASS  %-22s %ss\n' "$t" "${SECONDS_OF[$t]}" ;;
        FAIL) fail=$((fail+1)); printf 'FAIL  %-22s %ss  %s\n' "$t" "${SECONDS_OF[$t]}" "${REASON[$t]}" ;;
        BLOCKED)
            blocked=$((blocked+1))
            printf 'BLOCKED %-20s      domain in use: %s\n' "$t" "${REASON[$t]}" ;;
        SKIP)
            skipped=$((skipped+1))
            printf 'SKIP  %-22s      not installed: %s\n' "$t" "${REASON[$t]}"
            for r in $require; do
                [ "$r" = "$t" ] && required_missing="$required_missing $t"
            done ;;
    esac
done
hr
printf '%s passed, %s failed, %s not verified (toolchain absent), %s blocked (domain in use)\n' \
    "$pass" "$fail" "$skipped" "$blocked"

status=0
if [ "$fail" -gt 0 ]; then status=1; fi
if [ "$blocked" -gt 0 ]; then
    printf 'BLOCKED means the host was not quiet, not that the code is wrong: %s test(s)\n' \
        "$blocked"
    printf '  free the named domains and run those tests again.\n'
    status=1
fi
if [ -n "$required_missing" ]; then
    printf 'REQUIRED AND NOT MEASURED:%s — %s test(s) this run cannot speak for\n' \
        "$required_missing" "$(printf '%s\n' $required_missing | grep -c .)"
    status=1
fi
if [ "$skipped" -gt 0 ] && [ -z "$required_missing" ]; then
    printf 'the %s skipped test(s) above are unverified, not passing\n' "$skipped"
fi
exit "$status"
