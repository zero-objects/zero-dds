# ---- 15. the twenty-one language endpoints over a live socket --------
# The SKIP audit is the CI job's and is kept: a language whose toolchain
# `need_endpoint_e2e` just found still printing SKIP means the app never
# ran, which is a false green and a failure here.
EP_TOOLS="cargo gcc g++ python3 go gnat gprbuild gdc elixir javac lua5.4 \
ocamlfind zig nim julia node kotlinc swiftc dotnet"
need_endpoint_e2e() { missing_cmds $EP_TOOLS; }
run_endpoint_e2e() {
    local log="$logs/endpoint-e2e.cargo.log"
    cargo test -p zerodds-endpoint-e2e --target x86_64-unknown-linux-gnu \
        --no-fail-fast -- --test-threads=1 --nocapture > "$log" 2>&1
    local rc=$?
    local bad; bad="$(grep '^SKIP ' "$log" || true)"
    if [ -n "$bad" ]; then
        say "UNEXPECTED SKIPs — the toolchain is on this host and the test still soft-skipped:"
        printf '%s\n' "$bad"
        return 1
    fi
    return "$rc"
}

