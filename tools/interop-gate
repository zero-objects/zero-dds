# ---- 13. the NxN live matrix over the language ports -----------------
# The dds-chat matrix drops a language whose toolchain is absent. That is
# the silent skip this script exists to remove, so the toolchains are
# named here and a missing one is a SKIP of the whole test rather than a
# quietly smaller matrix.
CHAT_LANGS="rust python ts-node csharp java cpp"
need_cross_language_e2e() {
    missing_cmds cargo python3 node dotnet javac g++ cmake
}
run_cross_language_e2e() {
    cargo build -p zerodds-c-api || return 1
    export REPO_ROOT="$root" ZERODDS_LIB="$root/target/debug/libzerodds.so"
    ( cd examples/tutorials/dds-chat/e2e
      # shellcheck disable=SC1091
      source ./ports.sh
      local langs=() built_fail=()
      for l in $CHAT_LANGS; do
          if port_build "$l"; then langs+=("$l"); else built_fail+=("$l"); fi
      done
      if [ "${#built_fail[@]}" -gt 0 ]; then
          # A port whose toolchain IS present and still will not build is
          # this project's failure, not an absent column.
          printf 'port build failed with the toolchain present: %s\n' "${built_fail[*]}"
          return 1
      fi
      local pass=0 fail=0 domain=150 failures=()
      for pub in "${langs[@]}"; do
        for sub in "${langs[@]}"; do
          domain=$((domain + 1))
          local o rc
          o="$(./run-pair.sh "$pub" "$sub" "$domain")"; rc=$?
          printf '%s\n' "$o" | head -1
          if [ "$rc" = 0 ]; then pass=$((pass+1))
          else fail=$((fail+1)); failures+=("$pub->$sub"); printf '%s\n' "$o" | tail -n +2
          fi
        done
      done
      printf '== cross-language: %s passed, %s failed ==\n' "$pass" "$fail"
      [ "$fail" = 0 ] || { printf '  FAIL: %s\n' "${failures[@]}"; return 1; }
    )
}

# ---- 13b. the six FFI language bindings over a live socket -----------
# `tests/cross_lang_live/run_all.sh`, which no job in `.gitlab-ci.yml`
# names either. Its own summary counts a language with no script as SKIP;
# all six scripts are committed and executable, so a SKIP in its output
# means a script lost its executable bit and is checked for here.
need_cross_lang_live() {
    missing_cmds cargo gcc g++ python3 javac dotnet node
}
run_cross_lang_live() {
    export REPO_ROOT="$root" ZERODDS_LIB="$root/target/debug/libzerodds.so"
    cargo build -p zerodds-c-api || return 1
    local log="$logs/cross-lang-live.run.log"
    bash tests/cross_lang_live/run_all.sh > "$log" 2>&1
    local rc=$?
    cat "$log"
    # `SKIP: 0 / 6` or the run did not speak for all six.
    grep -qE 'SKIP: 0 / 6' "$log" || {
        say "a language dropped out of the six; the summary above says which"
        return 1
    }
    return "$rc"
}

