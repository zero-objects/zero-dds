        && bash tests/interop/ci/tests/test_cleanup.sh \
        && python3 -m pytest -q tests/interop/ci/tests/test_interop_result.py
}

# ---- 9. SPDP: a foreign vendor is seen at all ------------------------
need_live_spdp() {
    local gone; gone="$(missing_cmds cargo g++)"
    [ -x "$CYCLONE_HOME/bin/ddsperf" ] || gone="$gone ddsperf(CYCLONE_HOME=$CYCLONE_HOME)"
    [ -d "$FASTDDS_HOME/include" ] || gone="$gone fastdds(FASTDDS_HOME=$FASTDDS_HOME)"
    printf '%s' "$(printf '%s' "$gone" | tr -s ' ' | sed 's/^ //;s/ $//')"
}
run_live_spdp() {
    local art="$out/live-spdp"; mkdir -p "$art"
    g++ -std=c++17 tests/interop/fastdds_pub.cpp -o "$art/fastdds_pub" \
        -I"$FASTDDS_HOME/include" -L"$FASTDDS_HOME/lib" \
        -lfastdds -lfastcdr -lpthread -Wl,-rpath,"$FASTDDS_HOME/lib" || return 1
    cargo build -q --example spdp_demo -p zerodds-discovery || return 1
    LD_LIBRARY_PATH="$CYCLONE_HOME/lib:${LD_LIBRARY_PATH:-}" \
        "$CYCLONE_HOME/bin/ddsperf" pub 1Hz size 16 &>"$art/cyclone.log" &
    local cyc=$!
    "$art/fastdds_pub" &>"$art/fastdds.log" & local fdd=$!
    sleep 3
    timeout 30s target/debug/examples/spdp_demo | tee "$art/demo.out" || true
    kill "$cyc" "$fdd" 2>/dev/null; wait "$cyc" "$fdd" 2>/dev/null
    local foreign
    foreign=$(grep '✓ DISCOVERED' "$art/demo.out" \
              | grep -cv 'vendor=VendorId(\[1, 240\])')
    say "foreign vendors discovered: $foreign" >&2
    [ "$foreign" -ge 1 ]
}

