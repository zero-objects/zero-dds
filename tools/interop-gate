#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Copyright 2026 ZeroDDS Contributors
#
# interop-gate — every interop test this project has, in one command,
# with one verdict per test.
#
#   tools/interop-gate
#   tools/interop-gate --tests vendor-bytes,ci-cyclone
#   tools/interop-gate --require interop-corpus,interop-results,ci-cyclone
#   tools/interop-gate --list
#
# ## Why this exists next to .gitlab-ci.yml
#
# The interop jobs live in sixteen places in `.gitlab-ci.yml` and are the
# only thing that runs them. When the shared runner is down — and it has
# been, for weeks at a time, because a second workload on the same host
# takes the memory — nothing measures cross-vendor interop at all, and
# the last pipeline's red is a statement about the runner rather than
# about the code. This script is the path that does not go through
# GitLab: the same commands, on the Linux test host, with a verdict
# table at the end.
#
# ## The rule about absence
#
# It is `tools/interop-vendors.sh`'s and `tools/endpoints-gate`'s rule,
# and it is the reason this file is not a `for` loop over sixteen
# `bash -c`s. A test whose toolchain is not installed is SKIP, printed
# with the exact thing that was missing, and counted in the summary as a
# test this run did not verify. It is never a pass. It is a FAILURE when
# the test is on `--require` / `ZERODDS_INTEROP_REQUIRE`, which is how a
# run that promises to cover a vendor notices the vendor quietly leaving
# the host.
#
# A run therefore ends non-zero on either of two things: a test that
# failed, or a required test that could not be measured. Those are
# reported separately, because they need different answers.
set -uo pipefail

if [ "${BASH_VERSINFO[0]}" -lt 4 ]; then
    echo "interop-gate: bash ${BASH_VERSION} cannot run this; it uses" \
         "associative arrays, which are bash 4's" >&2
    exit 2
fi

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root" || exit 2

# The vendor locations and the loud-absence helpers. Sourcing it also
# exports DDS_ROOT/ACE_ROOT/TAO_ROOT, which OpenDDS's generators read.
# shellcheck source=tools/interop-vendors.sh
. "$root/tools/interop-vendors.sh"

# ---------------------------------------------------------------------
# The tests. `ALL_TESTS` is the order a full run takes: the ones that
# need no network first, so a host with no multicast still produces the
# offline half of the table before it starts skipping.
# ---------------------------------------------------------------------
ALL_TESTS="interop-corpus interop-results vendor-bytes vendor-roundtrip \
results-record ci-cyclone ci-fastdds ci-rti ci-harness live-spdp live-roundtrip \
live-rust live-discovery writer-restart-32 cross-language-e2e cross-lang-live \
warehouse-e2e endpoint-e2e endpoints-gate"

# The two that a scheduled pipeline runs and a commit pipeline does not:
# `vendor-roundtrip` is 120 minutes with a cold cache and `results-record`
# is 90. They are in ALL_TESTS because this script is the thing that runs
# when nothing else does, but `--quick` drops them.
SLOW_TESTS="vendor-roundtrip results-record"

tests="$ALL_TESTS"
require="${ZERODDS_INTEROP_REQUIRE:-}"
list_only=0
out="$root/target/interop-gate"

usage() {
    sed -n '5,40p' "${BASH_SOURCE[0]}"
    printf '\ntests: %s\nslow:  %s\n' "$ALL_TESTS" "$SLOW_TESTS"
}

while [ $# -gt 0 ]; do
    case "$1" in
        --tests)   tests="$(printf '%s' "$2" | tr ',' ' ')"; shift 2 ;;
        --require) require="$(printf '%s' "$2" | tr ',' ' ')"; shift 2 ;;
        --out)     out="$2"; shift 2 ;;
        --quick)
            for _slow in $SLOW_TESTS; do
                tests="$(printf '%s\n' $tests | grep -vx "$_slow" | tr '\n' ' ')"
            done
            unset _slow; shift ;;
        --list)    list_only=1; shift ;;
        --help|-h) usage; exit 0 ;;
        *) echo "interop-gate: \`$1\` is not an option" >&2; exit 2 ;;
    esac
done

if [ "$list_only" = 1 ]; then
    printf '%s\n' $ALL_TESTS
    exit 0
fi

logs="$out/logs"
mkdir -p "$logs" || exit 2

declare -A VERDICT=() REASON=() SECONDS_OF=()

say() { printf '%s\n' "$*"; }
hr()  { printf -- '---------------------------------------------------------------\n'; }

# have <command> — on PATH?
have() { command -v "$1" >/dev/null 2>&1; }

# missing <thing>... — the first of the named commands that is absent,
# printed as the thing a reader has to install. Empty when all present.
missing_cmds() {
    local c gone=""
    for c in "$@"; do have "$c" || gone="$gone $c"; done
    printf '%s' "${gone# }"
}

# missing_vendors <vendor>... — the same for the nine foreign toolchains,
# each named with the variable that points at it, so the line a reader
# gets is the line they have to change.
missing_vendors() {
    local v gone=""
    for v in "$@"; do
        vendor_probe "$v" || gone="$gone $v($(vendor_where "$v"))"
    done
    printf '%s' "${gone# }"
}

# skip <test> <reason> — never a pass, always by name.
skip() { VERDICT[$1]=SKIP; REASON[$1]="$2"; }

# ---------------------------------------------------------------------
# Domain isolation.
#
# A DDS domain is a UDP port: RTPS 2.5 §9.6.1.1 puts every socket of
# domain `d` in [7400 + 250d, 7400 + 250d + 249]. So a test does not get
# a domain to itself by asking for one — it gets whatever else on the
# host is already there, and it counts that traffic as its own result.
#
# Measured: with a stray participant on domain 0, this suite's
# `live-roundtrip` reported 0 samples in one direction and 118 in the
# other, and neither number was about ZeroDDS or Cyclone; on domain 62 it
# passes. A second, controlled measurement of the same pattern elsewhere
# ran one case ten times: 2/10 on domain 0, 10/10 on an isolated domain.
#
# Every live test therefore declares the band it will use, and a band
# that is not free is BLOCKED — not run, not skipped, and not passed. A
# blocked test makes the run non-zero for the same reason a failing one
# does: the suite did not measure what it promised. It is counted apart
# from a failure because it needs a different answer — free the host, not
# fix the code.
# ---------------------------------------------------------------------

# domain_band <test> -> "<first> <last>", empty when the test uses no
# fixed domain of its own (the byte and codegen gates), or leases one
# through `zerodds-test-domains` (the Rust live tests).
domain_band() {
    case "$1" in
        # tests/interop/ci/run_vendor.sh: DOMAIN_BASE + one per cell.
        ci-cyclone)         printf '121 125' ;;
        ci-fastdds)         printf '141 145' ;;
        ci-rti)             printf '220 224' ;;
        ci-harness)         printf '141 145' ;;
        # ddsperf and the spdp_demo example both take the default domain.
        live-spdp)          printf '0 0' ;;
        # tests/interop/xv_pub_sub_roundtrip.sh, $DOMAIN.
        live-roundtrip)     printf '62 62' ;;
        # tests/issue32/run_matrix.sh walks its cells from 150.
        writer-restart-32)  printf '150 162' ;;
        # examples/tutorials/dds-chat/e2e: 150 + one per ordered pair.
        cross-language-e2e) printf '151 186' ;;
        # examples/demos/dds-warehouse: one station per domain.
        warehouse-e2e)      printf '73 82' ;;
        *)                  printf '' ;;
    esac
}

# busy_domains <first> <last> — the domains in the band that something on
# this host already holds, each with the process holding it. Empty when
# the band is free. `ss` is the only reader; a host without it cannot
# answer the question and says so rather than assuming a free band.
busy_domains() {
    local first="$1" last="$2" d low high line port busy=""
    if ! command -v ss >/dev/null 2>&1; then
        printf 'ss(8) is not installed, so this host cannot say whether domains %s..%s are free' \
            "$first" "$last"
        return
    fi
    local listeners; listeners="$(ss -uln 2>/dev/null | awk 'NR>1 {print $5}')"
    for d in $(seq "$first" "$last"); do
        low=$((7400 + 250 * d)); high=$((low + 249))
        while IFS= read -r line; do
            port="${line##*:}"
            case "$port" in ''|*[!0-9]*) continue ;; esac
            if [ "$port" -ge "$low" ] && [ "$port" -le "$high" ]; then
                busy="$busy $d(port $port$(ss -ulnp 2>/dev/null \
                    | grep -m1 ":$port " | grep -o 'pid=[0-9]*' | head -1 \
                    | sed 's/^/, /'))"
                break
            fi
        done <<< "$listeners"
    done
    printf '%s' "${busy# }"
}

# ---------------------------------------------------------------------
# One test = a `need_<name>` that returns the missing thing (empty when
# the test can run) and a `run_<name>` that returns 0 for PASS.
#
# Every `run_` writes its own log to $logs/<name>.log and prints nothing
# else, so the table at the end is the whole of this script's stdout.
# ---------------------------------------------------------------------

