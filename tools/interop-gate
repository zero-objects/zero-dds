    cmake -S tests/interop/ci/fastdds -B tests/interop/ci/fastdds/build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_PREFIX_PATH="$FASTDDS_HOME" \
        -DFASTDDSGEN="$FASTDDSGEN" >/dev/null || return 1
