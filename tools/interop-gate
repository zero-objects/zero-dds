    local gone; gone="$(missing_cmds python3 cmake g++)"
    python3 -c 'import pytest' >/dev/null 2>&1 || gone="$gone python3-module:pytest"
    printf '%s' "$(printf '%s' "$gone" | tr -s ' ' | sed 's/^ //;s/ $//')"
}
run_ci_harness() {
    # `find_package(fastcdr)` looks in the system prefix, and the test
    # host installs Fast DDS under $FASTDDS_HOME. Naming the prefix here
