# ---- 11. the Rust cross-vendor live tests ----------------------------
# The tests return early with `INTEROP-SKIP` and pass unless INTEROP_REQUIRE
# is set, and the Fast DDS ones need the `fastdds_shapes` client the CI job
# builds; both are set up here as the `live-interop` job does.
need_live_rust() {
    local gone; gone="$(missing_vendors fastdds)"
    gone="$gone $(missing_cmds cargo cmake g++ python3)"
    [ -x "$CYCLONE_HOME/bin/ddsperf" ] || gone="$gone ddsperf(CYCLONE_HOME=$CYCLONE_HOME)"
    [ -d "$FASTDDS_HOME/lib" ] || gone="$gone fastdds(FASTDDS_HOME=$FASTDDS_HOME)"
    python3 -c 'import cyclonedds' >/dev/null 2>&1 \
        || gone="$gone python3-module:cyclonedds"
    printf '%s' "$(printf '%s' "$gone" | tr -s ' ' | sed 's/^ //;s/ $//')"
}
run_live_rust() {
    local art="$out/live-rust"; mkdir -p "$art"
    cmake -S tests/interop/ci/fastdds -B "$art/fastdds-build" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_PREFIX_PATH="$FASTDDS_HOME" \
        -DFASTDDSGEN="$FASTDDSGEN" -DBUILD_LIVE_SHAPES=ON >/dev/null || return 1
    cmake --build "$art/fastdds-build" --target fastdds_shapes --parallel \
        >/dev/null || return 1
    FASTDDS_SHAPES="$art/fastdds-build/fastdds_shapes" \
    DDSPERF="$CYCLONE_HOME/bin/ddsperf" \
    LD_LIBRARY_PATH="$CYCLONE_HOME/lib:$FASTDDS_HOME/lib:${LD_LIBRARY_PATH:-}" \
    INTEROP_REQUIRE=1 INTEROP_LOG_DIR="$art/vendor-children" \
    cargo test -p zerodds-dcps --features live-interop \
        --test fastdds_qos_matrix --test fastdds_live_sub \
        --test fastdds_live_pub --test cyclone_live_wlp \
        --test cyclone_live_shm_locator \
        -- --ignored --test-threads=1
}

