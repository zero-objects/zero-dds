need_interop_corpus() { missing_cmds cargo; }
run_interop_corpus() {
    cargo test -p zerodds-wire-probe --target x86_64-unknown-linux-gnu \
        --test interop_corpus
}

# ---- 2. the 3,350-row result tree, against what is committed ---------
need_interop_results() { missing_cmds cargo; }
run_interop_results() {
    cargo run -q -p zerodds-interop-results --bin interop-results -- --verify \
        && cargo test -p zerodds-interop-results --target x86_64-unknown-linux-gnu
}

# ---- 3. the vendor byte rows, regenerated ----------------------------
# `--require-asked` is the flag that makes a run against an image with
# none of the four fail instead of comparing nothing and going green.
need_vendor_bytes() { missing_vendors cyclone rti fastdds opendds; }
run_vendor_bytes() {
    DOMAIN_BASE="${DOMAIN_BASE:-181}" bash tools/byte-gate/verify.sh \
        --vendors cyclone,rti,fastdds,opendds --require-asked \
        --regenerated-out "$out/vendor-bytes-regenerated.tsv"
}

