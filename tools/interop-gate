# ---- 6/7. the #28 gate: typed samples over live RTPS, both ways ------
# The Python Cyclone client is a module and not a binary, so it is probed
# by import and not by `command -v`.
need_ci_cyclone() {
    local gone; gone="$(missing_vendors cyclone)"
    gone="$gone $(missing_cmds cargo python3)"
    python3 -c 'import cyclonedds' >/dev/null 2>&1 \
        || gone="$gone python3-module:cyclonedds"
    printf '%s' "$(printf '%s' "$gone" | tr -s ' ' | sed 's/^ //;s/ $//')"
}
run_ci_cyclone() {
    ( cd interop/cyclone-xtypes-27/reader && cargo build -q ) || return 1
    bash tests/interop/ci/run_vendor.sh cyclone "$out/ci-cyclone"
}

need_ci_fastdds() {
    local gone; gone="$(missing_vendors fastdds)"
    gone="$gone $(missing_cmds cargo cmake g++)"
    printf '%s' "$(printf '%s' "$gone" | tr -s ' ' | sed 's/^ //;s/ $//')"
}
run_ci_fastdds() {
    ( cd interop/cyclone-xtypes-27/reader && cargo build -q ) || return 1
    # `find_package(fastcdr)` looks in the system prefix, and the test
    # host installs Fast DDS under $FASTDDS_HOME. Naming the prefix here
    # keeps the harness's CMakeLists.txt free of a host's layout.
    cmake -S tests/interop/ci/fastdds -B tests/interop/ci/fastdds/build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_PREFIX_PATH="$FASTDDS_HOME" \
        -DFASTDDSGEN="$FASTDDSGEN" >/dev/null || return 1
    cmake --build tests/interop/ci/fastdds/build --parallel >/dev/null || return 1
    FASTDDS_ROBOT="$root/tests/interop/ci/fastdds/build/fastdds_robot" \
        bash tests/interop/ci/run_vendor.sh fastdds "$out/ci-fastdds"
}

# ---- 7b. the same two cells against RTI Connext ----------------------
#
# `.gitlab-ci.yml` has an `interop-cyclone` and an `interop-fastdds` job and
# nothing for RTI, and `run_vendor.sh` used to know two vendors. RTI is on the
# Linux test host and is the strictest of the four at discovery — it is the
# only one of them that cross-checks the `typeobject_serialized_size` a peer
# announces beside a COMPLETE `TypeIdentifier` against its own — so a gate
# without it does not measure the case that fails first.
#
# The Connext runtime, unlike `rtiddsgen`, refuses to start without a licence
# file, so both are probed: a host with only the generator builds the client
# and then produces a cell that says nothing about the wire.
need_ci_rti() {
    local gone; gone="$(missing_vendors rti)"
    gone="$gone $(missing_cmds cargo g++)"
    [ -f "$NDDSHOME/rti_license.dat" ] \
        || gone="$gone rti-license(NDDSHOME=$NDDSHOME/rti_license.dat)"
    printf '%s' "$(printf '%s' "$gone" | tr -s ' ' | sed 's/^ //;s/ $//')"
}
run_ci_rti() {
    ( cd interop/cyclone-xtypes-27/reader && cargo build -q ) || return 1
    bash tests/interop/ci/run_vendor.sh rti "$out/ci-rti"
}

