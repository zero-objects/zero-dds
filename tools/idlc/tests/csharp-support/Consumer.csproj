<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GeneratedDirectory Condition="'$(GeneratedDirectory)' == ''">generated</GeneratedDirectory>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Condition="'$(UseInstalledPackages)' != 'true'" Include="../../../../crates/cs/csharp/ZeroDDS/ZeroDDS.csproj" />
    <PackageReference Condition="'$(UseInstalledPackages)' == 'true'" Include="ZeroDDS" Version="[1.0.0-rc.7]" />
    <Compile Include="Program.cs" />
    <Compile Include="$(GeneratedDirectory)/support.cs" />
    <Compile Include="$(GeneratedDirectory)/support.TypeSupport.cs" />
  </ItemGroup>
</Project>
