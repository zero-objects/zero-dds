// Semantic-gate repro: two independent, previously-silent defects.
//
// 1. `DuplicateMember` declares the member `value` twice — a §7.2.3
//    member-name collision that used to emit duplicate target-language
//    fields (e.g. two `pub value:` in Rust).
// 2. `UnresolvedMember` references the undeclared type `DoesNotExist` —
//    an unresolved type name that used to reach the backends verbatim.
//
// Both must make `check` and `generate` (with or without --no-typeobject)
// fail with a non-zero exit code and emit no output file.
struct DuplicateMember {
    long value;
    long value;
};

struct UnresolvedMember {
    DoesNotExist value;
};
