// Conformance feature: all IDL primitive types (OMG IDL 4.2 §7.4.1).
module conf {
  struct Primitives {
    boolean      b;
    octet        o;
    char         c;
    wchar        wc;
    short        i16;
    unsigned short u16;
    long         i32;
    unsigned long  u32;
    long long    i64;
    unsigned long long u64;
    float        f32;
    double       f64;
    int8         s8;
    uint8        un8;
    int16        s16;
    uint16       un16;
    int32        s32;
    uint32       un32;
    int64        s64;
    uint64       un64;
  };
};
