<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ZeroddsIdlcSample</RootNamespace>
  </PropertyGroup>

  <!-- The build-step integration under test. -->
  <Import Project="../targets/ZeroDDS.Idlc.targets" />

  <ItemGroup>
    <ZeroddsIdl Include="idl/Robot.idl" />
  </ItemGroup>

  <!--
    Generated C# needs two runtime assemblies: ZeroDds.Wire (Writer, Reader,
    Endianness; runtime/csharp) for the codec, and ZeroDDS.Cdr (EndianMode,
    IDdsTopicType<T>) for the TypeSupport class. ZeroDDS.Cdr compiles
    crates/idl-csharp/runtime/Omg.Types.cs into itself; compiling that file a
    second time here would give a second Omg.Types.ExtensibilityKind.
  -->
  <ItemGroup>
    <ProjectReference Include="../../../crates/cs/csharp/ZeroDDS.Cdr/ZeroDDS.Cdr.csproj" />
    <ProjectReference Include="../../../runtime/csharp/ZeroDds.Wire.csproj" />
  </ItemGroup>

</Project>
