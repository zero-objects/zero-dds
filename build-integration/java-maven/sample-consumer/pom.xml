<?xml version="1.0" encoding="UTF-8"?>
<!--
  SPDX-License-Identifier: Apache-2.0
  Copyright 2026 ZeroDDS Contributors

  Sample consumer for zerodds-idlc under exec-maven-plugin. `mvn compile`
  runs zerodds-idlc in the generate-sources phase, then registers its
  output directory as a compile source root (build-helper-maven-plugin).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.zerodds.samples</groupId>
  <artifactId>zerodds-idlc-maven-sample</artifactId>
  <version>1.0.0-rc.7</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <zerodds.idl.dir>${project.basedir}/src/main/idl/Robot.idl</zerodds.idl.dir>
    <zerodds.idl.outputDir>${project.build.directory}/generated-sources/java</zerodds.idl.outputDir>
  </properties>

  <!--
    The generated TypeSupport classes need org.zerodds.cdr.* from the omgdds
    artifact of crates/java-omgdds/java. `mvn install` that module into the
    local repository before building this sample (see README.md).
  -->
  <dependencies>
    <dependency>
      <groupId>org.zerodds</groupId>
      <artifactId>omgdds</artifactId>
      <version>1.0.0-rc.7</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.4.1</version>
        <executions>
          <execution>
            <id>generate-idl</id>
            <phase>generate-sources</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>zerodds-idlc</executable>
              <arguments>
                <argument>generate</argument>
                <argument>--lang</argument>
                <argument>java</argument>
                <argument>--java-mapping</argument>
                <argument>omg</argument>
                <argument>--out</argument>
                <argument>${zerodds.idl.outputDir}</argument>
                <argument>${zerodds.idl.dir}</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        exec-maven-plugin has no source-root-registration primitive of its
        own (unlike a real generate-sources Mojo, which would call
        project.addCompileSourceRoot(...) directly) — build-helper bridges
        that gap.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>add-generated-source</id>
            <phase>generate-sources</phase>
            <goals><goal>add-source</goal></goals>
            <configuration>
              <sources>
                <source>${zerodds.idl.outputDir}</source>
                <!--
                  The wire runtime the generated codec calls (org.zerodds.wire.*,
                  runtime/java). The omgdds dependency above supplies
                  org.zerodds.cdr.* for the TypeSupport classes.
                -->
                <source>${project.basedir}/../../../runtime/java/src/main/java</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
