{
  "minTokens": 50,
  "threshold": 9.75,
  "reporters": ["console", "threshold"],
  "gitignore": true,
  "absolute": false,
  "ignore": [
    "**/.git/**",
    "**/target/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "endpoints/*/build/**",
    "**/_generated/**",
    "**/snapshots/**",
    "**/tests/snapshots/**",
    "**/*.snap",
    "**/goldens/**",
    "**/*.golden",
    "**/Cargo.lock",
    "**/*.lock",
    "**/package-lock.json",
    "github/**",
    "internal/**",
    "docs/**",
    "website/**",
    "man/**",
    "examples/tutorials/**",
    "tests/compliance/**",
    "tests/perf/dds-roundtrip-bench/gen/**",
    "tests/interop-results/**",
    "crates/java-omgdds/java/src/main/java/org/zerodds/typelookup/generated/**",
    "crates/zerodds-c-api/include/zerodds.h",
    "crates/rmw-zerodds-shim/include/rmw_zerodds.h",
    "diagrams/LINK-INVENTORY.md"
  ]
}
