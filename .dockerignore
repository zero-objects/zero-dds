# Cargo + Rust build artifacts never belong in the Docker context,
# because the builder stage produces them itself anyway (see cargo-chef
# in packaging/docker/*/Dockerfile).
target/
**/target/

# Node/TypeScript build artifacts and caches.
node_modules/
**/node_modules/
dist/
**/dist/
.tsbuildinfo
**/*.tsbuildinfo

# Python build artifacts.
__pycache__/
**/__pycache__/
*.pyc
*.pyo
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/

# Flutter / Dart.
.dart_tool/
**/.dart_tool/
build/
**/build/

# Qt build outputs.
**/qt-tileview/build/
**/qt-tileview/gen/

# Wheels and distribution artifacts.
wheels/
**/wheels/
*.whl
*.egg-info/

# Git directory — the Dockerfiles need no repository access.
.git/

# Local planning and release tooling data.
.planning/
.publish-rc1.log
.publish-rc1.order
.publish-rc1.sh
.playwright-mcp/

# IDE / Editor.
.vscode/
.idea/
*.swp
.DS_Store

# Output reports and temporary spec coverage generation.
mutants-out/
diagrams/LINK-INVENTORY.md
diagrams/OLD-CONTENT-AUDIT.md
diagrams/REMAINDER.md

# Not sources of any image: the interop matrix (GBs of recorded runs), the
# internal notes (never part of a published artifact), the public mirror
# and examples checkouts, the website, and scratch directories.
matrix/
internal/
github/
zerodds-examples/
website/
ci-plan/
tmpjc/
xcdr2-le/
