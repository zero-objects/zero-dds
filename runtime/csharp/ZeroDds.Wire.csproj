<!--
  The C# wire runtime: DDS-XTypes 1.3 §7.4 read from the clause, the same as
  `crates/wire`, `runtime/c`, `runtime/cpp`, `runtime/java` and
  `runtime/python` do, and calling none of them.

  `TreatWarningsAsErrors` for the reason the C column compiles with `-Werror`
  and the Java one with `-Xlint:all -Werror`: a warning in a wire runtime is a
  question nobody answered. `AnalysisLevel` at the highest so the set of
  questions is the current one and not the 2019 one.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>ZeroDds.Wire</AssemblyName>
    <PackageId>ZeroDds.Wire</PackageId>
    <Version>1.0.0-rc.7</Version>
    <Authors>ZeroDDS Contributors</Authors>
    <Description>Canonical XCDR runtime used by generated ZeroDDS C# codecs.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RootNamespace>ZeroDds.Wire</RootNamespace>
    <LangVersion>12.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>9999</WarningLevel>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The build is reproducible and offline: a runtime that needed a
         package feed could not be built on a host with no network, which is
         where the interop measurements are taken. -->
    <RestorePackages>false</RestorePackages>
    <EnableDefaultItems>false</EnableDefaultItems>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <Compile Include="src/Endianness.cs" />
    <Compile Include="src/Encoding.cs" />
    <Compile Include="src/Encapsulation.cs" />
    <Compile Include="src/Policies.cs" />
    <Compile Include="src/PlCdr1Framing.cs" />
    <Compile Include="src/WireException.cs" />
    <Compile Include="src/Handles.cs" />
    <Compile Include="src/IdlName.cs" />
    <Compile Include="src/Float128.cs" />
    <Compile Include="src/Md5.cs" />
    <Compile Include="src/Writer.cs" />
    <Compile Include="src/Reader.cs" />
  </ItemGroup>
</Project>
