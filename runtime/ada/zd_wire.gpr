--
--  The Ada wire runtime as a GNAT project. The probe driver compiles
--  the runtime's sources beside the generated probe; this project is
--  for building and testing the runtime on its own:
--
--     gprbuild -P zd_wire.gpr
--
--  Ada 2012. `-gnatwa` is deliberately not used: the generated probes
--  are compiled with the same switches, and the shared codec walk
--  declares locals a dialect may leave unread.

project Zd_Wire is

   for Source_Dirs use ("src", "tests");
   for Object_Dir use "obj";
   for Exec_Dir use "obj";
   for Main use ("zd_wire_selftest.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2012", "-O1", "-g");
   end Compiler;

end Zd_Wire;
