<?xml version="1.0"?>
<!-- The QoS `rti_robot` runs on. Loaded through NDDS_QOS_PROFILES, which
     build.sh's caller sets, so it applies wherever the binary is started from
     rather than only from this directory.

     * transport_builtin UDPv4 — same-host, RTI prefers its shared-memory
       transport, which no foreign stack can read. A cell left on the default
       would see the participant, match the endpoint and count zero samples,
       and the log would say nothing about why.
     * the reader's representation — RTI's DataReader defaults to XCDR1 alone
       and drops an XCDR2 writer without a word. OMG XTypes 1.3 §7.6.2 has a
       default reader accept both; RTI's does not. `rti_robot sub` also sets
       this in code, and it is repeated here so a reader created from the
       default profile by any other path carries it too. -->
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://community.rti.com/schema/current/rti_dds_qos_profiles.xsd">
  <qos_library name="ZeroDDSInterop">
    <qos_profile name="Default" is_default_qos="true">
      <participant_qos>
        <transport_builtin><mask>UDPv4</mask></transport_builtin>
      </participant_qos>
      <datareader_qos>
        <representation>
          <value>
            <element>XCDR_DATA_REPRESENTATION</element>
            <element>XCDR2_DATA_REPRESENTATION</element>
          </value>
        </representation>
      </datareader_qos>
    </qos_profile>
  </qos_library>
</dds>
