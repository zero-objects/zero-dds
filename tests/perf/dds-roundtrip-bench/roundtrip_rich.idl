// SPDX-License-Identifier: Apache-2.0
//
// Cross-vendor roundtrip bench — RICH-TYPED XCDR2 variant.
//
// Complements `roundtrip.idl` (there: 2 scalars + sequence<octet>).
// This type maximizes the **CDR codec work per sample**, to isolate the
// encode/decode share of the DCPS pipeline from the pure
// transport/wire share:
//
//   * `string<64> name`            -- length-prefixed string codec
//   * `double transform[16]`       -- fixed-size PARRAY (XCDR2 §7.4.3.5)
//   * sequence<Waypoint, 32>       -- sequence-of-nested-struct: per
//                                     element two nested Vec3
//                                     + string + scalars → member-by-
//                                     member encode/decode
//   * sequence<octet, 8192>        -- payload sweep as in the base bench
//
// Identical wire bytes across vendors (the whole purpose of the bench):
//   * `@final` throughout -- no extensibility, no DHEADER/EMHEADER,
//     identical wire layout across idlc / fastddsgen / rtiddsgen /
//     opendds_idl / idl-cpp (cf. the @final-default decision).
//   * `@autoid(SEQUENTIAL)` + explicit `@id` -- byte-identical
//     TypeObject member IDs across all stacks (RTI type consistency strict).
//   * All sequences/strings **bounded** -- the same defaults enforced
//     (RTI default 100, FastDDS unbounded → otherwise the wire diverges).

module RoundtripBench {

    @final
    @autoid(SEQUENTIAL)
    struct Vec3 {
        @id(0) double x;
        @id(1) double y;
        @id(2) double z;
    };

    @final
    @autoid(SEQUENTIAL)
    struct Waypoint {
        @id(0) unsigned long  id;
        @id(1) Vec3           position;
        @id(2) Vec3           velocity;
        @id(3) string<32>     label;
        @id(4) double         weight;
    };

    @topic
    @final
    @autoid(SEQUENTIAL)
    struct RoundtripRich {
        @id(0) unsigned long          sequence_id;
        @id(1) unsigned long long     t_send_ns;
        @id(2) string<64>             name;
        @id(3) double                 transform[16];
        // A fixed waypoint count per sample (the app fills N=8) produces
        // a constant codec load; bound 32 leaves headroom.
        @id(4) sequence<Waypoint, 32> waypoints;
        // Keep the payload sweep: 0 … 8192 bytes, so that rich vs. base
        // is comparable at identical payload size.
        @id(5) sequence<octet, 8192>  payload;
    };

};
