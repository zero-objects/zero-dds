# arm-host RTI Connext bench env. Source'd von atomic.sh.
# Aus gestrigem arm-host-rti.sh extrahiert — der Lauf war 45/45 sauber bei
# 41-43 µs CV 0.84%.

export NDDSHOME="$HOME/y/rti_connext_dds-7.7.0"
export RTI_LICENSE_FILE="$NDDSHOME/rti_license.dat"
export DYLD_LIBRARY_PATH="$NDDSHOME/lib/arm64Darwin23clang16.0${DYLD_LIBRARY_PATH:+:$DYLD_LIBRARY_PATH}"
