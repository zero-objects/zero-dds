# x86-host OpenDDS bench env (host: root@x86-host).
# OpenDDS install: /opt/opendds via source build (v3.34.0).
# Non-standard prefix-layout: Templates unter share/dds/dds/idl/.

export DDS_ROOT="/opt/opendds/share/dds"
export ACE_ROOT="/opt/opendds/share/dds"
export TAO_ROOT="/opt/opendds/share/dds"
export LD_LIBRARY_PATH="/opt/opendds/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
