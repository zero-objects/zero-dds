# arm-host OpenDDS bench env (host: user@arm-host).
# OpenDDS install: ~/opt/opendds via source build (v3.34.0).
# Non-standard prefix-layout: Templates unter share/dds/dds/idl/.

export DDS_ROOT="$HOME/opt/opendds/share/dds"
export ACE_ROOT="$HOME/opt/opendds/share/dds"
export TAO_ROOT="$HOME/opt/opendds/share/dds"
export DYLD_LIBRARY_PATH="$HOME/opt/opendds/lib${DYLD_LIBRARY_PATH:+:$DYLD_LIBRARY_PATH}"
