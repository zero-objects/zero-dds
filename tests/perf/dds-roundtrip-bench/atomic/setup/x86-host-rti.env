# x86-host RTI Connext bench env (host: root@x86-host).
# RTI install via apt-Repo (packages.rti.com, bookworm-codename
# fallback weil trixie noch nicht im Repo) → /opt/rti.com/.

export NDDSHOME="/opt/rti.com/rti_connext_dds-7.7.0"
export RTI_LICENSE_FILE="$NDDSHOME/rti_license.dat"
export LD_LIBRARY_PATH="$NDDSHOME/lib/x64Linux4gcc8.5.0${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
