# arm-host ZeroDDS bench env. Source'd von atomic.sh.
# Nur env-vars + ggf. minimaler PATH-extend. KEIN binary-call.
# Bewusst klein: wenn was nicht stimmt soll der bench frueh failen.

# Rust-target/release enthaelt libzerodds.dylib + tests-bench-binary link
export DYLD_LIBRARY_PATH="$HOME/projects/zerodds/target/release${DYLD_LIBRARY_PATH:+:$DYLD_LIBRARY_PATH}"
