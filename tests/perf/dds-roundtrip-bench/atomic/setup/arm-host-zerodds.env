# arm-host ZeroDDS bench env. Sourced by atomic.sh.
# Only env vars + at most a minimal PATH extension. NO binary call.
# Deliberately small: if something is wrong, the bench should fail early.

# Rust target/release contains libzerodds.dylib + the test bench binary link
export DYLD_LIBRARY_PATH="$HOME/projects/zerodds/target/release${DYLD_LIBRARY_PATH:+:$DYLD_LIBRARY_PATH}"
