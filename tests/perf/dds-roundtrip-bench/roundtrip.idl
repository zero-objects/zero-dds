// SPDX-License-Identifier: Apache-2.0
//
// Cross-Vendor Roundtrip-Bench — Shared IDL.
//
// Definition fuer die DDS-Roundtrip-Tests gegen Cyclone DDS, FastDDS
// und ZeroDDS. Alle drei Stacks generieren ihre nativen
// (C / C++ / Java / Python / TypeScript / Rust) Datentypen aus
// dieser einen IDL — der Bench misst damit die *vollstaendige*
// DCPS-API-Pipeline durch alle Schichten:
//
//   App-Code (C++)                  -- typisierte write/take
//   ↓ vendor-Codegen (idlc / fastddsgen / idl-cpp)
//   CDR-Encoder/Decoder             -- XCDR2 LE
//   ↓
//   DCPS-API (DataWriter/DataReader)-- HistoryCache, QoS
//   ↓
//   RTPS-Wire-Protokoll             -- DDSI-RTPS 2.5
//   ↓
//   Transport (UDP/SHM)             -- loopback bei diesem Bench
//
// Der frühere `roundtrip-1us`-Bench ruft `zerodds_writer_write()` mit
// pre-encoded raw bytes auf und ueberspringt damit die CDR-Schicht.
// Cyclone `ddsperf` und FastDDS `LatencyTest` rufen ihre typisierten
// `write()` auf und durchlaufen CDR-Encode pro Sample. Apples-to-apples
// braucht eine eigene App pro Stack die aus diesem File generiert.

module RoundtripBench {

    /// Einzelnes Roundtrip-Sample.
    ///
    /// Layout-Notes:
    /// * `@final` -- keine Extensibility, kompakteste Wire-Form (kein
    ///   DHEADER, kein PID-stream).
    /// * Kein `@key` -- Roundtrip ist ein logischer Single-Instance-Stream.
    ///   Mit `@key sequence_id` erzeugt jedes Sample eine neue DDS-Instance,
    ///   was FastDDS' default `max_instances=10` sofort sprengt. Cyclone
    ///   und RTI nutzen unbegrenzte Instances und liefen davon
    ///   unbeeindruckt; FastDDS rejected nach Sample 10 silent. Single-
    ///   Instance-Stream ist semantisch korrekter fuer Ping-Pong.
    /// * `t_send_ns` -- monotone Clock-ns am Send-Zeitpunkt; der
    ///   Echo-Sender kopiert den Wert unveraendert ins Echo, der
    ///   Empfaenger berechnet `now - t_send_ns`.
    /// * `payload` -- variable-size `sequence<octet>` zum Sweep ueber
    ///   Groessen (0 … 8192 Byte in 10%-Schritten).
    // @topic — markiert den Struct als DDS-Topic-Type. OpenDDS'
    // opendds_idl generiert NUR fuer @topic-annotierte Structs die
    // TypeSupport (DataWriter/DataReader/TypeSupportImpl). Cyclone-
    // idlc, fastddsgen und rtiddsgen behandeln ohnehin jeden Struct
    // als Topic-faehig — die Annotation ist cross-vendor-neutral
    // (XTypes 1.3 §7.3.1.2.1.5).
    // @autoid(SEQUENTIAL) + explizite @id pro Member: erzwingt ueber
    // ALLE Vendor-Codegens (rtiddsgen / idlc / fastddsgen / opendds_idl /
    // idl-cpp) identische Member-IDs im TypeObject. Ohne das leiten die
    // Codegens bei einem @final-Struct zwar dasselbe Wire-Layout ab,
    // aber teils abweichende TypeObject-Member-IDs — RTI Connext erzwingt
    // Type-Consistency strikt und weist einen TypeObject mit fremden
    // Member-IDs/Hash ab (Discovery scheitert, kein Match). Mit pinned
    // @id ist der TypeObject byte-identisch ueber alle Stacks
    // (XTypes 1.3 §7.3.1.2.1.1 „Member ID assignment").
    @topic
    @final
    @autoid(SEQUENTIAL)
    struct Roundtrip {
        @id(0) unsigned long           sequence_id;
        @id(1) unsigned long long      t_send_ns;
        // Bounded sequence — 8192 ist groesser als unsere maximale
        // Sweep-Payload-Groesse. Explizite bound, damit RTI/FastDDS/
        // Cyclone nicht unterschiedliche Defaults nehmen (RTI default
        // 100, FastDDS unbounded). Mit gleicher bound generieren alle
        // dasselbe Wire-Layout.
        @id(2) sequence<octet, 8192>   payload;
    };

};
