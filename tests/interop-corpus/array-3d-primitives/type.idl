// three-dimensional array of each primitive kind
@final struct Sample {
    boolean flag[2][2][2];
    octet raw_octet[2][2][2];
    uint8 unsigned_byte[2][2][2];
    int8 signed_byte[2][2][2];
    char letter[2][2][2];
    wchar wide_letter[2][2][2];
    short short_signed[2][2][2];
    unsigned short short_unsigned[2][2][2];
    long long_signed[2][2][2];
    unsigned long long_unsigned[2][2][2];
    long long llong_signed[2][2][2];
    unsigned long long llong_unsigned[2][2][2];
    float single_float[2][2][2];
    double double_float[2][2][2];
};
