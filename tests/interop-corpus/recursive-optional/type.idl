// a self-recursive type made finite by an absent `@optional`, with no
// `@external` on the member
// XTypes 1.3 §7.3.1.2.1.3 (`@optional`). The twin of
// `recursive-optional-external` without Table 21's annotation: the
// absent member terminates a value either way, and `@external` only
// says where a binding keeps the member. A binding whose member is the
// value needs an indirection here all the same.
module m {
  struct Node;

  @mutable struct Node {
    long value;
    @optional Node next;
  };
};
