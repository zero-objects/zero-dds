// `@try_construct` in each of its four spellings
// XTypes 1.3 §7.3.1.2.1.12: DISCARD, USE_DEFAULT, TRIM — and the bare
// form, which the clause declares `default USE_DEFAULT` and which is
// therefore not the same as leaving the annotation off (DISCARD).
@mutable struct Sample {
    @try_construct(DISCARD) long discarded;
    @try_construct(USE_DEFAULT) string<4> defaulted;
    @try_construct(TRIM) string<4> trimmed;
    @try_construct string<4> bare;
    long tail;
};
