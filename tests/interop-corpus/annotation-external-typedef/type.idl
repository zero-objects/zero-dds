// `@external` on a member whose type is a typedef
// The alias is transparent on the wire (OMG IDL 4.2 §7.4.1.4.4); the
// annotation stays the member's, DDS-XTypes 1.3 Table 21, and the
// indirection is taken through the alias.
@appendable struct Inner {
    long a;
    short b;
};

typedef Inner InnerAlias;

@final struct Sample {
    @external InnerAlias nested;
    long tail;
};
