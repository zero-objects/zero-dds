// `@default_literal` on the middle enumerator
// XTypes 1.3 §7.3.1.2.1.10 with Table 9: the annotation names the
// enumeration's default, which is otherwise its first enumerator.
enum Colour {
    RED,
    @default_literal GREEN,
    BLUE
};

@final struct Sample {
    Colour first;
    Colour second;
    octet tail;
};
