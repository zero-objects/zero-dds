// `@external` on a union branch
// DDS-XTypes 1.3 Table 21: the indirection is the language mapping's and
// changes no octet — the branch's bytes are the plain branch's bytes.
@appendable struct Inner {
    long a;
    short b;
};

@appendable union Pick switch (long) {
    case 1: @external Inner nested;
    default: long other;
};

@final struct Sample {
    Pick choice;
    long tail;
};
