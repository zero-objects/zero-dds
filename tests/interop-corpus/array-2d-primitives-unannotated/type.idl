// two-dimensional array of each primitive kind, unannotated
struct Sample {
    boolean flag[2][3];
    octet raw_octet[2][3];
    uint8 unsigned_byte[2][3];
    int8 signed_byte[2][3];
    char letter[2][3];
    wchar wide_letter[2][3];
    short short_signed[2][3];
    unsigned short short_unsigned[2][3];
    long long_signed[2][3];
    unsigned long long_unsigned[2][3];
    long long llong_signed[2][3];
    unsigned long long llong_unsigned[2][3];
    float single_float[2][3];
    double double_float[2][3];
};
