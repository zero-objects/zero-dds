// two types on one cycle, only one of whose members is `@optional`
// XTypes 1.3 §7.3.1.2.1.3. `B.head` holds an `A` and carries no
// annotation; `A.tail` holds a `B` only optionally, and its absence is
// what ends a value. A binding whose member is the value can hold
// neither member inline, and one of the two is not optional, so its
// Table 9 default is a value that needs storage. `Holder` is appendable
// so that a writer with fewer members leaves `root` out and the reader
// has to build `B`'s default. No member is named like its type: a name
// used in a scope is introduced there (OMG IDL 4.2 §7.2.3.1).
module m {
  struct B;

  @mutable struct A {
    long x;
    @optional B tail;
  };

  @mutable struct B {
    long y;
    A head;
  };

  @appendable struct Holder {
    long z;
    B root;
  };
};
