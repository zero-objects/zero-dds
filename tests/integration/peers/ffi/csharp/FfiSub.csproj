<Project Sdk="Microsoft.NET.Sdk">
  <!-- The C# subscriber of tests/integration/tests/bindings_ffi.rs, built by
       tests/integration/ffi_peers.sh against the binding crates/cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>FfiSub</AssemblyName>
    <RootNamespace>ZeroDdsFfiSub</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../../crates/cs/csharp/ZeroDDS/ZeroDDS.csproj" />
  </ItemGroup>
</Project>
